@IsTest private class ReviewMixedProbeTest { @IsTest static void run() { List<Object> rows=ReviewMixedProbe.run(); System.assertEquals(6,rows.size()); List<String> expected=new List<String>{'INVALID_FIELD_FOR_INSERT_UPDATE','SUCCESS','INVALID_FIELD_FOR_INSERT_UPDATE','INVALID_FIELD_FOR_INSERT_UPDATE','INVALID_FIELD_FOR_INSERT_UPDATE','SUCCESS'}; List<Integer> count=new List<Integer>{1,1,1,0,0,1}; for(Integer i=0;i<6;i++){ Map<String,Object> row=(Map<String,Object>)rows[i];System.assertEquals(expected[i],row.get('status'));List<Boolean> before=(List<Boolean>)row.get('before');System.assertEquals(count[i],before.size());if(!before.isEmpty())System.assertEquals(i==5,before[0]);} } }
