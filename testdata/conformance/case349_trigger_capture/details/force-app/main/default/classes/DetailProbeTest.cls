for(Integer i=0;i<want.size();i++) {Map<String,Object> a=(Map<String,Object>)got[i], e=(Map<String,Object>)want[i];System.assertEquals(e.get('case'),a.get('case'));System.assertEquals(e.get('success'),a.get('success'));System.assertEquals(e.get('created'),a.get('created'));List<Object> ae=(List<Object>)a.get('errors'), ee=(List<Object>)e.get('errors'); System.assertEquals(ee.size(),ae.size()); for(Integer j=0;j<ee.size();j++) {Map<String,Object> am=(Map<String,Object>)ae[j], em=(Map<String,Object>)ee[j]; for(String k:em.keySet()) System.assertEquals(JSON.serialize(em.get(k)),JSON.serialize(am.get(k)));}}
