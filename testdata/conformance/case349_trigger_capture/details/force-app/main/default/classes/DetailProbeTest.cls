List<Object> got=DetailProbe.run(); List<Object> want=(List<Object>)JSON.deserializeUntyped('[{"case":"business","created":true,"errors":[{"fields":["FirstName"],"message":"Account: bad field names on insert/update call: FirstName","status":"INVALID_FIELD_FOR_INSERT_UPDATE"}],"success":false},{"case":"person","created":true,"errors":[{"fields":["Name"],"message":"Unable to create/update fields: Name. Please check the security settings of this field and verify that it is read/write for your profile or permission set.","status":"INVALID_FIELD_FOR_INSERT_UPDATE"}],"success":false},{"case":"invalid","created":true,"errors":[{"fields":["RecordTypeId"],"message":"Record Type ID: this ID value isn\'t valid for the user: SELECTED_ID","status":"INVALID_CROSS_REFERENCE_KEY"}],"success":false}]');
