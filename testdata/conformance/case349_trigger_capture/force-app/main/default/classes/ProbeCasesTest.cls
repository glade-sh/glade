  List<Object> expected=(List<Object>)JSON.deserializeUntyped('[{"beforeCount":1,"case":"update-none","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"update-same-name","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"update-same-type","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"update-changed-name","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":0,"case":"update-input-name","sameType":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","storedName":"Synthetic","storedPhone":null,"success":false},{"beforeCount":1,"case":"update-input-type","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"upsert-none","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"upsert-same-name","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"upsert-same-type","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":1,"case":"upsert-changed-name","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":0,"case":"upsert-input-name","sameType":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","storedName":"Synthetic","storedPhone":null,"success":false},{"beforeCount":1,"case":"upsert-input-type","sameType":true,"status":"SUCCESS","storedName":"Synthetic","storedPhone":"4155550123","success":true},{"beforeCount":0,"case":"business-single-phone","status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"business-both-phone","status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"business-both-no-phone","status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"business-single-no-phone","status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"external-plain","created":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"external-extra","created":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"external-null","created":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false},{"beforeCount":0,"case":"external-multiple","created":true,"status":"INVALID_FIELD_FOR_INSERT_UPDATE","success":false}]');
  System.assertEquals(expected.size(),observed.size());
  for(Integer i=0;i<expected.size();i++) {
   Map<String,Object> e=(Map<String,Object>)expected[i]; Map<String,Object> a=(Map<String,Object>)observed[i];
   for(String k:e.keySet()) System.assertEquals(e.get(k),a.get(k),String.valueOf(e.get('case'))+':'+k);
  }
 }
}
