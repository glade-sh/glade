@IsTest private class ReviewRouteProbeTest { @IsTest static void run() { List<Object> rows=ReviewRouteProbe.run(); System.assertEquals(8,rows.size()); List<String> expected=new List<String>{'INVALID_FIELD_FOR_INSERT_UPDATE','INVALID_EMAIL_ADDRESS','INVALID_FIELD_FOR_INSERT_UPDATE','SUCCESS'}; for(Integer i=0;i<8;i++) { Map<String,Object> row=(Map<String,Object>)rows[i]; System.assertEquals(expected[Math.mod(i,4)],row.get('status')); List<Boolean> before=(List<Boolean>)row.get('before'); System.assertEquals(Math.mod(i,4)<2 ? 0 : 1,before.size()); if(!before.isEmpty()) System.assertEquals(false,before[0]); } } }
