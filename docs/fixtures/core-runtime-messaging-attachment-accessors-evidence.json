      "content": "@isTest private class CoreRuntimeMessagingAttachmentAccessorsEvidenceTest { @isTest static void rows() { Messaging.EmailAttachment attachment = new Messaging.EmailAttachment(); attachment.setBody(Blob.valueOf('trail')); attachment.setContentId('cid-trail'); attachment.setContentType('text/plain'); attachment.setFileName('trail.txt'); System.assertEquals('trail', attachment.getBody().toString()); System.assertEquals('cid-trail', attachment.getContentId()); System.assertEquals('text/plain', attachment.getContentType()); System.assertEquals('trail.txt', attachment.getFileName()); Messaging.EmailFileAttachment fileAttachment = new Messaging.EmailFileAttachment(); fileAttachment.setBody(Blob.valueOf('file')); fileAttachment.setContentType('application/octet-stream'); fileAttachment.setFileName('file.bin'); fileAttachment.setInline(true); System.assertEquals('file', fileAttachment.getBody().toString()); System.assertEquals('application/octet-stream', fileAttachment.getContentType()); System.assertEquals('file.bin', fileAttachment.getFileName()); System.assertEquals(null, fileAttachment.getId()); System.assertEquals(true, fileAttachment.getInline()); } }"
