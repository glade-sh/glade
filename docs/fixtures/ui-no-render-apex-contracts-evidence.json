  "source": [
    {
      "path": "force-app/main/default/classes/UINoRenderApexContractsEvidenceTest.cls",
      "content": "@isTest private class UINoRenderApexContractsEvidenceTest { @isTest static void visualEditorRows() { VisualEditor.DataRow selected = new VisualEditor.DataRow('A', 42, true); VisualEditor.DataRow other = new VisualEditor.DataRow('B', 'value'); System.assertEquals('A', selected.getLabel()); System.assertEquals(42, (Integer) selected.getValue()); System.assertEquals(true, selected.isSelected()); System.assert(selected.compareTo(other) < 0); VisualEditor.DynamicPickListRows rows = new VisualEditor.DynamicPickListRows(); rows.addRow(selected); System.assertEquals(1, rows.size()); System.assertEquals('A', rows.get(0).getLabel()); System.assertEquals(false, rows.containsAllRows()); rows.setContainsAllRows(true); System.assertEquals(true, rows.containsAllRows()); List<VisualEditor.DataRow> dataRows = rows.getDataRows(); VisualEditor.DynamicPickListRows copy = new VisualEditor.DynamicPickListRows(dataRows, true); copy.addAllRows(dataRows); copy.sort(); System.assertEquals(2, copy.size()); System.assertEquals(true, copy.containsAllRows()); } @isTest static void apexPagesComponents() { ApexPages.Component component = new ApexPages.Component(); System.assertNotEquals(null, component.childComponents); System.assertNotEquals(null, component.componentIterations); System.assertNotEquals(null, component.expressions); System.assertNotEquals(null, component.facets); System.assertEquals(null, component.id); System.assertEquals(null, component.parent); System.assertEquals(true, (Boolean) component.rendered); component.id = 'local'; component.parent = component; System.assertEquals('local', (String) component.id); System.assertNotEquals(null, component.parent); ApexPages.ComponentIteration iteration = new ApexPages.ComponentIteration(); System.assertNotEquals(null, iteration.childComponents); System.assertEquals(null, iteration.iterationValue); iteration.parent = component; System.assertNotEquals(null, iteration.parent); } @isTest static void componentApexPageHandle() { Component.apex.page page = Test.invokePage(new PageReference('/apex/NoRender')); System.assertNotEquals(null, page); } }"
    }
  ],
