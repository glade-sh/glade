      "path": "force-app/main/default/objects/Account/validationRules/USZip.validationRule-meta.xml",
      "content": "<ValidationRule><fullName>USZip</fullName><active>true</active><errorConditionFormula>AND(ISBLANK(BillingPostalCode) = FALSE, OR(BillingCountry = &quot;US&quot;, BillingCountry = &quot;USA&quot;), NOT(REGEX(BillingPostalCode, &quot;\\d{5}(-\\d{4})?&quot;)))</errorConditionFormula><errorMessage>invalid postal code</errorMessage><errorDisplayField>BillingPostalCode</errorDisplayField></ValidationRule>"
