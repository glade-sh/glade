    {
      "path": "force-app/main/classes/DataValidationFormulaFunctionsTest.cls",
      "content": "@isTest private class DataValidationFormulaFunctionsTest { @isTest static void observedFormulaFunctionsDriveValidationRules() { Database.SaveResult allowed = Database.insert(new Account(Name = 'Allowed', BillingCountry = 'US', BillingState = 'CA', BillingPostalCode = '94105'), false); System.assert(allowed.isSuccess()); Database.SaveResult badState = Database.insert(new Account(Name = 'Bad State', BillingCountry = 'US', BillingState = 'ZZ'), false); System.assert(!badState.isSuccess()); System.assertEquals('invalid state', badState.getErrors().get(0).getMessage()); System.assertEquals('BillingState', badState.getErrors().get(0).getFields().get(0)); Database.SaveResult badZip = Database.insert(new Account(Name = 'Bad Zip', BillingCountry = 'USA', BillingPostalCode = 'ABCDE'), false); System.assert(!badZip.isSuccess()); System.assertEquals('invalid postal code', badZip.getErrors().get(0).getMessage()); Database.SaveResult bothBindings = Database.insert(new Account(Name = 'Both', BindingObject__c = 'Account', BindingObjectAlternate__c = 'Contact'), false); System.assert(!bothBindings.isSuccess()); System.assertEquals('choose one binding object', bothBindings.getErrors().get(0).getMessage()); } }"
    }
