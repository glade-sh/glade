      "path": "force-app/main/default/objects/Account/validationRules/ValidUSState.validationRule-meta.xml",
      "content": "<ValidationRule><fullName>ValidUSState</fullName><active>true</active><errorConditionFormula>AND(ISBLANK(BillingState) = FALSE, OR(BillingCountry = &quot;US&quot;, BillingCountry = &quot;USA&quot;, ISBLANK(BillingCountry)), NOT(CONTAINS(&quot;CA:NY:WA&quot;, BillingState)))</errorConditionFormula><errorMessage>invalid state</errorMessage><errorDisplayField>BillingState</errorDisplayField></ValidationRule>"
    },
