      "path": "force-app/main/classes/CoreRuntimeMessagingSingleEmailAccessorsBroadEvidenceTest.cls",
      "content": "@isTest private class CoreRuntimeMessagingSingleEmailAccessorsBroadEvidenceTest { @isTest static void rows() { Messaging.SingleEmailMessage msg = new Messaging.SingleEmailMessage(); msg.setToAddresses(new List<String>{'to@example.test'}); msg.setCcAddresses(new List<String>{'cc@example.test'}); msg.setBccAddresses(new List<String>{'bcc@example.test'}); msg.setSubject('Subject'); msg.setPlainTextBody('Plain'); msg.setHtmlBody('<p>Plain</p>'); msg.setReplyTo('reply@example.test'); msg.setSenderDisplayName('Sender'); msg.setCharset('UTF-8'); msg.setInReplyTo('<child@example.test>'); msg.setReferences('<root@example.test>'); msg.setOrgWideEmailAddressId('0D2000000000001'); msg.setTargetObjectId('003000000000001'); msg.setTemplateId('00X000000000001'); msg.setWhatId('001000000000001'); msg.setEntityAttachments(new List<String>{'015000000000001'}); msg.setOptOutPolicy('FILTER'); msg.setEmailPriority('High'); msg.setUnsubscribeComment('No thanks'); msg.setUnsubscribeUrls(new List<String>{'https://example.test/unsub'}); msg.setSaveAsActivity(false); msg.setTreatBodiesAsTemplate(true); msg.setTreatTargetObjectAsRecipient(false); msg.setUseSignature(true); msg.setBccSender(true); msg.setOneClickPost(true); System.assertEquals('to@example.test', msg.getToAddresses()[0]); System.assertEquals('cc@example.test', msg.getCcAddresses()[0]); System.assertEquals('bcc@example.test', msg.getBccAddresses()[0]); System.assertEquals('Subject', msg.getSubject()); System.assertEquals('Plain', msg.getPlainTextBody()); System.assertEquals('<p>Plain</p>', msg.getHtmlBody()); System.assertEquals('reply@example.test', msg.getReplyTo()); System.assertEquals('Sender', msg.getSenderDisplayName()); System.assertEquals('UTF-8', msg.getCharset()); System.assertEquals('<child@example.test>', msg.getInReplyTo()); System.assertEquals('<root@example.test>', msg.getReferences()); System.assertEquals('0D2000000000001', msg.getOrgWideEmailAddressId()); System.assertEquals('003000000000001', msg.getTargetObjectId()); System.assertEquals('00X000000000001', msg.getTemplateId()); System.assertEquals(null, msg.getTemplateName()); System.assertEquals('001000000000001', msg.getWhatId()); System.assertEquals('015000000000001', msg.getEntityAttachments()[0]); System.assertEquals('FILTER', msg.getOptOutPolicy()); System.assertEquals('High', msg.getEmailPriority()); System.assertEquals('No thanks', msg.getUnsubscribeComment()); System.assertEquals('https://example.test/unsub', msg.getUnsubscribeUrls()[0]); System.assertEquals(false, msg.getSaveAsActivity()); System.assertEquals(true, msg.isTreatBodiesAsTemplate()); System.assertEquals(false, msg.isTreatTargetObjectAsRecipient()); System.assertEquals(true, msg.getUseSignature()); System.assertEquals(true, msg.getBccSender()); System.assertEquals(true, msg.getOneClickPost()); System.assertEquals(false, msg.isUserMail()); } }"
