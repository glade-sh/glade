{
  "name": "core-type-newinstance-unsupported-package",
  "evidence": [
    {
      "symbol": "Type.newInstance",
      "kind": "exec",
      "notes": "Namespace/package Type tokens return an explicit unsupported diagnostic when no registered local class backs them."
    }
  ],
  "source": [
    {
      "path": "anonymous.apex",
      "content": "Type packaged = Type.forName('pkg', 'Thing');\npackaged.newInstance();"
    }
  ],
  "command": {
    "kind": "exec",
    "args": [
      "Type packaged = Type.forName('pkg', 'Thing');\npackaged.newInstance();"
    ]
  },
  "expected": {
    "error": {
      "type": "NullPointerException",
      "message": "Attempt to de-reference a null object"
    }
  }
}
