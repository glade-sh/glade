      "path": "force-app/main/default/classes/SchemaDescribeChildRelationshipsFixtureTest.cls",
      "content": "@isTest private class SchemaDescribeChildRelationshipsFixtureTest { @isTest static void describesRelationshipEdges() { Schema.DescribeFieldResult who = Task__c.Who__c.getDescribe(); System.assert(who.isNamePointing()); List<Object> refs = who.getReferenceTo(); System.assertEquals(2, refs.size()); System.assertEquals('Account', refs.get(0).getDescribe().getName()); System.assertEquals('Contact', refs.get(1).getDescribe().getName()); Object accountRelationship = null; for (Object relationship : Account.SObjectType.getDescribe().getChildRelationships()) { if (relationship.getRelationshipName() == 'WhoTasks__r') { accountRelationship = relationship; } } System.assert(accountRelationship != null); System.assertEquals('WhoTasks__r', accountRelationship.getRelationshipName()); System.assertEquals('Who__c', accountRelationship.getField().getDescribe().getName()); System.assertEquals('Task__c', accountRelationship.getChildSObject().getDescribe().getName()); System.assert(!accountRelationship.isCascadeDelete()); System.assert(accountRelationship.isRestrictedDelete()); System.assert(!accountRelationship.isDeprecatedAndHidden()); System.assertEquals(0, accountRelationship.getJunctionIdListNames().size()); System.assertEquals(0, accountRelationship.getJunctionReferenceTo().size()); } }"
