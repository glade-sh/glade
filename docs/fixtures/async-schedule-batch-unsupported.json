{
  "name": "async-schedule-batch-unsupported",
  "evidence": [
    {
      "symbol": "Database.scheduleBatch",
      "kind": "exec",
      "notes": "scheduleBatch is pinned to a typed unsupported diagnostic instead of pretending to schedule deferred batch work."
    }
  ],
  "source": [
    {
      "path": "anonymous.apex",
      "content": "Database.scheduleBatch(null, 'nightly', 1, 200);"
    }
  ],
  "command": {
    "kind": "exec",
    "args": [
      "Database.scheduleBatch(null, 'nightly', 1, 200);"
    ]
  },
  "expected": {
    "error": {
      "type": "Error",
      "message": "System.scheduleBatch expects Batchable object"
    }
  }
}
