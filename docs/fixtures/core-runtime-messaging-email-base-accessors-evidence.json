      "content": "@isTest private class CoreRuntimeMessagingEmailBaseAccessorsEvidenceTest { @isTest static void rows() { Messaging.Email email = new Messaging.SingleEmailMessage(); email.setBccSender(true); email.setEmailPriority('High'); email.setReplyTo('reply@example.test'); email.setSaveAsActivity(false); email.setSenderDisplayName('Trail Sender'); email.setSubject('Trail Subject'); email.setUseSignature(false); System.assertEquals(true, email.getBccSender()); System.assertEquals('High', email.getEmailPriority()); System.assertEquals('reply@example.test', email.getReplyTo()); System.assertEquals(false, email.getSaveAsActivity()); System.assertEquals('Trail Sender', email.getSenderDisplayName()); System.assertEquals('Trail Subject', email.getSubject()); System.assertEquals(false, email.getUseSignature()); } }"
