      "path": "sfdx-project.json",
      "content": "{\"packageDirectories\":[{\"path\":\"force-app\",\"default\":true}],\"namespace\":\"\",\"sourceApiVersion\":\"64.0\"}"
    },
    {
      "path": "force-app/main/default/objects/Widget__c/Widget__c.object-meta.xml",
      "content": "<CustomObject xmlns=\"http://soap.sforce.com/2006/04/metadata\"><label>Widget</label><pluralLabel>Widgets</pluralLabel><nameField><label>Widget Name</label><type>Text</type></nameField><deploymentStatus>Deployed</deploymentStatus><sharingModel>ReadWrite</sharingModel></CustomObject>"
    },
    {
      "path": "force-app/main/default/tabs/Widget__c.tab-meta.xml",
      "content": "<CustomTab xmlns=\"http://soap.sforce.com/2006/04/metadata\"><customObject>true</customObject><label>Widgets</label><motif>Custom42: Treasure chest</motif></CustomTab>"
    },
    {
      "path": "force-app/main/default/classes/SchemaDescribeTabsFixtureTest.cls",
      "content": "@isTest private class SchemaDescribeTabsFixtureTest { @isTest static void describesCustomObjectTabs() { List<Object> tabSets = Schema.describeTabs(); System.assertEquals(1, tabSets.size()); System.assert(Schema.getAppDescribe('Sales').containsKey('Widget__c')); System.assert(Schema.getModuleDescribe().containsKey('Widget__c')); System.assert(Schema.getModuleDescribe('Sales').containsKey('Widget__c')); Object tabSet = tabSets.get(0); System.assert(tabSet.equals(tabSet)); System.assert(!tabSet.equals(null)); System.assert(tabSet.hashCode() != 0); System.assert(tabSet.toString().contains('AllTabs')); System.assertEquals('AllTabs', tabSet.getName()); System.assertEquals('All Tabs', tabSet.getLabel()); System.assertEquals('All Tabs', tabSet.getDescription()); System.assertEquals(null, tabSet.getLogoUrl()); System.assertEquals(null, tabSet.getNamespace()); System.assertEquals('AllTabs', tabSet.getTabSetId()); System.assert(!tabSet.isSelected()); System.assertEquals(tabSet.getDescription(), tabSet.description); System.assertEquals(tabSet.getLabel(), tabSet.label); System.assertEquals(tabSet.getLogoUrl(), tabSet.logoUrl); System.assertEquals(tabSet.getName(), tabSet.name); System.assertEquals(tabSet.getNamespace(), tabSet.namespace); System.assertEquals(tabSet.isSelected(), tabSet.selected); System.assertEquals(tabSet.getTabSetId(), tabSet.tabSetId); List<Object> tabs = tabSet.getTabs(); System.assert(tabs.size() >= 1); Object tab = null; for (Object candidate : tabs) { if (candidate.getName() == 'Widget__c') { tab = candidate; } } System.assertNotEquals(null, tab); System.assert(tab.equals(tab)); System.assert(!tab.equals(null)); System.assert(tab.hashCode() != 0); System.assert(tab.toString().contains('Widget__c')); System.assertEquals('Widget__c', tab.getName()); System.assertEquals('Widgets', tab.getLabel()); System.assertEquals('Widget__c', tab.getSObjectName()); System.assert(tab.isCustom()); System.assert(tab.getIconUrl().contains('Custom42')); System.assert(tab.getMiniIconUrl().contains('widget')); System.assert(tab.getMobileUrl().contains('/lightning/o/Widget__c/list')); System.assertEquals('Widget__c', tab.getTabEnumOrId()); System.assert(tab.getUrl().contains('/lightning/o/Widget__c/list')); System.assertEquals(tab.getColors().size(), tab.colors.size()); System.assertEquals(tab.isCustom(), tab.custom); System.assertEquals(tab.getIcons().size(), tab.icons.size()); System.assertEquals(tab.getIconUrl(), tab.iconUrl); System.assertEquals(tab.getLabel(), tab.label); System.assertEquals(tab.getMiniIconUrl(), tab.miniIconUrl); System.assertEquals(tab.getMobileUrl(), tab.mobileUrl); System.assertEquals(tab.getName(), tab.name); System.assertEquals(tab.getSObjectName(), tab.sObjectName); System.assertEquals(tab.getTabEnumOrId(), tab.tabEnumOrId); System.assertEquals(tab.getUrl(), tab.url); List<Object> colors = tab.getColors(); System.assertEquals(1, colors.size()); Object color = colors.get(0); System.assert(color.equals(color)); System.assert(!color.equals(null)); System.assert(color.hashCode() != 0); System.assert(color.toString().contains('Custom42')); System.assertEquals('#747474', color.getColor()); System.assertEquals('primary', color.getContext()); System.assertEquals('Custom42: Treasure chest', color.getTheme()); System.assertEquals(color.getColor(), color.color); System.assertEquals(color.getContext(), color.context); System.assertEquals(color.getTheme(), color.theme); List<Object> icons = tab.getIcons(); System.assertEquals(1, icons.size()); Object icon = icons.get(0); System.assert(icon.equals(icon)); System.assert(!icon.equals(null)); System.assert(icon.hashCode() != 0); System.assert(icon.toString().contains('Custom42')); System.assertEquals('image/svg+xml', icon.getContentType()); System.assertEquals('Custom42: Treasure chest', icon.getTheme()); System.assert(icon.getUrl().contains('widget')); System.assertEquals(0, icon.getHeight()); System.assertEquals(0, icon.getWidth()); System.assertEquals(icon.getContentType(), icon.contentType); System.assertEquals(icon.getHeight(), icon.height); System.assertEquals(icon.getTheme(), icon.theme); System.assertEquals(icon.getUrl(), icon.url); System.assertEquals(icon.getWidth(), icon.width); } }"
    }
