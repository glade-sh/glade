      "content": "@isTest private class CoreRuntimeMessagingMassEmailAccessorsEvidenceTest { @isTest static void rows() { Messaging.MassEmailMessage mass = new Messaging.MassEmailMessage(); mass.setBccSender(true); mass.setDescription('Trail description'); mass.setEmailPriority('Low'); mass.setReplyTo('mass-reply@example.test'); mass.setSaveAsActivity(false); mass.setSenderDisplayName('Mass Sender'); mass.setSubject('Mass Subject'); mass.setTargetObjectIds(new List<Id>{(Id)'003000000000001AAA'}); mass.setTemplateId((Id)'00X000000000001AAA'); mass.setUseSignature(false); mass.setWhatIds(new List<Id>{(Id)'001000000000001AAA'}); System.assertEquals(true, mass.getBccSender()); System.assertEquals('Trail description', mass.getDescription()); System.assertEquals('Low', mass.getEmailPriority()); System.assertEquals('mass-reply@example.test', mass.getReplyTo()); System.assertEquals(false, mass.getSaveAsActivity()); System.assertEquals('Mass Sender', mass.getSenderDisplayName()); System.assertEquals('Mass Subject', mass.getSubject()); System.assertEquals((Id)'003000000000001AAA', mass.getTargetObjectIds()[0]); System.assertEquals((Id)'00X000000000001AAA', mass.getTemplateId()); System.assertEquals(false, mass.getUseSignature()); System.assertEquals((Id)'001000000000001AAA', mass.getWhatIds()[0]); } }"
