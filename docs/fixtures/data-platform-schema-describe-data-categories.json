  "command": {
    "kind": "exec",
    "args": [
      "List<Object> groups = Schema.describeDataCategoryGroups(new List<String>{'Knowledge__kav'}); System.assertEquals(1, groups.size()); Object group = groups[0]; System.assertEquals('Products', group.getName()); System.assertEquals(group.getName(), group.name); System.assertEquals('Products', group.getLabel()); System.assertEquals(group.getLabel(), group.label); System.assertEquals('Product categories', group.getDescription()); System.assertEquals(group.getDescription(), group.description); System.assertEquals('Knowledge__kav', group.getSobject()); System.assertEquals(group.getSobject(), group.sobject); System.assertEquals(2, group.getCategoryCount()); System.assertEquals(group.getCategoryCount(), group.categorycount); System.assert(group.equals(group)); System.assert(!group.equals(null)); System.assert(group.hashCode() != 0); System.assert(group.toString().contains('Products')); Schema.DataCategoryGroupSobjectTypePair pair = new Schema.DataCategoryGroupSobjectTypePair(); pair.setSobject('Knowledge__kav'); pair.setDataCategoryGroupName('Products'); System.assert(pair.equals(pair)); System.assert(!pair.equals(null)); System.assert(pair.hashCode() != 0); System.assert(pair.toString().contains('Products')); System.assertEquals('Knowledge__kav', pair.getSobject()); System.assertEquals(pair.getSobject(), pair.sobject); System.assertEquals('Products', pair.getDataCategoryGroupName()); System.assertEquals(pair.getDataCategoryGroupName(), pair.datacategorygroupname); List<Object> structures = Schema.describeDataCategoryGroupStructures(new List<Schema.DataCategoryGroupSobjectTypePair>{pair}, false); System.assertEquals(1, structures.size()); Object structure = structures[0]; System.assertEquals('Products', structure.getName()); System.assertEquals(structure.getName(), structure.name); System.assertEquals('Products', structure.getLabel()); System.assertEquals(structure.getLabel(), structure.label); System.assertEquals('Product categories', structure.getDescription()); System.assertEquals(structure.getDescription(), structure.description); System.assertEquals('Knowledge__kav', structure.getSobject()); System.assertEquals(structure.getSobject(), structure.sobject); System.assert(structure.equals(structure)); System.assert(!structure.equals(null)); System.assert(structure.hashCode() != 0); System.assert(structure.toString().contains('Products')); List<Object> topCategories = structure.getTopCategories(); System.assertEquals(1, topCategories.size()); System.assertEquals(topCategories.size(), structure.topcategories.size()); Object hardware = topCategories[0]; System.assertEquals('Hardware', hardware.getName()); System.assertEquals(hardware.getName(), hardware.name); System.assertEquals('Hardware', hardware.getLabel()); System.assertEquals(hardware.getLabel(), hardware.label); System.assert(hardware.equals(hardware)); System.assert(!hardware.equals(null)); System.assert(hardware.hashCode() != 0); System.assert(hardware.toString().contains('Hardware')); System.assertEquals(1, hardware.getChildCategories().size()); System.assertEquals(hardware.getChildCategories().size(), hardware.childcategories.size()); List<Object> topOnly = Schema.describeDataCategoryGroupStructures(new List<Schema.DataCategoryGroupSobjectTypePair>{pair}, true)[0].getTopCategories(); System.assertEquals(0, topOnly[0].getChildCategories().size()); System.assertEquals(0, Schema.describeDataCategoryGroups(new List<String>{'Missing__kav'}).size());"
    ]
