      "path": "force-app/main/classes/AddErrorPrimitiveFixtureTest.cls",
      "content": "@isTest private class AddErrorPrimitiveFixtureTest { @isTest static void primitiveFieldAddErrorOverloads() { Database.SaveResult result = Database.insert(new Account(Name='Block', Flag__c=true, Date__c=Date.today(), Stamp__c=Datetime.now(), Amount__c=12.5, Double__c=12.5, Parent__c='001000000000001AAA', Count__c=7, Long__c=7000000000, Text__c='field text', Clock__c=Time.newInstance(8, 30, 0, 0)), false); System.assert(!result.isSuccess()); System.assertEquals(40, result.getErrors().size()); } }"
