      "path": "force-app/main/triggers/AddErrorPrimitiveTrigger.trigger",
      "content": "trigger AddErrorPrimitiveTrigger on Account (before insert) { for (Account a : Trigger.new) { if (a.Name == 'Block') { a.Flag__c.addError('boolean field'); a.Flag__c.addError('boolean field escape', false); a.Flag__c.addError(new DmlException('boolean exception')); a.Flag__c.addError(new DmlException('boolean exception escape'), false); a.Date__c.addError('date field'); a.Date__c.addError('date field escape', false); a.Date__c.addError(new DmlException('date exception')); a.Date__c.addError(new DmlException('date exception escape'), false); a.Stamp__c.addError('datetime field'); a.Stamp__c.addError('datetime field escape', false); a.Stamp__c.addError(new DmlException('datetime exception')); a.Stamp__c.addError(new DmlException('datetime exception escape'), false); a.Amount__c.addError('decimal field'); a.Amount__c.addError('decimal field escape', false); a.Amount__c.addError(new DmlException('decimal exception')); a.Amount__c.addError(new DmlException('decimal exception escape'), false); a.Double__c.addError('double field'); a.Double__c.addError('double field escape', false); a.Double__c.addError(new DmlException('double exception')); a.Double__c.addError(new DmlException('double exception escape'), false); a.Parent__c.addError('id field'); a.Parent__c.addError('id field escape', false); a.Parent__c.addError(new DmlException('id exception')); a.Parent__c.addError(new DmlException('id exception escape'), false); a.Count__c.addError('integer field'); a.Count__c.addError('integer field escape', false); a.Count__c.addError(new DmlException('integer exception')); a.Count__c.addError(new DmlException('integer exception escape'), false); a.Long__c.addError('long field'); a.Long__c.addError('long field escape', false); a.Long__c.addError(new DmlException('long exception')); a.Long__c.addError(new DmlException('long exception escape'), false); a.Text__c.addError('string field'); a.Text__c.addError('string field escape', false); a.Text__c.addError(new DmlException('string exception')); a.Text__c.addError(new DmlException('string exception escape'), false); a.Clock__c.addError('time field'); a.Clock__c.addError('time field escape', false); a.Clock__c.addError(new DmlException('time exception')); a.Clock__c.addError(new DmlException('time exception escape'), false); } } }"
