      "path": "force-app/main/default/classes/SchemaDescribeEdgesFixtureTest.cls",
      "content": "@isTest private class SchemaDescribeEdgesFixtureTest { @isTest static void describesLocalMetadataEdges() { Object accountDescribe = Account.SObjectType.getDescribe(); System.assertEquals('Account', accountDescribe.getLabel()); System.assertEquals('Accounts', accountDescribe.getLabelPlural()); System.assertEquals('001', accountDescribe.getKeyPrefix()); Map<String,Object> fields = accountDescribe.getFields().getMap(); System.assert(fields.containsKey('Name')); Object nameDescribe = Account.Name.getDescribe(); System.assertEquals('Account Name', nameDescribe.getLabel()); System.assertEquals('STRING', nameDescribe.getType()); System.assert(nameDescribe.isNillable()); Object contactField = Contact.AccountId.getDescribe(); System.assertEquals('Account', contactField.getRelationshipName()); List<Object> refs = contactField.getReferenceTo(); System.assertEquals(1, refs.size()); System.assertEquals('Account', refs.get(0).getDescribe().getName()); List<Object> values = Account.Rating.getDescribe().getPicklistValues(); System.assertEquals('Hot Label', values.get(0).getLabel()); System.assert(values.get(0).isDefaultValue()); System.assert(!values.get(1).isActive()); Object rt = accountDescribe.getRecordTypeInfosByDeveloperName().get('Business'); System.assertEquals('Business Account', rt.getName()); List<Object> childRelationships = accountDescribe.getChildRelationships(); Object contacts = null; for (Object relationship : childRelationships) { if (relationship.getRelationshipName() == 'Contacts') { contacts = relationship; } } System.assert(contacts != null); System.assertEquals('Contacts', contacts.getRelationshipName()); System.assert(contacts.isCascadeDelete()); } }"
    }
