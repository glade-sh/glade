{
  "name": "vscode-glade",
  "displayName": "Glade Local Apex",
  "description": "Run, test, debug, and inspect local Apex projects with Glade.",
  "version": "0.0.1",
  "publisher": "glade",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/sfdx-project.json",
    "onLanguage:apex",
    "onLanguage:apexlog",
    "onLanguage:soql",
    "onView:glade.project",
    "onView:glade.recommendedRuns",
    "onView:glade.environments",
    "onView:glade.localOrg",
    "onView:glade.workbench",
    "onView:glade.debugLogs",
    "onView:glade.plugins",
    "onDebugResolve:glade",
    "onCommand:glade.openHome",
    "onCommand:glade.openTui",
    "onCommand:glade.openTestsTui",
    "onCommand:glade.openDataTui",
    "onCommand:glade.openPluginsTui",
    "onCommand:glade.runChangedTests",
    "onCommand:glade.runFailedTests",
    "onCommand:glade.runLocalTestFromCodeLens",
    "onCommand:glade.debugLocalTestFromCodeLens",
    "onCommand:glade.executeAnonymous",
    "onCommand:glade.debugAnonymous",
    "onCommand:glade.debugCurrentTest",
    "onCommand:glade.replayDebugLog",
    "onCommand:glade.apexLog.refreshAnalysis",
    "onCommand:glade.apexLog.treatAsApexLog",
    "onCommand:glade.apexLog.replayFromFrame",
    "onCommand:glade.runLocalProof",
    "onCommand:glade.createProjectOrg",
    "onCommand:glade.startProjectOrg",
    "onCommand:glade.stopProjectOrg",
    "onCommand:glade.projectOrgStatus",
    "onCommand:glade.cloneEnvironment",
    "onCommand:glade.deleteEnvironment",
    "onCommand:glade.revealEnvironmentDb",
    "onCommand:glade.inspectEnvironment",
    "onCommand:glade.statusQuickPick",
    "onCommand:glade.openOutput",
    "onCommand:glade.workbench.newAnonymousApex",
    "onCommand:glade.workbench.newSoql",
    "onCommand:glade.runSoql",
    "onCommand:glade.workbench.runEntry",
    "onCommand:glade.workbench.runLastSoql",
    "onCommand:glade.workbench.describe",
    "onCommand:glade.workbench.openResult",
    "onCommand:glade.schemaImportDescribe",
    "onCommand:glade.salesforceTargetStatus",
    "onCommand:glade.refreshPlugins",
    "onCommand:glade.managePlugins",
    "onCommand:glade.runPluginAction",
    "onCommand:glade.linkLocalPlugin",
    "onCommand:glade.installPluginArchive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "glade",
          "title": "Glade",
          "icon": "media/glade.svg"
        }
      ]
    },
    "views": {
      "glade": [
        {
          "id": "glade.project",
          "name": "Start Here",
          "visibility": "visible",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.recommendedRuns",
          "name": "Tests",
          "visibility": "collapsed",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.environments",
          "name": "Data Environments",
          "visibility": "collapsed",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.localOrg",
          "name": "Data Browser",
          "visibility": "collapsed",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.workbench",
          "name": "Apex & SOQL",
          "visibility": "collapsed",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.debugLogs",
          "name": "Debug",
          "visibility": "hidden",
          "when": "config.glade.enableSidebar"
        },
        {
          "id": "glade.plugins",
          "name": "Plugins",
          "visibility": "hidden",
          "when": "config.glade.enableSidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "glade.refresh",
        "title": "Glade: Refresh"
      },
      {
        "command": "glade.openHome",
        "title": "Glade: Open Home",
        "icon": "$(home)"
      },
      {
        "command": "glade.runChangedTests",
        "title": "Glade: Run Local Changed Tests"
      },
      {
        "command": "glade.runFailedTests",
        "title": "Glade: Run Local Failed Tests"
      },
      {
        "command": "glade.runLocalProof",
        "title": "Glade: Run Changed Local Tests"
      },
      {
        "command": "glade.createProjectOrg",
        "title": "Glade: Create Local Org"
      },
      {
        "command": "glade.startProjectOrg",
        "title": "Glade: Start Local Org"
      },
      {
        "command": "glade.stopProjectOrg",
        "title": "Glade: Stop Local Org"
      },
      {
        "command": "glade.projectOrgStatus",
        "title": "Glade: Check Local Org State"
      },
      {
        "command": "glade.runLocalTestFromCodeLens",
        "title": "Glade: Run Local Test"
      },
      {
        "command": "glade.debugLocalTestFromCodeLens",
        "title": "Glade: Debug Local Test"
      },
      {
        "command": "glade.startWatch",
        "title": "Glade: Start Local Watch"
      },
      {
        "command": "glade.stopWatch",
        "title": "Glade: Stop Local Watch"
      },
      {
        "command": "glade.createEnvironment",
        "title": "Glade: Create Local Data Environment"
      },
      {
        "command": "glade.switchEnvironment",
        "title": "Glade: Switch Local Data Environment"
      },
      {
        "command": "glade.cloneEnvironment",
        "title": "Glade: Clone Local Data Environment"
      },
      {
        "command": "glade.deleteEnvironment",
        "title": "Glade: Delete Local Data Environment"
      },
      {
        "command": "glade.revealEnvironmentDb",
        "title": "Glade: Reveal Local Data Environment DB"
      },
      {
        "command": "glade.inspectEnvironment",
        "title": "Glade: Inspect Local Data Environment"
      },
      {
        "command": "glade.seedLocalOrg",
        "title": "Glade: Seed Local Data Environment"
      },
      {
        "command": "glade.resetLocalOrg",
        "title": "Glade: Reset Local Data Environment"
      },
      {
        "command": "glade.exportLocalOrg",
        "title": "Glade: Export Local Data Environment"
      },
      {
        "command": "glade.inspectLocalOrg",
        "title": "Glade: Inspect Local Data Environment"
      },
      {
        "command": "glade.executeAnonymous",
        "title": "Glade: Execute Local Anonymous Apex",
        "icon": "$(play)"
      },
      {
        "command": "glade.debugAnonymous",
        "title": "Glade: Debug Local Anonymous Apex",
        "icon": "$(debug-start)"
      },
      {
        "command": "glade.debugCurrentTest",
        "title": "Glade: Debug Local Current Test"
      },
      {
        "command": "glade.replayDebugLog",
        "title": "Glade: Replay Apex Debug Log",
        "icon": "$(debug-restart)"
      },
      {
        "command": "glade.apexLog.refreshAnalysis",
        "title": "Glade: Refresh Apex Log Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "glade.apexLog.treatAsApexLog",
        "title": "Glade: Treat Current File as Apex Log"
      },
      {
        "command": "glade.apexLog.replayFromFrame",
        "title": "Glade: Replay From Log Frame"
      },
      {
        "command": "glade.statusQuickPick",
        "title": "Glade: Show Local Status"
      },
      {
        "command": "glade.openOutput",
        "title": "Glade: Open Output"
      },
      {
        "command": "glade.workbench.newAnonymousApex",
        "title": "Glade: Open Anonymous Apex Scratch",
        "icon": "$(new-file)"
      },
      {
        "command": "glade.workbench.newSoql",
        "title": "Glade: Open SOQL Scratch",
        "icon": "$(new-file)"
      },
      {
        "command": "glade.runSoql",
        "title": "Glade: Run Local SOQL"
      },
      {
        "command": "glade.workbench.runEntry",
        "title": "Glade: Run Workbench Entry"
      },
      {
        "command": "glade.workbench.runLastSoql",
        "title": "Glade: Run Last SOQL"
      },
      {
        "command": "glade.workbench.describe",
        "title": "Glade: Describe Local Data"
      },
      {
        "command": "glade.workbench.openResult",
        "title": "Glade: Open Last Workbench Result"
      },
      {
        "command": "glade.schemaImportDescribe",
        "title": "Glade: Import Describe Schema"
      },
      {
        "command": "glade.salesforceTargetStatus",
        "title": "Glade: Check Salesforce Org"
      },
      {
        "command": "glade.refreshPlugins",
        "title": "Glade: Refresh Plugins"
      },
      {
        "command": "glade.managePlugins",
        "title": "Glade: Manage Plugins"
      },
      {
        "command": "glade.openTui",
        "title": "Glade: Open TUI"
      },
      {
        "command": "glade.openTestsTui",
        "title": "Glade: Open Tests TUI"
      },
      {
        "command": "glade.openDataTui",
        "title": "Glade: Open Data TUI"
      },
      {
        "command": "glade.openPluginsTui",
        "title": "Glade: Open Plugins TUI"
      },
      {
        "command": "glade.runPluginAction",
        "title": "Glade: Run Plugin Action"
      },
      {
        "command": "glade.linkLocalPlugin",
        "title": "Glade: Link Local Plugin"
      },
      {
        "command": "glade.installPluginArchive",
        "title": "Glade: Install Plugin Archive"
      }
    ],
    "keybindings": [
      {
        "command": "glade.executeAnonymous",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == untitled && editorLangId == apex && editorTextFocus"
      },
      {
        "command": "glade.runSoql",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == untitled && editorLangId == soql && editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "glade.refresh",
          "when": "false"
        },
        {
          "command": "glade.runChangedTests",
          "when": "false"
        },
        {
          "command": "glade.runFailedTests",
          "when": "false"
        },
        {
          "command": "glade.createProjectOrg",
          "when": "false"
        },
        {
          "command": "glade.projectOrgStatus",
          "when": "false"
        },
        {
          "command": "glade.runLocalTestFromCodeLens",
          "when": "false"
        },
        {
          "command": "glade.debugLocalTestFromCodeLens",
          "when": "false"
        },
        {
          "command": "glade.startWatch",
          "when": "false"
        },
        {
          "command": "glade.stopWatch",
          "when": "false"
        },
        {
          "command": "glade.createEnvironment",
          "when": "false"
        },
        {
          "command": "glade.switchEnvironment",
          "when": "false"
        },
        {
          "command": "glade.cloneEnvironment",
          "when": "false"
        },
        {
          "command": "glade.deleteEnvironment",
          "when": "false"
        },
        {
          "command": "glade.revealEnvironmentDb",
          "when": "false"
        },
        {
          "command": "glade.inspectEnvironment",
          "when": "false"
        },
        {
          "command": "glade.seedLocalOrg",
          "when": "false"
        },
        {
          "command": "glade.resetLocalOrg",
          "when": "false"
        },
        {
          "command": "glade.exportLocalOrg",
          "when": "false"
        },
        {
          "command": "glade.executeAnonymous",
          "when": "false"
        },
        {
          "command": "glade.debugAnonymous",
          "when": "false"
        },
        {
          "command": "glade.debugCurrentTest",
          "when": "false"
        },
        {
          "command": "glade.openOutput",
          "when": "false"
        },
        {
          "command": "glade.apexLog.replayFromFrame",
          "when": "false"
        },
        {
          "command": "glade.runSoql",
          "when": "false"
        },
        {
          "command": "glade.workbench.runEntry",
          "when": "false"
        },
        {
          "command": "glade.workbench.runLastSoql",
          "when": "false"
        },
        {
          "command": "glade.workbench.describe",
          "when": "false"
        },
        {
          "command": "glade.workbench.openResult",
          "when": "false"
        },
        {
          "command": "glade.schemaImportDescribe",
          "when": "false"
        },
        {
          "command": "glade.salesforceTargetStatus",
          "when": "false"
        },
        {
          "command": "glade.runPluginAction",
          "when": "false"
        },
        {
          "command": "glade.refreshPlugins",
          "when": "false"
        },
        {
          "command": "glade.linkLocalPlugin",
          "when": "false"
        },
        {
          "command": "glade.installPluginArchive",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "glade.executeAnonymous",
          "when": "resourceScheme == untitled && editorLangId == apex",
          "group": "navigation@1"
        },
        {
          "command": "glade.debugAnonymous",
          "when": "resourceScheme == untitled && editorLangId == apex",
          "group": "navigation@2"
        },
        {
          "command": "glade.runSoql",
          "when": "resourceScheme == untitled && editorLangId == soql",
          "group": "navigation@1"
        },
        {
          "command": "glade.replayDebugLog",
          "when": "editorLangId == apexlog",
          "group": "navigation@1"
        },
        {
          "command": "glade.apexLog.refreshAnalysis",
          "when": "editorLangId == apexlog",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "glade.switchEnvironment",
          "when": "view == glade.environments && viewItem == gladeEnvironment",
          "group": "inline@1"
        },
        {
          "command": "glade.cloneEnvironment",
          "when": "view == glade.environments && viewItem =~ /gladeEnvironment/",
          "group": "inline@2"
        },
        {
          "command": "glade.inspectEnvironment",
          "when": "view == glade.environments && viewItem =~ /gladeEnvironment/",
          "group": "inline@3"
        },
        {
          "command": "glade.revealEnvironmentDb",
          "when": "view == glade.environments && viewItem =~ /gladeEnvironment/",
          "group": "navigation@1"
        },
        {
          "command": "glade.deleteEnvironment",
          "when": "view == glade.environments && viewItem == gladeEnvironment",
          "group": "navigation@9"
        },
        {
          "command": "glade.deleteEnvironment",
          "when": "view == glade.environments && viewItem == gladeEnvironmentActive",
          "group": "navigation@9"
        }
      ]
    },
    "languages": [
      {
        "id": "apex",
        "aliases": [
          "Apex",
          "apex"
        ],
        "extensions": [
          ".cls",
          ".trigger"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "apexlog",
        "aliases": [
          "Apex Log",
          "apexlog"
        ],
        "extensions": [
          ".apexlog",
          ".apex.log"
        ],
        "firstLine": "^\\d+(?:\\.\\d+)?\\s+(?=.*\\bAPEX_CODE,)(?:[A-Z_]+,(?:NONE|ERROR|WARN|INFO|DEBUG|FINE|FINER|FINEST);?)+",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "soql",
        "aliases": [
          "SOQL",
          "soql"
        ],
        "extensions": [
          ".soql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "apexlog",
        "scopeName": "source.apexlog",
        "path": "./syntaxes/apexlog.tmLanguage.json"
      },
      {
        "language": "soql",
        "scopeName": "source.soql",
        "path": "./syntaxes/soql.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "apex"
      }
    ],
    "debuggers": [
      {
        "type": "glade",
        "label": "Glade Apex Debugger",
        "languages": [
          "apex"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Apex entry point or anonymous Apex to debug."
              },
              "source": {
                "type": "string",
                "description": "Anonymous Apex source to debug."
              },
              "project": {
                "type": "string",
                "description": "Salesforce DX project root. Defaults to the workspace folder."
              },
              "dbPath": {
                "type": "string",
                "description": "SQLite local org path for DB-backed debug sessions."
              },
              "dryRun": {
                "type": "boolean",
                "description": "Run the debug session without saving local org DB changes."
              },
              "className": {
                "type": "string",
                "description": "Apex class context for local test debug sessions."
              },
              "methodName": {
                "type": "string",
                "description": "Apex method context for local test debug sessions."
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Glade",
      "properties": {
        "glade.enableSidebar": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Glade Activity Bar and sidebar views."
        },
        "glade.enableTestExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Enable Glade local Apex Test Explorer integration."
        },
        "glade.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable Glade local Apex CodeLens commands."
        },
        "glade.enableLsp": {
          "type": "boolean",
          "default": false,
          "description": "Enable Glade local Apex language diagnostics."
        },
        "glade.apexLog.smartFeatures.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Glade-powered Apex debug log navigation, folding, symbols, hovers, diagnostics, and semantic tokens."
        },
        "glade.apexLog.maxAnalysisBytes": {
          "type": "number",
          "default": 10485760,
          "description": "Maximum Apex log size, in bytes, for background smart analysis."
        },
        "glade.apexLog.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Apex log code lenses for source navigation and replay."
        },
        "glade.environments": {
          "type": "array",
          "default": [],
          "description": "Named local Glade data environments. Empty means a dev environment at .glade/envs/dev.sqlite.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "dbPath"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "dbPath": {
                "type": "string"
              },
              "fixturePath": {
                "type": "string"
              }
            }
          }
        },
        "glade.activeEnvironment": {
          "type": "string",
          "default": "dev",
          "description": "Name of the active Glade local data environment."
        },
        "glade.changedSince": {
          "type": "string",
          "default": "origin/main",
          "description": "Default Git ref for Glade local changed-test runs."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "package": "mkdir -p dist && npm run compile && npm run bundle && vsce package --allow-missing-repository --out dist/vscode-glade-${npm_package_version}.vsix",
    "test": "npm run compile && node test/commands.test.js && node test/apexLogDetection.test.js && node test/apexLogCache.test.js && node test/apexLogDiagnostics.test.js && node test/apexLogProviders.test.js && node test/adapter.test.js && node test/projectModel.test.js && node test/gladeCli.test.js && node test/testDiscovery.test.js && node test/testResults.test.js && node test/environments.test.js && node test/environmentActions.test.js && node test/localOrg.test.js && node test/localOrgArgs.test.js && node test/watch.test.js && node test/statusModel.test.js && node test/package.test.js && node test/branding.test.js && node test/extensionHubRefresh.test.js && node test/startHereModel.test.js && node test/startHereState.test.js && node test/hubModel.test.js && node test/hubActions.test.js && node test/hubHtml.test.js && node test/hubController.test.js && node test/hubSalesforce.test.js && node test/pluginModules.test.js && node test/pluginController.test.js && node test/workbenchModel.test.js && node test/workbenchStore.test.js && node test/workbenchCli.test.js && node test/workbenchView.test.js && node test/sidebarViews.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "undici": "7.28.0"
  }
}
