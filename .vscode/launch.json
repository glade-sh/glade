{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Glade VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/contrib/vscode-glade"
      ],
      "outFiles": [
        "${workspaceFolder}/contrib/vscode-glade/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile vscode-glade"
    }
  ]
}
