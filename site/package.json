{
  "scripts": {
    "check:routes": "node scripts/check-doc-routes.mjs",
    "generate:editor-support": "node scripts/build-editor-support.mjs",
    "help:project": "node scripts/help-project/setup.mjs",
    "help:capture": "bash scripts/capture-help-screenshots.sh",
    "help:screenshot": "bash scripts/capture-help-screenshot-target.sh",
    "help:check": "node scripts/check-help-screenshots.mjs",
    "dev": "vitepress dev .",
    "build": "npm run check:routes && npm run generate:editor-support -- --check && npm run help:check && vitepress build . && cp install.sh .vitepress/dist/install.sh",
    "test": "npm run check:routes && npm run generate:editor-support -- --check && npm run help:check && node --test tests/*.test.mjs",
    "preview": "vitepress preview ."
  },
  "devDependencies": {
    "@fontsource-variable/host-grotesk": "^5.2.8",
    "@fontsource/monaspace-argon": "^5.2.5",
    "vitepress": "2.0.0-alpha.17"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  }
}
