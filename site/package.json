{
  "scripts": {
    "check:routes": "node scripts/check-doc-routes.mjs",
    "check:built": "node scripts/check-built-site.mjs",
    "generate:editor-support": "node scripts/build-editor-support.mjs",
    "help:project": "node scripts/help-project/setup.mjs",
    "help:capture": "bash scripts/capture-help-screenshots.sh",
    "help:screenshot": "bash scripts/capture-help-screenshot-target.sh",
    "help:check": "node scripts/check-help-screenshots.mjs",
    "dev": "vitepress dev .",
    "verify": "npm run check:routes && npm run generate:editor-support -- --check && npm run help:check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "smoke:preview": "node scripts/preview-smoke.mjs",
    "smoke:postdeploy": "node scripts/postdeploy-smoke.mjs",
    "test:release": "node --test scripts/release-check.test.mjs",
    "build:site": "vitepress build . && cp install.sh .vitepress/dist/install.sh && node scripts/write-site-build.mjs",
    "release:sync": "node scripts/sync-release-manifest.mjs",
    "release:sync:check": "node scripts/sync-release-manifest.mjs --check",
    "release:check": "node scripts/release-check.mjs",
    "build": "npm run verify && npm run build:site",
    "test": "npm run verify && npm run test:unit",
    "preview": "vitepress preview ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/host-grotesk": "^5.2.8",
    "@fontsource/monaspace-argon": "^5.2.5",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.12.1",
    "vitepress": "2.0.0-alpha.17"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  }
}
