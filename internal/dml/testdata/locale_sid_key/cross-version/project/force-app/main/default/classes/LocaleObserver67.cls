public class LocaleObserver67 { public static Map<String,Object> sample() { List<Schema.PicklistEntry> entries=User.LocaleSidKey.getDescribe().getPicklistValues(); Set<String> values=new Set<String>(); for(Schema.PicklistEntry e:entries) values.add(e.getValue()); return new Map<String,Object>{'count'=>entries.size(),'en_BR'=>values.contains('en_BR'),'en_MX'=>values.contains('en_MX'),'en_SA'=>values.contains('en_SA')}; } }