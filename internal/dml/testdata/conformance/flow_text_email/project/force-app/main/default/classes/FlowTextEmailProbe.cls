    public static Map<String,Object> direct_email_true() { String address=UserInfo.getUserEmail(); String subject='Flow Text Email direct_email_true'; Account seed=new Account(Name=subject,Description=address); insert seed; Flow.Interview interview=Flow.Interview.createInterview('TextEmailDirectEmailTrue',new Map<String,Object>{'Address'=>address,'Body'=>'variable body','RelatedId'=>seed.Id,'Subject'=>subject}); interview.start(); List<EmailMessage> messages=[SELECT Subject,TextBody,ToAddress FROM EmailMessage WHERE Subject=:subject]; Map<String,Object> result=new Map<String,Object>{'count'=>messages.size(),'completed'=>interview.getVariableValue('Completed')}; if(!messages.isEmpty()){ result.put('body',messages[0].TextBody); result.put('addressMatches',messages[0].ToAddress!=null && messages[0].ToAddress.toLowerCase().contains(address.toLowerCase())); } return result; }
