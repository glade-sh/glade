<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
 <label>Score Pad</label><pluralLabel>Score Pads</pluralLabel><deploymentStatus>Deployed</deploymentStatus><sharingModel>ReadWrite</sharingModel>
 <nameField><label>Score Pad Name</label><type>Text</type></nameField>
 <fields><fullName>Score__c</fullName><label>Score</label><type>Number</type><precision>12</precision><scale>0</scale></fields>
 <fields><fullName>QualifiedScore__c</fullName><label>Qualified Score</label><type>Number</type><precision>12</precision><scale>0</scale></fields>
 <fields><fullName>RecordOnly__c</fullName><label>Record Only</label><type>Checkbox</type><defaultValue>false</defaultValue></fields>
 <validationRules><fullName>NegativeField</fullName><active>true</active><errorConditionFormula>AND(Score__c &lt; 0, NOT(RecordOnly__c))</errorConditionFormula><errorDisplayField>Score__c</errorDisplayField><errorMessage>Negative score is unavailable.</errorMessage></validationRules>
 <validationRules><fullName>NegativeRecord</fullName><active>true</active><errorConditionFormula>AND(Score__c &lt; 0, RecordOnly__c)</errorConditionFormula><errorMessage>Negative score is unavailable.</errorMessage></validationRules>
 <validationRules><fullName>NegativeQualified</fullName><active>true</active><errorConditionFormula>QualifiedScore__c &lt; 0</errorConditionFormula><errorDisplayField>QUALIFIED_FIELD</errorDisplayField><errorMessage>Negative qualified score is unavailable.</errorMessage></validationRules>
</CustomObject>
