Schema.SObjectField f=Schema.getGlobalDescribe().get('Account').getDescribe().fields.getMap().get('Type');List<String> values=new List<String>();if(f!=null)for(Schema.PicklistEntry e:f.getDescribe().getPicklistValues())values.add(e.getValue()+':label='+e.getLabel()+':active='+e.isActive()+':default='+e.isDefaultValue());throw new StandardResultException('test:'+Test.isRunningTest()+'|object:Account|field:Type|present:'+(f!=null)+'|picks:['+String.join(values,',')+']|end');
