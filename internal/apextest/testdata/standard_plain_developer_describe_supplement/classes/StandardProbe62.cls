public class StandardProbe62 {
 public static String sig(Schema.SObjectField token){if(token==null)return 'absent';Schema.DescribeFieldResult f=token.getDescribe();List<String> entries=new List<String>();for(Schema.PicklistEntry e:f.getPicklistValues())entries.add(e.getValue()+':label='+e.getLabel()+':active='+e.isActive()+':default='+e.isDefaultValue());return 'name='+f.getName()+':label='+f.getLabel()+':type='+f.getType()+':length='+f.getLength()+':nillable='+f.isNillable()+':defaulted='+f.isDefaultedOnCreate()+':accessible='+f.isAccessible()+':create='+f.isCreateable()+':update='+f.isUpdateable()+':permissionable='+f.isPermissionable()+':filterable='+f.isFilterable()+':sortable='+f.isSortable()+':groupable='+f.isGroupable()+':calculated='+f.isCalculated()+':restricted='+f.isRestrictedPicklist()+':picks=['+String.join(entries,',')+']';}
 public static String tier(){Map<String,Schema.SObjectField> a=Account.SObjectType.getDescribe().fields.getMap(),c=Contact.SObjectType.getDescribe().fields.getMap();return 'test:'+Test.isRunningTest()+'|accountTierMap:'+sig(a.get('Tier'))+'|accountPortal:'+a.containsKey('IsCustomerPortal')+'|contactPortal:'+c.containsKey('IsCustomerPortal')+'|end';}
 public static String pick(String obj,String name){Schema.SObjectField f=Schema.getGlobalDescribe().get(obj).getDescribe().fields.getMap().get(name);return 'test:'+Test.isRunningTest()+'|object:'+obj+'|field:'+name+'|'+sig(f)+'|end';}
}
