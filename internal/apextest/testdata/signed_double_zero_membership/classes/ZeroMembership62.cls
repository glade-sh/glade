public class ZeroMembership62 {
 public static String setCase(String label,Double first,Double second,Double pos,Double neg,Double one) { Set<Double> s=new Set<Double>();Boolean a=s.add(first),b=s.add(second),c=s.add(one);String pre='added='+a+','+b+','+c+':size='+s.size()+':contains='+s.contains(pos)+','+s.contains(neg)+','+s.contains(one);Boolean removed=s.remove(neg);return label+':'+pre+':removeNeg='+removed+':afterSize='+s.size()+':afterContains='+s.contains(pos)+','+s.contains(neg)+','+s.contains(one); }
 public static String mapCase(String label,Double first,Double second,Double pos,Double neg,Double one) { Map<Double,String> m=new Map<Double,String>();m.put(first,'first');m.put(second,'second');m.put(one,'one');String pre='size='+m.size()+':has='+m.containsKey(pos)+','+m.containsKey(neg)+','+m.containsKey(one)+':values='+m.get(pos)+','+m.get(neg)+','+m.get(one);String removed=m.remove(neg);return label+':'+pre+':removeNeg='+removed+':afterSize='+m.size()+':afterHas='+m.containsKey(pos)+','+m.containsKey(neg)+','+m.containsKey(one); }
 public static String probe() { Double pos=Double.valueOf('0.0'),neg=Double.valueOf('-0.0'),one=Double.valueOf('1.0');List<Double> a=new List<Double>{pos,one},b=new List<Double>{neg,one};List<Double> both=new List<Double>{pos,neg,one};return 'test:'+Test.isRunningTest()+'|'+setCase('setPosFirst',pos,neg,pos,neg,one)+'|'+setCase('setNegFirst',neg,pos,pos,neg,one)+'|'+mapCase('mapPosFirst',pos,neg,pos,neg,one)+'|'+mapCase('mapNegFirst',neg,pos,pos,neg,one)+'|list:equals='+(a==b)+':aContains='+a.contains(pos)+','+a.contains(neg)+','+a.contains(one)+':bContains='+b.contains(pos)+','+b.contains(neg)+','+b.contains(one)+':bothIndex='+both.indexOf(pos)+','+both.indexOf(neg)+','+both.indexOf(one); }
}