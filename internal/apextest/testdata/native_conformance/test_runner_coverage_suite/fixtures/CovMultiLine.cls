public class CovMultiLine {
    public static Integer total(Integer a, Integer b, Integer c) {
        Integer sum =
            a
            + b
            + c;
        return sum;
    }

    public static String join(String a, String b, String c) {
        String out = a
            + '-'
            + b
            + '-'
            + c;
        return out;
    }
}
