Map<String,Object> result=new Map<String,Object>();Map<String,Schema.SObjectType> gd=Schema.getGlobalDescribe();for(String n:new List<String>{'AccountBrand','AccountBrandShare','Audience','DelegatedAccount','DelegatedAccountFeed','DelegatedAccountHistory','DelegatedAccountShare','MobSecurityCertPinConfig','MobileSecurityAssignment','MobileSecurityPolicy','MobileSecurityUserMetric','NavigationLinkSet','Account','AbsentObject__c'}){result.put(n+'.describe',gd.containsKey(n));result.put(n+'.type',Type.forName('Schema.'+n)!=null);try{Database.countQuery('SELECT COUNT() FROM '+n);result.put(n+'.query',true);}catch(Exception e){result.put(n+'.query',e.getTypeName());}}System.debug('OBSERVED|capture|'+JSON.serialize(result));
