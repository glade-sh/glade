@IsTest private class InfluenceQueryLimits67Test { @IsTest static void observe() { Map<String,Object> result=new Map<String,Object>();for(String route:new List<String>{'queryDefault','queryUser','querySystem','countDefault','countUser','countSystem'}){Integer beforeQueries=Limits.getQueries();String outcome='ok';try{if(route=='queryDefault')Database.query('SELECT Id FROM CampaignInfluence');if(route=='queryUser')Database.query('SELECT Id FROM CampaignInfluence',AccessLevel.USER_MODE);if(route=='querySystem')Database.query('SELECT Id FROM CampaignInfluence',AccessLevel.SYSTEM_MODE);if(route=='countDefault')Database.countQuery('SELECT COUNT() FROM CampaignInfluence');if(route=='countUser')Database.countQuery('SELECT COUNT() FROM CampaignInfluence',AccessLevel.USER_MODE);if(route=='countSystem')Database.countQuery('SELECT COUNT() FROM CampaignInfluence',AccessLevel.SYSTEM_MODE);}catch(Exception e){outcome=e.getTypeName();}result.put(route+'.result',outcome);result.put(route+'.queries',Limits.getQueries()-beforeQueries);}System.assert(false,'OBSERVED|capture|'+JSON.serialize(result));} }
