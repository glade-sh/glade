public class V035PickValues { public static void capture() { Schema.DescribeFieldResult d=Schema.getGlobalDescribe().get('ShiftAllocationRequest').getDescribe().fields.getMap().get('RequestType').getDescribe(); List<Object> out=new List<Object>(); for(Schema.PicklistEntry p:d.getPicklistValues()) out.add(new Map<String,Object>{'value'=>p.getValue(),'label'=>p.getLabel(),'active'=>p.isActive(),'defaultValue'=>p.isDefaultValue()}); System.debug(LoggingLevel.ERROR,'VALUES|'+JSON.serialize(out)); } }
