try { EmailTemplate e=new EmailTemplate(Name='probe',DeveloperName='Road548Template'+String.valueOf(Math.abs(Crypto.getRandomInteger())),IsActive=true,FolderId=UserInfo.getUserId(),TemplateType='text',Subject='probe',Body='probe'); insert e; Messaging.SingleEmailMessage m=new Messaging.SingleEmailMessage(); m.setOrgWideEmailAddressId('0D2000000000001'); m.setTargetObjectId(UserInfo.getUserId()); m.setSaveAsActivity(false); m.setTemplateId(e.Id); Messaging.SendEmailResult r=Messaging.sendEmail(new Messaging.SingleEmailMessage[]{m},false)[0]; String out='success='+r.isSuccess(); for (Messaging.SendEmailError x:r.getErrors()) out+=';error='+x.getStatusCode()+':'+x.getMessage(); System.debug('ROAD548_TEMPLATE='+out); } catch (Exception e) { System.debug('ROAD548_TEMPLATE=exception='+e.getTypeName()+':'+e.getMessage()); }