      "helperSource": "public class CaptureOrderOracle62 {\n private static Object observe(String source,String input){\n  Matcher m=Pattern.compile(source).matcher(input);Map<String,Object> out=new Map<String,Object>();Boolean matched=m.matches();out.put('matched',matched);out.put('count',m.groupCount());\n  if(matched){List<Object> groups=new List<Object>();for(Integer i=0;i<=m.groupCount();i++){groups.add(new Map<String,Object>{'value'=>m.group(i),'start'=>m.start(i),'end'=>m.end(i)});}out.put('groups',groups);}return out;\n }\n public static String regexSnapshot(){\n  Map<String,Object> out=new Map<String,Object>();\n  out.put('namedFirst',observe('^(?<head>a)(b)$','ab'));\n  out.put('namedLast',observe('^(a)(?<tail>b)$','ab'));\n  out.put('optionalPresent',observe('^(?<stem>[0-9]+)(\\\\.([0-9]+))?$','7.8'));\n  out.put('optionalAbsent',observe('^(?<stem>[0-9]+)(\\\\.([0-9]+))?$','7'));\n  out.put('interleaved',observe('^(?<first>[0-9]+)(\\\\.([0-9]+))?(\\\\.(?<last>[0-9]+))?$','7.8.9'));\n  out.put('plain',observe('^(a)(b)$','ab'));\n  out.put('namedOnly',observe('^(?<head>a)(?<tail>b)$','ab'));\n  out.put('numericReplacement',Pattern.compile('(?<head>a)(b)').matcher('ab').replaceAll('$2$1'));\n  out.put('namedReplacement',Pattern.compile('(?<head>a)(b)').matcher('ab').replaceAll('${head}-$2'));\n  out.put('grapheme',observe('^(\\\\X)(?<tail>b)(c)$','ábc'));\n  out.put('scopedFlags',observe('(?i:(?<word>a))(b)(?=c)c','Abc'));\n  return JSON.serialize(out);\n }\n public static String mapSnapshot(){\n  Map<String,Object> a=new Map<String,Object>{'slot'=>'north'};\n  Map<String,Object> same=new Map<String,Object>{'slot'=>'north'};\n  Map<String,Object> mixed=new Map<String,Object>{'slot'=>'NORTH'};\n  Map<String,Object> keyMixed=new Map<String,Object>{'SLOT'=>'north'};\n  Map<String,Object> changed=new Map<String,Object>{'slot'=>'south'};\n  Object boxedA=a;Object boxedMixed=mixed;\n  Map<String,Object> out=new Map<String,Object>{\n   'sameOperator'=>a==same,'sam