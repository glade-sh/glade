  "testClass": "OwnedHiddenReflectionProbe",
  "sources": {
    "OwnedVisibleReflectionTest": "@IsTest public class OwnedVisibleReflectionTest {\n @IsTest static void control() {}\n}\n",
    "OwnedReflectionLookup": "public class OwnedReflectionLookup {\n public static Map<String,Object> inspect(String name) {\n  Map<String,Object> result = new Map<String,Object>();\n  try { result.put('single',Type.forName(name)?.getName()); }\n  catch(Exception e) { result.put('single','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  try { result.put('empty',Type.forName('',name)?.getName()); }\n  catch(Exception e) { result.put('empty','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  try { result.put('null',Type.forName(null,name)?.getName()); }\n  catch(Exception e) { result.put('null','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  return result;\n }\n}\n",
    "OwnedHiddenReflectionProbe": "@IsTest private class OwnedHiddenReflectionProbe {\n private class HiddenWorker {}\n @IsTest static void h01() { observe('H01',OwnedReflectionLookup.inspect('OwnedHiddenReflectionProbe')); }\n @IsTest static void h02() { observe('H02',OwnedReflectionLookup.inspect('OwnedReflectionLookup')); }\n @IsTest static void h03() { observe('H03',OwnedReflectionLookup.inspect('OwnedHiddenReflectionProbe.HiddenWorker')); }\n @IsTest static void h04() { observe('H04',OwnedReflectionLookup.inspect('OwnedVisibleReflectionTest')); }\n @IsTest static void h05() {\n  Map<String,Object> result=new Map<String,Object>();\n  try { result.put('single',Type.forName('OwnedHiddenReflectionProbe')?.getName()); }\n  catch(Exception e) { result.put('single','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  try { result.put('empty',Type.forName('','OwnedHiddenReflectionProbe')?.getName()); }\n  catch(Exception e) { result.put('empty','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  try { result.put('null',Type.forName(null,'OwnedHiddenReflectionProbe')?.getName()); }\n  catch(Exception e) { result.put('null','EXCEPTION:'+e.getTypeName()+':'+e.getMessage()); }\n  observe('H05',result);\n }\n private static void observe(String row,Map<String,Object> result) {\n  System.assert(false,'REFLECT_VISIBILITY|'+row+'|'+JSON.serialize(result));\n }\n}\n"
  },
