    "62.0": {
      "id": "builtin-license-source-62",
      "anonymous": "System.debug(LoggingLevel.ERROR,'NATIVE_RESULT|PROFILE|'+JSON.serialize(OwnedProfile62.profileObservation()));",
      "classes": {
        "OwnedProfile62": "public class OwnedProfile62 {\n public static Map<String,Object> profileObservation(){\n  List<Profile> profiles=[SELECT Id,Name,UserType,UserLicense.Name,UserLicense.LicenseDefinitionKey FROM Profile WHERE Name='Chatter Free User' LIMIT 1];\n  Map<String,Object> o=new Map<String,Object>{'row'=>'PROFILE','profileCount'=>profiles.size()};\n  if(!profiles.isEmpty()){Profile p=profiles[0];o.put('profileName',p.Name);o.put('userType',p.UserType);o.put('licenseName',p.UserLicense.Name);o.put('licenseKey',p.UserLicense.LicenseDefinitionKey);}\n  return o;\n }\n public static Map<String,Object> accountFacets(){\n  Schema.DescribeSObjectResult d=Account.SObjectType.getDescribe();\n  Map<String,Object> o=new Map<String,Object>{'crud'=>new Map<String,Object>{'read'=>d.isAccessible(),'create'=>d.isCreateable(),'update'=>d.isUpdateable(),'delete'=>d.isDeletable()}};\n  Map<String,Object> fields=new Map<String,Object>();Map<String,Schema.SObjectField> tokens=d.fields.getMap();\n  for(String name:new List<String>{'Id','Name','Phone','Description','AccountNumber','BillingCity','Industry','OwnerId','CreatedById'}){Schema.DescribeFieldResult f=tokens.get(name).getDescribe();fields.put(name,new Map<String,Object>{'read'=>f.isAccessible(),'create'=>f.isCreateable(),'update'=>f.isUpdateable()});}\n  o.put('fields',fields);return o;\n }\n}\n",
        "OwnedLicenseActor62Test": "@IsTest private class OwnedLicenseActor62Test {\n @IsTest static void profile(){System.assert(false,'NATIVE_RESULT|PROFILE|'+JSON.serialize(OwnedProfile62.profileObservation()));}\n @IsTest static void actor(){\n  Map<String,Object> o=OwnedProfile62.profileObservation();o.put('row','ACTOR');o.put('phase','profile-missing');\n  List<Profile> profiles=[SELECT Id FROM Profile WHERE Name='Chatter Free User' LIMIT 1];\n  if(!profiles.isEmpty()){\n   try{\n    User actor=new User(ProfileId=profiles[0].Id,Username='owned-'+DateTime.now().getTime()+'@example.invalid',Alias='owned',LastName='Owned Actor',Email='owned@example.invalid',EmailEncodingKey='UTF-8',LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='America/New_York');insert actor;\n    o.put('admin',OwnedProfile62.accountFacets());\n    System.runAs(actor){o.put('actorMatches',UserInfo.getUserId()==actor.Id);o.put('profileMatches',UserInfo.getProfileId()==profiles[0].Id);o.put('actor',OwnedProfile62.accountFacets());}\n    o.put('phase','complete');\n   }catch(Exception e){o.put('phase','actor-error');o.put('errorType',e.getTypeName());o.put('errorMessage',e.getMessage());}\n  }\n  System.assert(false,'NATIVE_RESULT|ACTOR|'+JSON.serialize(o));\n }\n}\n"
      },
      "tests": [
        "OwnedLicenseActor62Test"
      ],
      "stage": "observed",
