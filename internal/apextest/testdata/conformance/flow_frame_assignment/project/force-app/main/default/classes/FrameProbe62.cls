@IsTest private class FrameProbe62 { @IsTest static void probe(){List<SyntheticItem__c> xs=new List<SyntheticItem__c>{new SyntheticItem__c(Name='Def-item',Unit__c='before'),new SyntheticItem__c(Name='Unset-item',Unit__c='before'),new SyntheticItem__c(Name='Other-item',Unit__c='before')};insert as system xs;List<String> values=new List<String>();for(SyntheticItem__c x:[SELECT Name,Unit__c FROM SyntheticItem__c WHERE Id IN :xs WITH SYSTEM_MODE ORDER BY Name])values.add(x.Name+':'+x.Unit__c);String tooLong='';for(Integer i=0;i<81;i++)tooLong+='x';String rejected='none';try{insert as system new SyntheticItem__c(Name='Reject-item',Unit__c=tooLong);}catch(DmlException e){rejected=String.valueOf(e.getDmlStatusCode(0));}System.assert(false,'CAPTURE|Frame|'+JSON.serialize(new Map<String,Object>{'rows'=>new Map<String,Object>{'values'=>values,'overlength'=>rejected}}));} }