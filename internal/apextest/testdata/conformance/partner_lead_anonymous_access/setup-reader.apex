Contact c=[SELECT Id FROM Contact WHERE LastName='Route Contact' LIMIT 1]; Profile p=[SELECT Id FROM Profile WHERE Name='Partner Community User' LIMIT 1]; User u=new User(Alias='rtprt',Email='reader@example.invalid',EmailEncodingKey='UTF-8',LastName='Reader',LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='America/Los_Angeles',ProfileId=p.Id,ContactId=c.Id,Username='routereader.'+System.now().getTime()+'@example.invalid'); insert u; PermissionSet ps=new PermissionSet(Name='RouteLeadRead',Label='RouteLeadRead'); insert ps; insert new ObjectPermissions(ParentId=ps.Id,SobjectType='Lead',PermissionsRead=true); insert new PermissionSetAssignment(AssigneeId=u.Id,PermissionSetId=ps.Id);
