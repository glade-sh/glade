User u=[SELECT Id FROM User WHERE Alias='rtown' LIMIT 1]; Account a=new Account(Name='Route Account',OwnerId=u.Id); insert a; a.IsPartner=true; update a; Contact c=new Contact(LastName='Route Contact',AccountId=a.Id,OwnerId=u.Id); insert c; insert new List<Lead>{new Lead(LastName='Route First',Company='Synthetic',OwnerId=u.Id),new Lead(LastName='Route Second',Company='Synthetic',OwnerId=u.Id)};
