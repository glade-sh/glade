@IsTest private class CedarScalarProbeTest {
@IsTest static void boolean_direct(){Map<String,Object> observed=new Map<String,Object>(); try {Flow.Interview interview=Flow.Interview.createInterview('CedarScalarBool',new Map<String,Object>()); interview.start(); Object value=interview.getVariableValue('Result'); observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|boolean_direct|'+JSON.serialize(observed));}
@IsTest static void boolean_trigger(){Map<String,Object> observed=new Map<String,Object>(); try {Account record=new Account(Name='CedarScalarBool'); insert record; record=[SELECT Description FROM Account WHERE Id=:record.Id]; Object value=record.Description; observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|boolean_trigger|'+JSON.serialize(observed));}
