Map<String,Object> observed=new Map<String,Object>(); try {Flow.Interview interview=Flow.Interview.createInterview('CedarScalarFraction',new Map<String,Object>()); interview.start(); Object value=interview.getVariableValue('Result'); observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|fraction_direct|'+JSON.serialize(observed));
