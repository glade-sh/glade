Map<String,Object> observed=new Map<String,Object>(); try {Invocable.Action action=Invocable.Action.createCustomAction('flow','CedarScalarBool'); action.setInvocations(new List<Map<String,Object>>{new Map<String,Object>()}); List<Invocable.Action.Result> results=action.invoke(); Object value=results[0].getOutputParameters().get('Result'); observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|boolean_action|'+JSON.serialize(observed));
