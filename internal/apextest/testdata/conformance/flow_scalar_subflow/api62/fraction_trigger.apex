Map<String,Object> observed=new Map<String,Object>(); try {Account record=new Account(Name='CedarScalarFraction'); insert record; record=[SELECT Description FROM Account WHERE Id=:record.Id]; Object value=record.Description; observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|fraction_trigger|'+JSON.serialize(observed));
