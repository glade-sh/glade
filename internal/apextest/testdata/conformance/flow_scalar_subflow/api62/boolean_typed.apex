Map<String,Object> observed=new Map<String,Object>(); try {Flow.Interview interview=new Flow.Interview.CedarScalarBool(new Map<String,Object>()); interview.start(); Object value=interview.getVariableValue('Result'); observed.put('value',value); } catch(Exception e) { observed.put('exception',e.getTypeName()); observed.put('message',e.getMessage()); } System.assert(false,'CEDAR|boolean_typed|'+JSON.serialize(observed));
