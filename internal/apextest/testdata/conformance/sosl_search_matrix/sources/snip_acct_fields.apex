Search.SearchResults sr = Search.find('FIND {copper} RETURNING Account(Name, Site, Website) WITH SNIPPET'); List<String> p = new List<String>(); for (Search.SearchResult x : sr.get('Account')) { String n = (String) x.getSObject().get('Name'); if (n != null && n.endsWith('qzx')) { p.add(n + '=' + x.getSnippet() + '/' + x.getSnippet('Name') + '/' + x.getSnippet('Site') + '/' + x.getSnippet('Website')); } } p.sort(); obs = String.join(p, ' ; ');
