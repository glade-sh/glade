<assignments><name>SetDate</name><label>Set date</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Record.Birthdate</assignToReference><operator>Assign</operator><value><elementReference>chosenDate</elementReference></value></assignmentItems><connector><targetReference>CheckDate</targetReference></connector></assignments>
<customErrors><name>RejectDate</name><label>Reject date</label><locationX>0</locationX><locationY>0</locationY><customErrorMessages><errorMessage>Grove date outside range</errorMessage><isFieldError>false</isFieldError></customErrorMessages></customErrors>
<decisions><name>CheckDate</name><label>Check date</label><locationX>0</locationX><locationY>0</locationY><defaultConnectorLabel>Allowed</defaultConnectorLabel><rules><name>TooFar</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>dateAllowed</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>RejectDate</targetReference></connector><label>Too far</label></rules></decisions>
<formulas><name>chosenDate</name><dataType>Date</dataType><expression>IF(ISBLANK({!$Record.Birthdate}), {!$Flow.CurrentDate} + 5, {!$Record.Birthdate})</expression></formulas>
