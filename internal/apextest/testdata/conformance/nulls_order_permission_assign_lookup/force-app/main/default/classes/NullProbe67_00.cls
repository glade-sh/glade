@IsTest private class NullProbe67_00 { @IsTest static void probe(){Map<String,Object> output=new Map<String,Object>();try{PermissionSet p=new PermissionSet(Name='SyntheticSet',Label='Synthetic Set');insert as system p;List<PermissionSetGroup> groups=new List<PermissionSetGroup>{new PermissionSetGroup(DeveloperName='SyntheticAlpha',MasterLabel='Synthetic Alpha'),new PermissionSetGroup(DeveloperName='SyntheticBeta',MasterLabel='Synthetic Beta')};insert as system groups;for(PermissionSetGroup g:groups)Test.calculatePermissionSetGroup(g.Id);List<PermissionSetAssignment> assignments=new List<PermissionSetAssignment>{new PermissionSetAssignment(AssigneeId=UserInfo.getUserId(),PermissionSetId=p.Id),new PermissionSetAssignment(AssigneeId=UserInfo.getUserId(),PermissionSetGroupId=groups[0].Id),new PermissionSetAssignment(AssigneeId=UserInfo.getUserId(),PermissionSetGroupId=groups[1].Id)};insert as system assignments;Set<Id> ids=new Set<Id>();for(PermissionSetAssignment a:assignments)ids.add(a.Id);for(String field:new List<String>{'PermissionSetGroupId','PermissionSetId'}){Map<String,Object> obs=new Map<String,Object>();List<SObject> saved=Database.query('SELECT Id,'+field+' FROM PermissionSetAssignment WHERE Id IN :ids');List<Id> parents=new List<Id>();for(SObject row:saved)if(row.get(field)!=null)parents.add((Id)row.get(field));parents.sort();if(saved.size()!=3||parents.size()!=2||parents[0]==parents[1])obs.put('skip','expected one saved null and two distinct parents');else{Map<Id,String> labels=new Map<Id,String>();for(SObject row:saved){Id value=(Id)row.get(field);labels.put(row.Id,value==null?'N':(value==parents[0]?'L':'H'));}for(String tail:new List<String>{'NULLS FIRST','NULLS LAST','ASC','DESC','DESC NULLS LAST'}){List<String> ordered=new List<String>();for(SObject row:Database.query('SELECT Id FROM PermissionSetAssignment WHERE Id IN :ids ORDER BY '+field+' '+tail))ordered.add(labels.get(row.Id));obs.put(tail,String.join(ordered,''));}}output.put(field,obs);}}catch(Exception e){for(String field:new List<String>{'PermissionSetGroupId','PermissionSetId'})output.put(field,new Map<String,Object>{'skip'=>'EXC '+e.getTypeName()+': '+e.getMessage().left(200)});}System.assert(false,'CAPTURE|PermissionSetAssignment|'+JSON.serialize(output)); }}
