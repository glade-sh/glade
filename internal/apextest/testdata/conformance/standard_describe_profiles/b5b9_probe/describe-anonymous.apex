Map<String, Schema.SObjectType> m = Schema.getGlobalDescribe();
Map<String,List<String>> targets = new Map<String,List<String>>{'PlatformCachePartition'=>new List<String>{'MasterLabel'},'DocumentTemplateContentDoc'=>new List<String>{'Id'},'DocumentGenerationProcess'=>new List<String>{'Id'},'RegulatoryCode'=>new List<String>{'IsActive'},'CustomMetadata'=>new List<String>{'MasterLabel'},'PricebookEntry'=>new List<String>{'ProductSellingModelId'},'BuyerGroup'=>new List<String>{'StrikethroughPricebookId'},'Customer'=>new List<String>{'Identifier','ExemptionId','EntityUseCode'},'GiftTransaction'=>new List<String>{'Id'},'GiftCommitment'=>new List<String>{'Id'}};
for (String n:targets.keySet()) {Schema.SObjectType t=m.get(n); for(String f:targets.get(n)) System.debug('ROW '+n+'.'+f+' '+(t==null ? 'object-absent' : String.valueOf(t.getDescribe().fields.getMap().containsKey(f))));}
