public class StandardDescribeMembership62 { public static void capture(List<String> names) { for(String n : names) { Schema.SObjectType token = Schema.getGlobalDescribe().get(n); if(token == null){ System.debug(LoggingLevel.ERROR,'FIELDSET|'+n+'|null'); continue; } List<Object> values = new List<Object>(); for(Schema.SObjectField f : token.getDescribe().fields.getMap().values()){ Schema.DescribeFieldResult d = f.getDescribe(); values.add(new Map<String,Object>{'name'=>d.getName(),'accessible'=>d.isAccessible(),'permissionable'=>d.isPermissionable(),'custom'=>d.isCustom()}); } System.debug(LoggingLevel.ERROR,'FIELDSET|'+n+'|'+JSON.serialize(values)); } } }
