Map<String,Schema.SObjectType> allTypes=Schema.getGlobalDescribe();Map<String,List<String>> cases=new Map<String,List<String>>{'GiftCommitmentSchedule'=>new List<String>{'GenerationalCohort'}};for(String obj:cases.keySet()){for(String field:cases.get(obj)){for(String method:new List<String>{'get','put','query'}){try{SObject r=allTypes.get(obj).newSObject();if(method=='get')r.get(field);else if(method=='put')r.put(field,null);else Database.query('SELECT '+field+' FROM '+obj+' LIMIT 1');System.debug('ROW~'+obj+'.'+field+'~'+method+'~accepted');}catch(Exception ex){System.debug('ROW~'+obj+'.'+field+'~'+method+'~'+ex.getTypeName()+': '+ex.getMessage());}}}}
