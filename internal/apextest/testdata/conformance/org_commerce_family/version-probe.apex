Map<String,Object> r=new Map<String,Object>();Map<String,Schema.SObjectType> gd=Schema.getGlobalDescribe();for(String n:new List<String>{'Account','PaymentCredit','PaymentCreditLinePayment','WebCartCredit','AbsentObject__c'}){r.put(n+'.describe',gd.containsKey(n));r.put(n+'.type',Type.forName('Schema.'+n)!=null);try{Database.countQuery('SELECT COUNT() FROM '+n);r.put(n+'.query',true);}catch(Exception e){r.put(n+'.query',e.getTypeName());}}System.debug('OBSERVED|capture|'+JSON.serialize(r));
