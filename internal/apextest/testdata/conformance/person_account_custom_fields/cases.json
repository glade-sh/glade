    "force-app/main/default/permissionsets/PersonFieldProbe.permissionset-meta.xml": "<PermissionSet xmlns=\"http://soap.sforce.com/2006/04/metadata\"><label>Person Field Probe</label><fieldPermissions><editable>true</editable><field>Contact.Note__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.OptIn__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Score__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>false</editable><field>Contact.Derived__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Sponsor__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Stage__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Memo__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>false</editable><field>Contact.Serial__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Secret__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>Contact.Anniversary__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>FieldVisit__c.Account__c</field><readable>true</readable></fieldPermissions><fieldPermissions><editable>true</editable><field>FieldVisit__c.Copied__c</field><readable>true</readable></fieldPermissions><objectPermissions><allowCreate>true</allowCreate><allowDelete>true</allowDelete><allowEdit>true</allowEdit><allowRead>true</allowRead><modifyAllRecords>true</modifyAllRecords><object>FieldVisit__c</object><viewAllRecords>true</viewAllRecords></objectPermissions></PermissionSet>"
  },
  "anonymous": "System.assert(false,'PERSON_FIELDS|'+PersonFieldProbe.observe());",
