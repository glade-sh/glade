    "force-app/main/default/flows/PersonFieldRead.flow-meta.xml": "<Flow xmlns=\"http://soap.sforce.com/2006/04/metadata\"><apiVersion>62.0</apiVersion>\n<assignments><name>Copy</name><label>Copy</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>Copied</assignToReference><operator>Assign</operator><value><elementReference>Person.Note__pc</elementReference></value></assignmentItems></assignments>\n<interviewLabel>Person Field Read</interviewLabel><label>Person Field Read</label><processType>AutoLaunchedFlow</processType><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Copy</targetReference></connector></start><status>Active</status>\n<variables><name>Person</name><dataType>SObject</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><objectType>Account</objectType></variables><variables><name>Copied</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables></Flow>",
    "force-app/main/default/flows/PersonFieldVisit.flow-meta.xml": "<Flow xmlns=\"http://soap.sforce.com/2006/04/metadata\"><apiVersion>62.0</apiVersion>\n<assignments><name>Copy</name><label>Copy</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Record.Copied__c</assignToReference><operator>Assign</operator><value><elementReference>$Record.Account__r.Note__pc</elementReference></value></assignmentItems></assignments>\n<interviewLabel>Person Field Visit</interviewLabel><label>Person Field Visit</label><processType>AutoLaunchedFlow</processType><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Copy</targetReference></connector><object>FieldVisit__c</object><recordTriggerType>Create</recordTriggerType><triggerType>RecordBeforeSave</triggerType></start><status>Active</status></Flow>",
    "force-app/main/default/classes/PersonFieldProbe.cls": "public class PersonFieldProbe {\n public static String observe() {\n  Map<String,Object> rows = new Map<String,Object>();\n  for (String key : new List<String>{'Note','OptIn','Score','Derived','Sponsor','Stage','Memo','Serial','Secret','Anniversary'}) {\n   Schema.DescribeFieldResult d = Schema.SObjectType.Account.fields.getMap().get(key+'__pc').getDescribe();\n   rows.put('describe_'+key,new List<Object>{d.getName(),String.valueOf(d.getType()),d.getLabel(),d.getLength(),d.getPrecision(),d.getScale(),d.isCreateable(),d.isUpdateable(),d.isCalculated(),d.isNillable(),d.isCustom(),d.getRelationshipName()});\n  }\n  rows.put('missing_describe',Schema.SObjectType.Account.fields.getMap().containsKey('Absent__pc'));\n  Id rt = [SELECT Id FROM RecordType WHERE SObjectType='Account' AND DeveloperName='PersonAccount' LIMIT 1].Id;\n  Account sponsor = new Account(Name='Garden Sponsor'); insert sponsor;\n  Account a = new Account(RecordTypeId=rt,LastName='Gardener',Note__pc='seed',Sponsor__pc=sponsor.Id); insert a;\n  Account r = [SELECT Note__pc,Sponsor__pc,Sponsor__pr.Name,PersonContactId,IsPersonAccount,RecordTypeId FROM Account WHERE Id=:a.Id];\n  rows.put('person_insert',new List<Object>{r.Note__pc,r.IsPersonAccount,r.RecordTypeId==rt,r.Sponsor__pr.Name});\n  Contact c = [SELECT Note__c,Sponsor__c FROM Contact WHERE Id=:r.PersonContactId];\n  rows.put('contact_after_insert',new List<Object>{c.Note__c,c.Sponsor__c==sponsor.Id});\n  a.Note__pc='account'; update a;\n  rows.put('contact_after_account_update',[SELECT Note__c FROM Contact WHERE Id=:c.Id].Note__c);\n  c.Note__c='contact'; update c;\n  rows.put('account_after_contact_update',[SELECT Note__pc FROM Account WHERE Id=:a.Id].Note__pc);\n  rows.put('filter',[SELECT COUNT() FROM Account WHERE Note__pc='contact']);\n  Id accountId = a.Id;\n  Account dyn = (Account)Database.query('SELECT Note__pc FROM Account WHERE Id = :accountId');\n  rows.put('dynamic_query',dyn.get('Note__pc'));\n  Account patch = new Account(Id=a.Id);patch.put('Note__pc','dynamic');update patch;\n  rows.put('dynamic_dml',[SELECT Note__c FROM Contact WHERE Id=:c.Id].Note__c);\n  Account flowInput = [SELECT Note__pc FROM Account WHERE Id=:a.Id];\n  Flow.Interview direct = Flow.Interview.createInterview('PersonFieldRead',new Map<String,Object>{'Person'=>flowInput});direct.start();\n  rows.put('flow_direct',direct.getVariableValue('Copied'));\n  FieldVisit__c visit = new FieldVisit__c(Name='Garden Visit',Account__c=a.Id);insert visit;\n  rows.put('flow_trigger',[SELECT Copied__c FROM FieldVisit__c WHERE Id=:visit.Id].Copied__c);\n  a.Note__pc=null;update a;\n  rows.put('contact_after_clear',[SELECT Note__c FROM Contact WHERE Id=:c.Id].Note__c);\n  rows.put('business_read',[SELECT Note__pc FROM Account WHERE Id=:sponsor.Id].Note__pc);\n  try { sponsor.Note__pc='business';update sponsor;rows.put('business_write','accepted'); } catch(DmlException e) {rows.put('business_write',String.valueOf(e.getDmlStatusCode(0)));}\n  try { a.put('Absent__pc','x');rows.put('missing_put','accepted'); } catch(Exception e) {rows.put('missing_put',e.getTypeName());}\n  try { Database.query('SELECT Absent__pc FROM Account');rows.put('missing_query','accepted'); } catch(Exception e) {rows.put('missing_query',e.getTypeName());}\n  return JSON.serialize(rows);\n }\n}",
    "force-app/main/default/classes/PersonFieldProbeTest.cls": "@IsTest private class PersonFieldProbeTest { @IsTest static void observeFields() { System.assert(false,'PERSON_FIELDS|'+PersonFieldProbe.observe()); } }",
