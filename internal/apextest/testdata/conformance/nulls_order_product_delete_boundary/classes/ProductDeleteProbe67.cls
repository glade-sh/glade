@IsTest private class ProductDeleteProbe67 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{Id pb=Test.getStandardPricebookId();update new Pricebook2(Id=pb,IsActive=true);Account a=new Account(Name='Synthetic');insert a;List<Product2> products=new List<Product2>();for(Integer i=0;i<3;i++)products.add(new Product2(Name='Synthetic '+i,IsActive=true));insert products;List<PricebookEntry> entries=new List<PricebookEntry>();for(Product2 p:products)entries.add(new PricebookEntry(Product2Id=p.Id,Pricebook2Id=pb,UnitPrice=1,IsActive=true));insert entries;Opportunity opp=new Opportunity(Name='Synthetic',StageName='Prospecting',CloseDate=Date.today(),AccountId=a.Id,Pricebook2Id=pb);insert opp;Order ord=new Order(AccountId=a.Id,Status='Draft',EffectiveDate=Date.today(),Pricebook2Id=pb);insert ord;List<OpportunityLineItem> olis=new List<OpportunityLineItem>();List<OrderItem> ois=new List<OrderItem>();for(PricebookEntry e:entries){olis.add(new OpportunityLineItem(OpportunityId=opp.Id,PricebookEntryId=e.Id,Quantity=1,UnitPrice=1));ois.add(new OrderItem(OrderId=ord.Id,PricebookEntryId=e.Id,Quantity=1,UnitPrice=1));}insert olis;insert ois;Database.DeleteResult ed=Database.delete(entries[0],false);out.put('entryDelete',ed.isSuccess()?'OK':String.valueOf(ed.getErrors()[0].getStatusCode())+':'+ed.getErrors()[0].getMessage().left(120));Database.DeleteResult pd=Database.delete(products[0],false);out.put('productDelete',pd.isSuccess()?'OK':String.valueOf(pd.getErrors()[0].getStatusCode())+':'+pd.getErrors()[0].getMessage().left(120));for(String objectName:new List<String>{'OpportunityLineItem','OrderItem'}){Set<Id> ids=new Set<Id>();if(objectName=='OpportunityLineItem')for(OpportunityLineItem x:olis)ids.add(x.Id);else for(OrderItem x:ois)ids.add(x.Id);for(String field:new List<String>{'Product2Id','PricebookEntryId'}){List<SObject> saved=Database.query('SELECT Id,'+field+' FROM '+objectName+' WHERE Id IN :ids');Set<String> vals=new Set<String>();Integer nc=0;for(SObject x:saved){Object v=x.get(field);if(v==null)nc++;else vals.add(String.valueOf(v));}Map<String,Object> obs=new Map<String,Object>{'count'=>saved.size(),'nulls'=>nc,'distinct'=>vals.size()};out.put(objectName+'.'+field,obs);List<String> sorted=new List<String>(vals);sorted.sort();if(nc>0&&sorted.size()>=2){Map<Id,String> labels=new Map<Id,String>();for(SObject x:saved){Object v=x.get(field);if(v==null&&!labels.values().contains('N'))labels.put((Id)x.get('Id'),'N');else if(v!=null&&String.valueOf(v)==sorted[0])labels.put((Id)x.get('Id'),'L');else if(v!=null&&String.valueOf(v)==sorted[1])labels.put((Id)x.get('Id'),'H');}Set<Id> chosen=labels.keySet();if(chosen.size()==3)for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){String order='';for(SObject x:Database.query('SELECT Id FROM '+objectName+' WHERE Id IN :chosen ORDER BY '+field+' '+tail))order+=labels.get((Id)x.get('Id'));obs.put(tail,order);}}}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|ProductDelete|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }