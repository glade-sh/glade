PermissionSet p=[SELECT Id FROM PermissionSet WHERE Name='Road174Grant'];Id uid=UserInfo.getUserId();List<Object> out=new List<Object>();try{AccessLevel scoped=AccessLevel.USER_MODE.withPermissionSetId(p.Id);String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';for(Integer i=0;i<2;i++){List<SObject> z=Database.query(q,scoped);SObject a=z[0].getSObject('UserRecordAccess');out.add(new List<Object>{a.get('HasAllAccess'),a.get('MaxAccessLevel')});}}catch(Exception e){out.add(e.getTypeName()+':'+e.getMessage());}System.debug('R6SCOPE|'+JSON.serialize(out));