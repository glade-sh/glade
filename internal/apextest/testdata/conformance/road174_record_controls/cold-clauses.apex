Id uid=UserInfo.getUserId();String f='UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel';Map<String,Object> out=new Map<String,Object>();for(String shape:new List<String>{'base','base','limit','unfiltered','reorder','single'}){String q='SELECT '+f+' FROM Order WHERE OwnerId = :uid WITH USER_MODE';if(shape=='limit')q+=' LIMIT 1';if(shape=='unfiltered')q='SELECT '+f+' FROM Order WITH USER_MODE LIMIT 1';if(shape=='reorder')q='SELECT UserRecordAccess.MaxAccessLevel,UserRecordAccess.HasAllAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasReadAccess FROM Order WHERE OwnerId = :uid WITH USER_MODE';if(shape=='single')q='SELECT UserRecordAccess.HasAllAccess FROM Order WITH USER_MODE LIMIT 1';try{List<SObject> z=Database.query(q);SObject a=z[0].getSObject('UserRecordAccess');out.put(shape+(out.containsKey(shape)?'2':''),JSON.serialize(new List<Object>{a.get('HasAllAccess'),shape=='single'?null:a.get('MaxAccessLevel')}));}catch(Exception e){out.put(shape,e.getTypeName());}}System.debug('R6CLAUSE|'+JSON.serialize(out));