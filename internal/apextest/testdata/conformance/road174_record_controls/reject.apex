Map<String,Object> out=new Map<String,Object>();for(String field:new List<String>{'UserId','Id','RecordId','NoSuchField','HasAllAccess'})for(String route:new List<String>{'clause','arg','binds'}){String key=field+'|'+route;String q='SELECT UserRecordAccess.'+field+' FROM Order LIMIT 1';try{List<SObject> z;if(route=='clause')z=Database.query('SELECT UserRecordAccess.'+field+' FROM Order WITH SYSTEM_MODE LIMIT 1');else if(route=='arg')z=Database.query(q,AccessLevel.SYSTEM_MODE);else z=Database.queryWithBinds(q,new Map<String,Object>(),AccessLevel.SYSTEM_MODE);out.put(key,'ok');}catch(Exception e){out.put(key,e.getTypeName());}}System.debug('R6REJECT|'+JSON.serialize(out));