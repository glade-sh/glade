Id uid=UserInfo.getUserId();String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<Object> out=new List<Object>();try{Database.queryWithBinds(q,new Map<String,Object>(),AccessLevel.USER_MODE);out.add('unexpected');}catch(Exception e){out.add(e.getTypeName());}List<SObject> b=Database.queryWithBinds(q,new Map<String,Object>{'uid'=>uid},AccessLevel.USER_MODE);out.add(b[0].getSObject('UserRecordAccess').get('HasAllAccess'));List<SObject> c=Database.queryWithBinds(q,new Map<String,Object>{'uid'=>uid},AccessLevel.USER_MODE);out.add(c[0].getSObject('UserRecordAccess').get('HasAllAccess'));System.debug('R6FAIL|'+JSON.serialize(out));