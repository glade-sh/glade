@IsTest private class PrivacyProbe62 { static Map<String,Object> attempt(){Map<String,Object> out=new Map<String,Object>();try{Schema.SObjectType pt=Schema.getGlobalDescribe().get('PrivacyPolicyDefinition');Schema.SObjectType ct=Schema.getGlobalDescribe().get('PrivacyRTBFRequest');List<SObject> parents=new List<SObject>();for(String name:new List<String>{'A','B'}){SObject x=pt.newSObject();x.put('DeveloperName','SyntheticPolicy'+name);x.put('MasterLabel','Synthetic Policy '+name);x.put('Status','inactive');x.put('Type','rtbf');x.put('RunFrequency','none');parents.add(x);}Database.SaveResult[] prs=Database.insert(parents,false,AccessLevel.SYSTEM_MODE);List<String> ps=new List<String>();for(Database.SaveResult r:prs)ps.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(250));out.put('parents',ps);if(!prs[0].isSuccess()||!prs[1].isSuccess())return out;System.runAs(new User(Id=UserInfo.getUserId())){List<SObject> requests=new List<SObject>();for(Integer i=0;i<3;i++){SObject x=ct.newSObject();x.put('JobRecord','{}');if(i>0)x.put('PolicyNameId',parents[i-1].get('Id'));requests.add(x);}Database.SaveResult[] rs=Database.insert(requests,false,AccessLevel.SYSTEM_MODE);List<String> cs=new List<String>();for(Database.SaveResult r:rs)cs.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode()));out.put('children',cs);if(rs[0].isSuccess()&&rs[1].isSuccess()&&rs[2].isSuccess()){Set<Id> ids=new Set<Id>{(Id)requests[0].get('Id'),(Id)requests[1].get('Id'),(Id)requests[2].get('Id')};String low=String.valueOf(parents[0].get('Id')).compareTo(String.valueOf(parents[1].get('Id')))<0?String.valueOf(parents[0].get('Id')):String.valueOf(parents[1].get('Id'));for(String suffix:new List<String>{'ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT PolicyNameId FROM PrivacyRTBFRequest WHERE Id IN :ids WITH SYSTEM_MODE ORDER BY PolicyNameId '+suffix);String order='';for(SObject x:found)order+=x.get('PolicyNameId')==null?'N':(String.valueOf(x.get('PolicyNameId'))==low?'L':'H');out.put(suffix,order);}}Database.SaveResult bad=Database.insert(ct.newSObject(),false,AccessLevel.SYSTEM_MODE);out.put('rejection',bad.isSuccess()?'OK':String.valueOf(bad.getErrors()[0].getStatusCode()));}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(160));}return out;} @IsTest static void probe(){System.assert(false,'CAPTURE|Privacy|'+JSON.serialize(new Map<String,Object>{'rows'=>attempt()}));} }