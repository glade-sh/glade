e(); if(d.getType()==Schema.DisplayType.REFERENCE) { unguarded.put('lastField',d.getName()); if(d.getRelationshipName().toLowerCase()=='what') { unguarded.put('found',d.getName()); break; } } } } catch(Exception e) { unguarded.put('exceptionType',e.getTypeName()); unguarded.put('exceptionMessage',e.getMessage()); }\nobserved.put('unguarded',unguarded);\nMap<String,Object> guarded=new Map<String,Object>{'found'=>null,'lastField'=>null,'exceptionType'=>null,'exceptionMessage'=>null};\ntry { for(Schema.SObjectField field:fields.values()) { Schema.DescribeFieldResult d=field.getDescribe(); if(d.getType()==Schema.DisplayType.REFERENCE) { guarded.put('lastField',d.getName()); String relationship=d.getRelationshipName(); if(relationship!=null && relationship.toLowerCase()=='what') { guarded.put('found',d.getName()); break; } } } } catch(Exception e) { guarded.put('exceptionType',e.getTypeName()); guarded.put('exceptionMessage',e.getMessage()); }\nobserved.put('guarded',guarded);\nSystem.assert(false,'NATIVE_RESULT|T1|'+JSON.serialize(observed));\n} }"
