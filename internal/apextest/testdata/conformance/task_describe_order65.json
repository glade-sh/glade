      "anonymous": "Map<String,Object> observed=new Map<String,Object>();\nMap<String,Schema.SObjectField> fields=Schema.getGlobalDescribe().get('Task').getDescribe().fields.getMap();\nMap<String,Object> tokens=new Map<String,Object>();\nfor(String name:new List<String>{'RecurrenceActivityId','AccountId','WhoId','WhatId'}) {\n Map<String,Object> token=new Map<String,Object>{'exists'=>fields.containsKey(name)};\n try { if(fields.containsKey(name)) { Schema.DescribeFieldResult d=fields.get(name).getDescribe(); List<String> targets=new List<String>(); for(Schema.SObjectType target:d.getReferenceTo()) targets.add(String.valueOf(target)); token.put('name',d.getName()); token.put('type',String.valueOf(d.getType())); token.put('relationshipName',d.getRelationshipName()); token.put('referenceTo',targets); }} catch(Exception e) { token.put('exceptionType',e.getTypeName()); token.put('exceptionMessage',e.getMessage()); }\n tokens.put(name,token);\n}\nobserved.put('tokens',tokens);\nList<Object> references=new List<Object>(); List<String> nullReferences=new List<String>();\ntry { for(Schema.SObjectField field:fields.values()) { Schema.DescribeFieldResult d=field.getDescribe(); if(d.getType()==Schema.DisplayType.REFERENCE) { references.add(new Map<String,Object>{'field'=>d.getName(),'relationshipName'=>d.getRelationshipName()}); if(d.getRelationshipName()==null) nullReferences.add(d.getName()); }} nullReferences.sort(); observed.put('references',references); observed.put('nullRefs',nullReferences); } catch(Exception e) { observed.put('sequenceExceptionType',e.getTypeName()); observed.put('sequenceExceptionMessage',e.getMessage()); }\nMap<String,Object> unguarded=new Map<String,Object>{'found'=>null,'lastField'=>null,'exceptionType'=>null,'exceptionMessage'=>null};\ntry { for(Schema.SObjectField field:fields.values()) { Schema.DescribeFieldResult d=field.getDescribe(); if(d.getType()==Schema.DisplayType.REFERENCE) { unguarded.put('lastField',d.getName()); if(d.getRelationshipName().toLowerCase()=='what') { unguarded.put('found',d.getName()); break; } } } } catch(Exception e) { unguarded.put('exceptionType',e.getTypeName()); unguarded.put('exceptionMessage',e.getMessage()); }\nobserved.put('unguarded',unguarded);\nMap<String,Object> guarded=new Map<String,Object>{'found'=>null,'lastField'=>null,'exceptionType'=>null,'exceptionMessage'=>null};\ntry { for(Schema.SObjectField field:fields.values()) { Schema.DescribeFieldResult d=field.getDescribe(); if(d.getType()==Schema.DisplayType.REFERENCE) { guarded.put('lastField',d.getName()); String relationship=d.getRelationshipName(); if(relationship!=null && relationship.toLowerCase()=='what') { guarded.put('found',d.getName()); break; } } } } catch(Exception e) { guarded.put('exceptionType',e.getTypeName()); guarded.put('exceptionMessage',e.getMessage()); }\nobserved.put('guarded',guarded);\nSystem.debug(LoggingLevel.ERROR,'NATIVE_RESULT|T1|'+JSON.serialize(observed));",
