@IsTest private class NullProbe62_00 { @IsTest static void probe(){ Map<String,Object> obs=new Map<String,Object>();try{List<Schema.Location> locations=new List<Schema.Location>();for(Integer i=0;i<3;i++)locations.add(new Schema.Location(Name='Synthetic '+i));insert as system locations;Schema.SObjectType addressType=Schema.getGlobalDescribe().get('Address');List<SObject> addresses=new List<SObject>();for(Integer i=1;i<3;i++){SObject address=addressType.newSObject();address.put('ParentId',locations[i].Id);address.put('Street','Synthetic '+i);addresses.add(address);}insert as system addresses;for(Integer i=1;i<3;i++)locations[i].VisitorAddressId=addresses[i-1].Id;update as system locations;Set<Id> ids=new Set<Id>();for(Schema.Location loc:locations)ids.add(loc.Id);List<Schema.Location> saved=[SELECT Id,VisitorAddressId FROM Location WHERE Id IN :ids];List<Id> parents=new List<Id>();for(Schema.Location loc:saved)if(loc.VisitorAddressId!=null)parents.add(loc.VisitorAddressId);parents.sort();if(saved.size()!=3||parents.size()!=2||parents[0]==parents[1])obs.put('skip','expected null and two saved addresses');else{Map<Id,String> labels=new Map<Id,String>();for(Schema.Location loc:saved)labels.put(loc.Id,loc.VisitorAddressId==null?'N':(loc.VisitorAddressId==parents[0]?'L':'H'));for(String tail:new List<String>{'NULLS FIRST','NULLS LAST','ASC','DESC','DESC NULLS LAST'}){List<String> ordered=new List<String>();for(Schema.Location loc:Database.query('SELECT Id FROM Location WHERE Id IN :ids ORDER BY VisitorAddressId '+tail))ordered.add(labels.get(loc.Id));obs.put(tail,String.join(ordered,''));}}}catch(Exception e){obs.put('skip','EXC '+e.getTypeName()+': '+e.getMessage().left(140));}System.assert(false,'CAPTURE|Location|'+JSON.serialize(new Map<String,Object>{'VisitorAddressId'=>obs})); }}
