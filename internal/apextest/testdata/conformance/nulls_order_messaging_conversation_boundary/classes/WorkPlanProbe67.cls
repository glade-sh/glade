@IsTest private class WorkPlanProbe67 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{Map<String,Schema.SObjectType> g=Schema.getGlobalDescribe();List<Id> sessions=NullCore67.parents(new List<Schema.SObjectType>{g.get('messagingsession')},1,0);List<Id> orders=NullCore67.parents(new List<Schema.SObjectType>{g.get('workorder')},2,0);out.put('sessionCount',sessions==null?0:sessions.size());if(sessions!=null&&!sessions.isEmpty()){List<SObject> messaging=Database.query('SELECT ConversationId FROM MessagingSession WHERE Id IN :sessions');Integer populated=0;for(SObject m:messaging)if(m.get('ConversationId')!=null)populated++;out.put('sessionsWithConversation',populated);out.put('conversationCount',Database.countQuery('SELECT COUNT() FROM Conversation'));}out.put('orderCount',orders==null?0:orders.size());if(sessions!=null&&!sessions.isEmpty()&&orders!=null&&orders.size()==2){Schema.SObjectType t=g.get('workplan');List<SObject> plans=new List<SObject>();for(Integer i=0;i<3;i++){SObject r=t.newSObject();r.put('Name','Synthetic '+i);r.put('ParentRecordId',i==0?sessions[0]:orders[i-1]);plans.add(r);}Database.SaveResult[] saves=Database.insert(plans,false,AccessLevel.SYSTEM_MODE);List<String> states=new List<String>();for(Database.SaveResult r:saves)states.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(130));out.put('inserts',states);if(saves[0].isSuccess()&&saves[1].isSuccess()&&saves[2].isSuccess()){Set<Id> ids=new Set<Id>{saves[0].getId(),saves[1].getId(),saves[2].getId()};List<SObject> saved=Database.query('SELECT Id,WorkOrderId FROM WorkPlan WHERE Id IN :ids');Set<String> vals=new Set<String>();Boolean nullSeen=false;for(SObject r:saved){Object v=r.get('WorkOrderId');if(v==null)nullSeen=true;else vals.add(String.valueOf(v));}out.put('savedNull',nullSeen);out.put('distinct',vals.size());List<String> sorted=new List<String>(vals);sorted.sort();if(nullSeen&&sorted.size()==2)for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT WorkOrderId FROM WorkPlan WHERE Id IN :ids ORDER BY WorkOrderId '+tail);String order='';for(SObject r:found){Object v=r.get('WorkOrderId');order+=v==null?'N':String.valueOf(v)==sorted[0]?'L':'H';}out.put(tail,order);}}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|WorkPlan|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }