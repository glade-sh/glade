Map<String,Object> payload=new Map<String,Object>();String step='init';try{String unitName='F16reject'; Integer outsideCount=[SELECT COUNT() FROM FlowCoreF16Record__c WHERE Unit__c != :unitName OR Unit__c = null];if(outsideCount!=0){payload.put('fixtureError','out-of-scope-records');}else{FlowCoreF16Record__c subject=new FlowCoreF16Record__c(Name='subject',Unit__c=unitName,Text__c='AlphaTail',Flag__c=true,Other__c='Yes',Gate__c=true,Money__c=10.75);step='subject-insert';insert subject;subject=[SELECT Id,Fired__c,Trace__c FROM FlowCoreF16Record__c WHERE Id=:subject.Id];payload.put('fired',subject.Fired__c);step='read';List<Object> effects=new List<Object>();for(FlowCoreF16Record__c effect:[SELECT Result__c,Other__c,Trace__c,Whole__c FROM FlowCoreF16Record__c WHERE Unit__c=:unitName AND Name='log' ORDER BY Whole__c,Result__c]){effects.add(new Map<String,Object>{'result'=>effect.Result__c,'other'=>effect.Other__c,'trace'=>effect.Trace__c,'seq'=>effect.Whole__c});}payload.put('effects',effects);subject=[SELECT Fired__c,Trace__c FROM FlowCoreF16Record__c WHERE Id=:subject.Id];payload.put('fired',subject.Fired__c);payload.put('trace',subject.Trace__c);}}catch(Exception e){payload.put('step',step);payload.put('exceptionType',e.getTypeName());payload.put('exceptionMessage',e.getMessage());}System.assert(false,'FLOW_CORE_RESULT|F16_006|'+JSON.serialize(payload));