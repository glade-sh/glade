User u=[SELECT Id FROM User WHERE LastName='Proof' AND IsActive=true LIMIT 1];Account a=new Account(Name='Synthetic access proof');insert a;insert new List<Order>{new Order(AccountId=a.Id,EffectiveDate=Date.today(),Status='Draft',Description='road174-other'),new Order(AccountId=a.Id,EffectiveDate=Date.today(),Status='Draft',OwnerId=u.Id,Description='road174-own')};System.debug('ROAD174DATA OK');
