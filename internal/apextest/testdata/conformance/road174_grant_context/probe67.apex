for(String mode:new List<String>{'default','SYSTEM','USER'}) {Map<String,Object> out=new Map<String,Object>();for(String own:new List<String>{'own','other'}){Id uid=UserInfo.getUserId();String cond=own=='own'?' = :uid':' != :uid';String suffix=mode=='default'?'':' WITH '+mode+'_MODE';try{List<SObject> q=Database.query('SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId'+cond+suffix);List<Object> v=new List<Object>();if(!q.isEmpty()){SObject a=q[0].getSObject('UserRecordAccess');for(String f:new List<String>{'HasReadAccess','HasEditAccess','HasDeleteAccess','HasTransferAccess','HasAllAccess','MaxAccessLevel'})v.add(a.get(f));}out.put(own,v);}catch(Exception e){out.put(own,'ERROR:'+e.getTypeName()+':'+e.getMessage());}}System.debug('R4|anonymous|'+mode+'|'+JSON.serialize(out));System.debug('R4|named|'+mode+'|'+Road174Context67.collect(mode));}try{Database.query('SELECT UserRecordAccess.UserId FROM Order LIMIT 1');System.debug('R4|reject|unexpected-success');}catch(Exception e){System.debug('R4|reject|'+e.getTypeName());}