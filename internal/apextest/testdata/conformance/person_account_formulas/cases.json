    "force-app/main/default/classes/PersonFormulaProbe.cls": "public class PersonFormulaProbe {\n public static String observe() {\n  Map<String,Object> rows = new Map<String,Object>();\n  rows.put('describe_formula',new List<Object>{Account.Derived__pc.getDescribe().getCalculatedFormula(),Contact.Derived__c.getDescribe().getCalculatedFormula()});\n  rows.put('describe_context',new List<Object>{Account.Context__pc.getDescribe().getCalculatedFormula(),Contact.Context__c.getDescribe().getCalculatedFormula()});\n  rows.put('describe_chained',new List<Object>{Account.Chained__pc.getDescribe().getCalculatedFormula(),Contact.Chained__c.getDescribe().getCalculatedFormula()});\n  Id rt = [SELECT Id FROM RecordType WHERE SObjectType='Account' AND DeveloperName='PersonAccount' LIMIT 1].Id;\n  Account sponsor = new Account(Name='Garden Sponsor',Note__c='parent'); insert sponsor;\n  Account a = new Account(RecordTypeId=rt,LastName='Gardener',Note__pc='seed',Sponsor__pc=sponsor.Id); insert a;\n  Account r = [SELECT Derived__pc,Context__pc,Chained__pc,PersonContactId FROM Account WHERE Id=:a.Id];\n  Contact c = [SELECT Derived__c,Context__c,Chained__c FROM Contact WHERE Id=:r.PersonContactId];\n  rows.put('insert',new List<Object>{r.Derived__pc,c.Derived__c,r.Context__pc,c.Context__c,r.Chained__pc,c.Chained__c});\n  Id accountId=a.Id;\n  rows.put('dynamic',((Account)Database.query('SELECT Derived__pc FROM Account WHERE Id=:accountId')).get('Derived__pc'));\n  rows.put('filter',[SELECT COUNT() FROM Account WHERE Derived__pc='seed-derived']);\n  Flow.Interview direct=Flow.Interview.createInterview('PersonFieldRead',new Map<String,Object>{'Person'=>r});direct.start();\n  rows.put('flow_direct',direct.getVariableValue('Copied'));\n  FieldVisit__c visit=new FieldVisit__c(Name='Formula Visit',Account__c=a.Id);insert visit;\n  rows.put('flow_trigger',[SELECT Copied__c FROM FieldVisit__c WHERE Id=:visit.Id].Copied__c);\n  a.Note__pc='account';update a;\n  rows.put('account_update',new List<Object>{[SELECT Derived__pc FROM Account WHERE Id=:a.Id].Derived__pc,[SELECT Derived__c FROM Contact WHERE Id=:c.Id].Derived__c});\n  c.Note__c='contact';update c;\n  rows.put('contact_update',new List<Object>{[SELECT Derived__pc FROM Account WHERE Id=:a.Id].Derived__pc,[SELECT Derived__c FROM Contact WHERE Id=:c.Id].Derived__c});\n  sponsor.Name='New Sponsor';update sponsor;\n  rows.put('related_update',new List<Object>{[SELECT Context__pc FROM Account WHERE Id=:a.Id].Context__pc,[SELECT Context__c FROM Contact WHERE Id=:c.Id].Context__c});\n  a.Note__pc=null;update a;\n  rows.put('clear',new List<Object>{[SELECT Derived__pc FROM Account WHERE Id=:a.Id].Derived__pc,[SELECT Derived__c FROM Contact WHERE Id=:c.Id].Derived__c});\n  Account business=[SELECT Derived__pc,Context__pc,Chained__pc FROM Account WHERE Id=:sponsor.Id];\n  rows.put('business',new List<Object>{business.Derived__pc,business.Context__pc,business.Chained__pc});\n  return JSON.serialize(rows);\n }\n}",
