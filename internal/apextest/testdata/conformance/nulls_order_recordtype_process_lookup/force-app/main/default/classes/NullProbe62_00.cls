@IsTest private class NullProbe62_00 { @IsTest static void probe(){ Map<String,Object> obs=new Map<String,Object>();try{List<RecordType> types=[SELECT Id,DeveloperName,BusinessProcessId FROM RecordType WHERE DeveloperName IN ('SyntheticNull','SyntheticAlpha','SyntheticBeta')];if(types.size()!=3){obs.put('skip','expected three synthetic record types');}else{List<Id> parents=new List<Id>();Set<Id> ids=new Set<Id>();for(RecordType row:types){ids.add(row.Id);if(row.BusinessProcessId!=null)parents.add(row.BusinessProcessId);}parents.sort();if(parents.size()!=2||parents[0]==parents[1])obs.put('skip','expected two distinct process parents and one null');else{Map<Id,String> labels=new Map<Id,String>();for(RecordType row:types)labels.put(row.Id,row.BusinessProcessId==null?'N':(row.BusinessProcessId==parents[0]?'L':'H'));for(String tail:new List<String>{'NULLS FIRST','NULLS LAST','ASC','DESC','DESC NULLS LAST'}){List<String> ordered=new List<String>();for(RecordType row:Database.query('SELECT Id FROM RecordType WHERE Id IN :ids ORDER BY BusinessProcessId '+tail))ordered.add(labels.get(row.Id));obs.put(tail,String.join(ordered,''));}}}}catch(Exception e){obs.put('skip','EXC '+e.getTypeName()+': '+e.getMessage().left(140));} System.assert(false,'CAPTURE|RecordType|'+JSON.serialize(new Map<String,Object>{'BusinessProcessId'=>obs})); }}
