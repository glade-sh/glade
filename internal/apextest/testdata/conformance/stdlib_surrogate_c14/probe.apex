// N11: UTF-16 unit semantics of String methods around a surrogate pair. s is
// U+1F600 followed by "abc" (5 UTF-16 units, 4 code points). The ledger row
// a2Surrogate is s.abbreviate(4,0). Results are emitted as UTF-16 unit lists so
// lone surrogates survive the debug log.
String s = String.fromCharArray(new List<Integer>{55357,56832,97,98,99});
String hiOnly = String.fromCharArray(new List<Integer>{55357});
String loOnly = String.fromCharArray(new List<Integer>{56832});
Map<String,Object> o = new Map<String,Object>();
Map<String,Object> u(String v) { return new Map<String,Object>{'n' => v.length(), 'u' => v.getChars()}; }
void put(String k, String v) { o.put(k, u(v)); }
void tryPut(String k, String stage, Object v) { o.put(k, v); }
put('s', s);
put('abbreviate_4_0', s.abbreviate(4,0));
put('abbreviate_5_0', s.abbreviate(5,0));
put('abbreviate_4', s.abbreviate(4));
put('ss_abbreviate_7_1', (s + s).abbreviate(7,1));
put('ss_abbreviate_7_5', (s + s + 'xyz').abbreviate(7,5));
put('substring_0_1', s.substring(0,1));
put('substring_1', s.substring(1));
put('substring_1_2', s.substring(1,2));
put('substring_0_2', s.substring(0,2));
put('left_1', s.left(1));
put('right_4', s.right(4));
put('mid_0_1', s.mid(0,1));
put('mid_1_1', s.mid(1,1));
put('mid_1_3', s.mid(1,3));
put('hi_only', hiOnly);
put('lo_only', loOnly);
String lone = s.substring(0,1);
put('rejoin', lone + s.substring(1));
o.put('rejoin_eq_s', (lone + s.substring(1)) == s);
o.put('rejoin_equals_s', (lone + s.substring(1)).equals(s));
o.put('lone_eq_hi', lone == hiOnly);
o.put('lone_equals_hi', lone.equals(hiOnly));
o.put('lone_eq_lo', lone == loOnly);
o.put('lone_hash_eq', lone.hashCode() == hiOnly.hashCode());
o.put('set_contains', new Set<String>{lone}.contains(hiOnly));
o.put('map_key', new Map<String,Integer>{lone => 1}.get(hiOnly));
o.put('s_indexOf_lone', s.indexOf(lone));
o.put('s_indexOf_lo', s.indexOf(loOnly));
o.put('s_contains_lone', s.contains(lone));
o.put('s_startsWith_lone', s.startsWith(lone));
o.put('s_endsWith_abc', s.endsWith('abc'));
o.put('s_lastIndexOf_lo', s.lastIndexOf(loOnly));
o.put('lone_codePointAt_0', lone.codePointAt(0));
o.put('s_charAt_0', s.charAt(0));
o.put('s_charAt_1', s.charAt(1));
o.put('s_codePointAt_0', s.codePointAt(0));
o.put('s_codePointAt_1', s.codePointAt(1));
o.put('s_codePointCount', s.codePointCount(0, 5));
o.put('lone_codePointCount', lone.codePointCount(0, 1));
o.put('s_offset_0_1', s.offsetByCodePoints(0, 1));
put('lone_upper', lone.toUpperCase());
put('lone_reverse', lone.reverse());
put('s_reverse', s.reverse());
put('lone_trim', lone.trim());
put('lone_escapeUnicode', lone.escapeUnicode());
put('s_escapeUnicode', s.escapeUnicode());
put('lone_json', JSON.serialize(lone));
put('s_json', JSON.serialize(s));
put('lone_json_roundtrip', (String) JSON.deserialize(JSON.serialize(lone), String.class));
o.put('lone_blob_size', Blob.valueOf(lone).size());
put('lone_blob_roundtrip', Blob.valueOf(lone).toString());
o.put('s_blob_size', Blob.valueOf(s).size());
put('lone_urlencode', EncodingUtil.urlEncode(lone, 'UTF-8'));
put('lone_base64', EncodingUtil.base64Encode(Blob.valueOf(lone)));
o.put('lone_isBlank', String.isBlank(lone));
o.put('lone_isEmpty', String.isEmpty(lone));
put('lone_concat_a', lone + 'a');
put('lone_repeat_2', lone.repeat(2));
put('lone_lo_concat', hiOnly + loOnly);
o.put('lone_lo_concat_eq_pair', (hiOnly + loOnly) == String.fromCharArray(new List<Integer>{55357,56832}));
put('lone_valueOf', String.valueOf(lone));
put('lone_format', String.format('{0}', new List<String>{lone}));
put('lone_replace', s.replace(lone, 'X'));
put('lone_split0', s.split(loOnly)[0]);
o.put('lone_split_n', s.split(loOnly).size());
put('s_removeStart_lone', s.removeStart(lone));
put('s_substringAfter_lone', s.substringAfter(lone));
put('s_substringBefore_lo', s.substringBefore(loOnly));
put('lone_center_3', lone.center(3));
put('lone_leftPad_3', lone.leftPad(3));
o.put('lone_compareTo_hi', lone.compareTo(hiOnly));
o.put('lone_compareTo_a', lone.compareTo('a'));
o.put('lone_compareTo_lo', hiOnly.compareTo(loOnly));
put('lone_normalizeSpace', lone.normalizeSpace());
put('lone_capitalize', lone.capitalize());
put('lone_swapCase', lone.swapCase());
o.put('lone_isAllLowerCase', lone.isAllLowerCase());
o.put('lone_isAlpha', lone.isAlpha());
o.put('lone_isAsciiPrintable', lone.isAsciiPrintable());
put('lone_deleteWhitespace', lone.deleteWhitespace());
put('lone_getLevenshtein_hi', String.valueOf(lone.getLevenshteinDistance(hiOnly)));
put('lone_abbreviate_4', (lone + 'abcdef').abbreviate(4));
put('s_truncate_substring_0_3', s.substring(0,3));
put('s_substring_2_4', s.substring(2,4));
o.put('s_length', s.length());
o.put('lone_length', lone.length());
System.debug('CAP|n11.surrogate|' + JSON.serialize(o));
