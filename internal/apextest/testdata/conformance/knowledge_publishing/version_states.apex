String tag=String.valueOf(Datetime.now().getTime());
Knowledge__kav a=new Knowledge__kav(Title='Unpublish '+tag,UrlName='unpublish-'+tag,Language='en_US');insert a;a=[SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:a.Id];Id parent=a.KnowledgeArticleId;KbManagement.PublishingService.publishArticle(parent,false);Id draft=KbManagement.PublishingService.editOnlineArticle(parent,true);
Knowledge__kav previous=[SELECT PublishStatus,VersionNumber,IsLatestVersion FROM Knowledge__kav WHERE Id=:a.Id];System.debug('B4:unpublished_original:'+previous.PublishStatus+':'+previous.VersionNumber+':'+previous.IsLatestVersion);
System.debug('B4:archived_status_query:'+ [SELECT COUNT() FROM Knowledge__kav WHERE PublishStatus='Archived' AND KnowledgeArticleId=:parent]);
Knowledge__kav b=new Knowledge__kav(Title='Replace '+tag,UrlName='replace-'+tag,Language='en_US');insert b;b=[SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:b.Id];Id parent2=b.KnowledgeArticleId;KbManagement.PublishingService.publishArticle(parent2,false);Id newDraft=KbManagement.PublishingService.editOnlineArticle(parent2,false);KbManagement.PublishingService.publishArticle(parent2,false);
System.debug('B4:replace_old:'+ [SELECT COUNT() FROM Knowledge__kav WHERE Id=:b.Id]);
try { System.debug('B4:replace_allrows:'+Database.countQuery('SELECT COUNT() FROM Knowledge__kav WHERE Id = \''+String.valueOf(b.Id)+'\' ALL ROWS')); } catch(Exception e) {System.debug('B4:replace_allrows:'+e.getTypeName());}
Knowledge__kav c=new Knowledge__kav(Title='Major '+tag,UrlName='major-'+tag,Language='en_US');insert c;c=[SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:c.Id];Id parent3=c.KnowledgeArticleId;KbManagement.PublishingService.publishArticle(parent3,true);Id newMajor=KbManagement.PublishingService.editOnlineArticle(parent3,false);KbManagement.PublishingService.publishArticle(parent3,true);
System.debug('B4:major_old_count:'+ [SELECT COUNT() FROM Knowledge__kav WHERE Id=:c.Id]);
Knowledge__kav current=[SELECT PublishStatus,VersionNumber FROM Knowledge__kav WHERE Id=:newMajor];System.debug('B4:major_current:'+current.PublishStatus+':'+current.VersionNumber);
try { List<SObject> deletedRows=Database.query('SELECT PublishStatus,IsDeleted FROM Knowledge__kav WHERE Id = \''+String.valueOf(b.Id)+'\' ALL ROWS');for(SObject row:deletedRows) System.debug('B4:replaced_old_fields:'+String.valueOf(row.get('PublishStatus'))+':'+String.valueOf(row.get('IsDeleted'))); } catch(Exception e) {System.debug('B4:replaced_old_fields:'+e.getTypeName());}
Knowledge__kav oldMajor=[SELECT PublishStatus,VersionNumber,IsLatestVersion FROM Knowledge__kav WHERE Id=:c.Id];System.debug('B4:major_original:'+oldMajor.PublishStatus+':'+oldMajor.VersionNumber+':'+oldMajor.IsLatestVersion);
