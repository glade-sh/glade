String tag=String.valueOf(Datetime.now().getTime()); Knowledge__kav article=new Knowledge__kav(Title='Category all rows '+tag,UrlName='category-all-rows-'+tag,Language='en_US'); insert article; Knowledge__DataCategorySelection sel=new Knowledge__DataCategorySelection(ParentId=article.Id,DataCategoryGroupName='Guides',DataCategoryName='General'); insert sel; delete sel; try { System.debug('B4:category_deleted_allrows:'+ [SELECT COUNT() FROM Knowledge__DataCategorySelection WHERE Id=:sel.Id ALL ROWS]); } catch(Exception e) { System.debug('B4:category_deleted_allrows:'+e.getTypeName()); }
