@IsTest private class FixedSearchAsyncTest {
    static String Q='FIND {Fixedasync} IN ALL FIELDS RETURNING Contact(Id,Department ORDER BY Department)';
    static Map<String,Contact> seed(){
        List<Contact> cs=new List<Contact>();
        for(String l:'A,B,C,D,E,F'.split(',')) cs.add(new Contact(LastName='Fixedasync '+l,Department=l));
        insert cs;
        Map<String,Contact> m=new Map<String,Contact>();
        for(Contact c:cs) m.put(c.Department,c);
        return m;
    }
    static void launch(String kind,Id t,String mode,String extra){
        if(kind=='q') System.enqueueJob(new FixedSearchJob(t,mode,Q,extra));
        else if(kind=='f') FixedSearchHelper.fut(t,mode,Q,extra);
        else Database.executeBatch(new FixedSearchBatch(t,mode,Q,extra));
    }
    static void done(Map<String,String> r,Id marker){
        r.put('asyncSaw',String.valueOf([SELECT Description FROM Account WHERE Id=:marker].Description));
        System.assert(false,'FU|'+JSON.serialize(r)+'|END');
    }
    static List<Id> three(Map<String,Contact> m){ return new List<Id>{m.get('C').Id,m.get('A').Id,m.get('E').Id}; }
    @IsTest static void a_q_base(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.setFixedSearchResults(three(m)); Test.startTest(); launch('q',mk.Id,'plain',''); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_none(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.startTest(); launch('q',mk.Id,'plain',''); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_setAfter(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.startTest(); launch('q',mk.Id,'plain',''); Test.setFixedSearchResults(new List<Id>{m.get('B').Id,m.get('D').Id}); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_clearAfter(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); List<Id> ids=three(m); Test.setFixedSearchResults(ids); Test.startTest(); launch('q',mk.Id,'plain',''); ids.clear(); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_addAfter(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); List<Id> ids=three(m); Test.setFixedSearchResults(ids); Test.startTest(); launch('q',mk.Id,'plain',''); ids.add(m.get('B').Id); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_setInside(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.startTest(); launch('q',mk.Id,'setF',String.valueOf(m.get('F').Id)); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_override(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.setFixedSearchResults(three(m)); Test.startTest(); launch('q',mk.Id,'setF',String.valueOf(m.get('F').Id)); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)); done(r,mk.Id); }
    @IsTest static void a_q_limits(){ Map<String,Contact> m=seed(); Account mk=new Account(Name='Fixedmarker'); insert mk; Map<String,String> r=new Map<String,String>(); Test.setFixedSearchResults(three(m)); Test.startTest(); FixedSearchHelper.obs(Q); FixedSearchHelper.obs(Q); launch('q',mk.Id,'plain',''); Test.stopTest(); r.put('syncAfter',FixedSearchHelper.obs(Q)+'@sosl='+Limits.getSoslQueries()); done(r,mk.Id); }
