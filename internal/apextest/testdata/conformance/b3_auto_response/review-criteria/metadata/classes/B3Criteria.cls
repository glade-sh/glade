public class B3Criteria { public static String run() { List<String> result=new List<String>(); List<String> companies=new List<String>{'Synthetic','Synthetic','Alternate','Missing'}; List<String> names=new List<String>{'First','Second','Third','Fourth'}; for(Integer i=0;i<4;i++){Lead l=new Lead(LastName=names[i],Company=companies[i],Email='capture'+i+'@example.invalid');Database.DMLOptions o=new Database.DMLOptions();o.EmailHeader.triggerAutoResponseEmail=true;Database.SaveResult r=Database.insert(l,o);List<Task> tasks=[SELECT Subject FROM Task WHERE WhoId=:l.Id];result.add(names[i]+'='+r.isSuccess()+','+(tasks.isEmpty()?'none':tasks[0].Subject));}return String.join(result,'|');} }