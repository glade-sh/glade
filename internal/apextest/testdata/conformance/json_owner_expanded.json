      "OwnedOwnerEnvelope65": "public class OwnedOwnerEnvelope65 {\n public static Map<String,Object> observe(String kind) {\n  String payload;\n  if(kind=='USER_ID_URL_NULL')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"FirstName\":\"Owned\",\"Id\":\"005000000000017\",\"attributes\":{\"type\":\"User\",\"url\":null}}}';\n  else if(kind=='USER_ID_URL_STRING')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"FirstName\":\"Owned\",\"Id\":\"005000000000017\",\"attributes\":{\"type\":\"User\",\"url\":\"/services/data/v65.0/sobjects/User/005000000000017\"}}}';\n  else if(kind=='NAME_ID_URL_NULL')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"Id\":\"005000000000017\",\"FirstName\":\"Owned\",\"attributes\":{\"type\":\"Name\",\"url\":null}}}';\n  else if(kind=='NAME_TYPE_ID_URL_NULL')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"Id\":\"005000000000017\",\"FirstName\":\"Owned\",\"Type\":\"User\",\"attributes\":{\"type\":\"Name\",\"url\":null}}}';\n  else if(kind=='NAME_TYPE_ID_URL_STRING')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"Id\":\"005000000000017\",\"FirstName\":\"Owned\",\"Type\":\"User\",\"attributes\":{\"type\":\"Name\",\"url\":\"/services/data/v65.0/sobjects/User/005000000000017\"}}}';\n  else if(kind=='USER_BARE_CONTROL')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":{\"FirstName\":\"Owned\",\"attributes\":{\"type\":\"User\"}}}';\n  else if(kind=='OWNER_NULL_CONTROL')payload='{\"attributes\":{\"type\":\"Case\"},\"Id\":\"500000000000017\",\"OwnerId\":\"005000000000017\",\"Subject\":\"Owned envelope\",\"Owner\":null}';\n  else return new Map<String,Object>{'fixtureError'=>'unknown-row','row'=>kind};\n  Map<String,Object> o=new Map<String,Object>{'row'=>kind,'phase'=>'deserialize'};\n  try {\n   Case record=(Case)JSON.deserialize(payload,Case.class);\n   o.put('phase','deserialized');\n   o.put('caseIdMatches',record.Id==Id.valueOf('500000000000017'));\n   o.put('ownerReferenceMatches',record.OwnerId==Id.valueOf('005000000000017'));\n   SObject owner=record.getSObject('Owner');\n   o.put('ownerNull',owner==null);\n   if(owner!=null){\n    try{o.put('ownerSObjectType',String.valueOf(owner.getSObjectType()));}catch(Exception e){o.put('ownerSObjectTypeException',new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()});}\n    try{Object ownerKey=owner.get('Id');o.put('ownerIdNull',ownerKey==null);o.put('ownerIdMatches',ownerKey==Id.valueOf('005000000000017'));}catch(Exception e){o.put('ownerIdException',new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()});}\n    try{o.put('firstName',owner.get('FirstName'));}catch(Exception e){o.put('firstError',new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()});}\n    try{o.put('typeField',owner.get('Type'));}catch(Exception e){o.put('typeError',new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()});}\n   }\n   try{Map<String,Object> roundtrip=(Map<String,Object>)JSON.deserializeUntyped(JSON.serialize(record));o.put('ownerJSON',roundtrip.get('Owner'));}catch(Exception e){o.put('serializedOwnerException',new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()});}\n   o.put('phase','complete');\n  }catch(Exception e){o.put('exceptionType',e.getTypeName());o.put('exceptionMessage',e.getMessage());}\n  return o;\n }\n}",
