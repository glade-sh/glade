@IsTest(SeeAllData=true) private class SourceProbe67 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{List<SObject> sources=Database.query('SELECT Id FROM ExternalDataSource LIMIT 2');out.put('sourceCount',sources.size());if(sources.size()==2){for(String name:new List<String>{'Product2','ContentVersion'}){Map<String,Object> obs=new Map<String,Object>();out.put(name,obs);try{Schema.SObjectType t=Schema.getGlobalDescribe().get(name);List<SObject> inputs=new List<SObject>();for(Integer i=0;i<3;i++){SObject x=t.newSObject();if(name=='Product2')x.put('Name','Synthetic '+i);else{x.put('Title','Synthetic '+i);if(i==0){x.put('PathOnClient','stub.txt');x.put('VersionData',Blob.valueOf('synthetic'));}else{x.put('ContentLocation','E');x.put('Origin','H');x.put('ContentUrl','https://example.invalid/synthetic');x.put('ExternalDocumentInfo1','synthetic'+i);}}if(i>0)x.put('ExternalDataSourceId',sources[i-1].get('Id'));inputs.add(x);}Database.SaveResult[] saves=Database.insert(inputs,false,AccessLevel.SYSTEM_MODE);List<String> states=new List<String>();for(Database.SaveResult r:saves)states.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(130));obs.put('inserts',states);if(saves[0].isSuccess()&&saves[1].isSuccess()&&saves[2].isSuccess()){Set<Id> ids=new Set<Id>{saves[0].getId(),saves[1].getId(),saves[2].getId()};List<SObject> saved=Database.query('SELECT ExternalDataSourceId FROM '+name+' WHERE Id IN :ids');Integer nullCount=0,pops=0;Set<String> vals=new Set<String>();for(SObject r:saved){if(r.get('ExternalDataSourceId')==null)nullCount++;else{pops++;vals.add(String.valueOf(r.get('ExternalDataSourceId')));}}obs.put('savedNulls',nullCount);obs.put('savedPopulated',pops);obs.put('distinct',vals.size());List<String> sorted=new List<String>(vals);sorted.sort();if(nullCount==1&&pops==2&&sorted.size()==2)for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT ExternalDataSourceId FROM '+name+' WHERE Id IN :ids ORDER BY ExternalDataSourceId '+tail);String order='';for(SObject r:found){Object v=r.get('ExternalDataSourceId');order+=v==null?'N':String.valueOf(v)==sorted[0]?'L':'H';}obs.put(tail,order);}}}catch(Exception e){obs.put('exceptionType',e.getTypeName());obs.put('exceptionMessage',e.getMessage().left(150));}}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|Source|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }