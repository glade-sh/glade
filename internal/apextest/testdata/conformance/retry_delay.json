        "force-app/main/default/classes/RetryDelayProbe.cls": "public class RetryDelayProbe {\n public static void mark(String label,String stage){\n  Object delay;try{delay=System.AsyncInfo.getMinimumQueueableDelayInMinutes();}catch(Exception e){delay=new Map<String,Object>{'type'=>e.getTypeName(),'message'=>e.getMessage()};}\n  insert new Account(Name='delay-probe-'+label+'-'+stage,Description=JSON.serialize(delay));\n }\n public class Work implements Queueable,Finalizer {\n  String label;Integer phase;AsyncOptions baton;\n  public Work(String label,Integer phase,AsyncOptions baton){this.label=label;this.phase=phase;this.baton=baton;}\n  public void execute(QueueableContext c){mark(label,'body'+phase);System.attachFinalizer(this);}\n  public void execute(FinalizerContext c){\n   mark(label,'finalizer'+phase);\n   if(phase==0){AsyncOptions retry=new AsyncOptions();retry.MaximumQueueableStackDepth=8;retry.MinimumQueueableDelayInMinutes=2;AsyncOptions clean=new AsyncOptions();clean.MaximumQueueableStackDepth=8;System.enqueueJob(new Work(label,1,clean),retry);}\n   else if(phase==1)System.enqueueJob(new Work(label,2,baton),baton);\n  }\n }\n public class Leaf implements Queueable {String label;public Leaf(String label){this.label=label;}public void execute(QueueableContext c){mark(label,'body');}}\n public static void start(String label,String mode){\n  AsyncOptions o=new AsyncOptions();o.MaximumQueueableStackDepth=5;\n  if(mode=='chain')System.enqueueJob(new Work(label,0,o),o);\n  else if(mode=='optionZero'){o.MinimumQueueableDelayInMinutes=0;System.enqueueJob(new Leaf(label),o);}\n  else if(mode=='optionNull'){o.MinimumQueueableDelayInMinutes=null;System.enqueueJob(new Leaf(label),o);}\n  else if(mode=='integerZero')System.enqueueJob(new Leaf(label),0);\n }\n public static Map<String,Object> report(String label){String prefix='delay-probe-'+label+'-';String pattern=prefix+'%';Map<String,Object> r=new Map<String,Object>();for(Account row:[SELECT Name,Description FROM Account WHERE Name LIKE :pattern])r.put(row.Name.substring(prefix.length()),JSON.deserializeUntyped(row.Description));return r;}\n}\n",
