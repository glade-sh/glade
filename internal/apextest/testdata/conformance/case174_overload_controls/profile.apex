User u=[SELECT ProfileId FROM User WHERE LastName='Proof' AND IsActive=true LIMIT 1];for(ObjectPermissions p:[SELECT SobjectType,PermissionsRead,PermissionsCreate,PermissionsEdit,PermissionsDelete,PermissionsViewAllRecords,PermissionsModifyAllRecords FROM ObjectPermissions WHERE Parent.IsOwnedByProfile=true AND Parent.ProfileId=:u.ProfileId AND SobjectType IN ('Order','Account')])System.debug('R5PROFILE|'+JSON.serialize(p));