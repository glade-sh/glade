
  Map<String,Object> out=new Map<String,Object>(); Id uid=UserInfo.getUserId();
  String fields='UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel';
  Map<String,String> shapes=new Map<String,String>{'base'=>'SELECT '+fields+' FROM Order WHERE OwnerId = :uid','reorder'=>'SELECT UserRecordAccess.MaxAccessLevel,UserRecordAccess.HasAllAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasReadAccess FROM Order WHERE OwnerId = :uid','limit'=>'SELECT '+fields+' FROM Order WHERE OwnerId = :uid LIMIT 1','predicate'=>'SELECT '+fields+' FROM Order WHERE Description != null LIMIT 1','unfiltered'=>'SELECT '+fields+' FROM Order LIMIT 1','single'=>'SELECT UserRecordAccess.HasAllAccess FROM Order LIMIT 1','plain'=>'SELECT Id FROM Order LIMIT 1','invalid'=>'SELECT UserRecordAccess.UserId FROM Order LIMIT 1'};
  for(String shape:shapes.keySet())for(String mode:new List<String>{'USER','SYSTEM'})for(String route:new List<String>{'clause','arg','binds'}){
   String q=shapes.get(shape),key=shape+'|'+mode+'|'+route; AccessLevel al=mode=='USER'?AccessLevel.USER_MODE:AccessLevel.SYSTEM_MODE;
   try{List<SObject> rows; if(route=='clause'){q=q.replace(' LIMIT 1','')+' WITH '+mode+'_MODE'+(shapes.get(shape).contains(' LIMIT 1')?' LIMIT 1':'');rows=Database.query(q);}else if(route=='arg'){rows=Database.query(q,al);}else{rows=Database.queryWithBinds(q,new Map<String,Object>{'uid'=>uid},al);} if(rows.isEmpty()){out.put(key,'empty');}else if(shape=='plain'){out.put(key,'ok');}else{SObject a=rows[0].getSObject('UserRecordAccess');out.put(key,shape=='single'?String.valueOf(a.get('HasAllAccess')):JSON.serialize(new List<Object>{a.get('HasAllAccess'),a.get('MaxAccessLevel')}));}}
   catch(Exception e){out.put(key,'ERROR:'+e.getTypeName());}
  }System.debug('R5ANON|'+JSON.serialize(out));
