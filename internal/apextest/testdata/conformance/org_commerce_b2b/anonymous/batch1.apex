Map<String,Object> result=new Map<String,Object>();Map<String,Schema.SObjectType> gd=Schema.getGlobalDescribe();for(String n:new List<String>{'LocationShippingCarrierMethod','LocationShippingCarrierMethodFeed','LocationShippingCarrierMethodHistory','LocationShippingCarrierMethodShare','PaymentCredit','PaymentCreditLinePayment','PaymentCreditTransaction','PickTicket','PickTicketAssignment','PickTicketFeed','PickTicketProduct','PickTicketProductFeed','PickTicketShare','ProductAttribute','ProductAttributeSet','ProductAttributeSetItem','ProductAttributeSetProduct','ProductCatalog','ProductCatalogFeed','ProductCatalogHistory','ProductCatalogShare','ProductCategory','ProductCategoryFeed','ProductCategoryHistory','ProductCategoryProduct','ProductCategoryProductHistory','ProductRelatedComponent','ProductRelationshipType','Promotion','PromotionFeed','PromotionHistory','PromotionLineItemRule','PromotionLineItemRuleShare','PromotionMarketSegment','PromotionMarketSegmentFeed','Account','AbsentObject__c'}){result.put(n+'.describe',gd.containsKey(n));result.put(n+'.type',Type.forName('Schema.'+n)!=null);try{Database.countQuery('SELECT COUNT() FROM '+n);result.put(n+'.query',true);}catch(Exception e){result.put(n+'.query',e.getTypeName());}}System.debug('OBSERVED|capture|'+JSON.serialize(result));
