Map<String,Object> result=new Map<String,Object>();Map<String,Schema.SObjectType> gd=Schema.getGlobalDescribe();for(String n:new List<String>{'BuyerGroup','BuyerGroupFeed','BuyerGroupHistory','BuyerGroupShare','CartCheckoutSession','CartDeliveryGroup','CartDeliveryGroupMethod','CartItem','CartItemPriceAdjustment','CartRelatedItem','CartTax','CartValidationOutput','Coupon','CouponCodeRedemption','CouponCodeRedemptionShare','CouponFeed','CouponHistory','CouponShare','DeliveryEstimationSetup','DeliveryEstimationSetupFeed','DeliveryEstimationSetupHistory','DeliveryEstimationSetupShare','FulfillmentLineRel','FulfillmentOrder','FulfillmentOrderFeed','FulfillmentOrderItemAdjustment','FulfillmentOrderItemAdjustmentFeed','FulfillmentOrderItemTax','FulfillmentOrderItemTaxFeed','FulfillmentOrderLineItem','FulfillmentOrderLineItemFeed','FulfillmentOrderShare','InventoryItemReservation','InventoryReservation','InventoryReservationShare','Account','AbsentObject__c'}){result.put(n+'.describe',gd.containsKey(n));result.put(n+'.type',Type.forName('Schema.'+n)!=null);try{Database.countQuery('SELECT COUNT() FROM '+n);result.put(n+'.query',true);}catch(Exception e){result.put(n+'.query',e.getTypeName());}}System.debug('OBSERVED|capture|'+JSON.serialize(result));
