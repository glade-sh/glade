Map<String,String> obs=new Map<String,String>();for(String field:new List<String>{'FlowDefaultAccountId','FlowDefaultProfileId'}){for(String route:new List<String>{'get','put'}){AuthProvider source=new AuthProvider();try{if(route=='get')source.get(field);else source.put(field,null);obs.put(field+'/'+route,'ok');}catch(Exception e){obs.put(field+'/'+route,e.getTypeName()+': '+e.getMessage());}}}System.debug('CAPTURE|'+JSON.serialize(obs));
