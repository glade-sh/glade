trigger SyntheticRefire on SyntheticItem__c (before update, after update) { if(Trigger.isBefore){SyntheticGuard.beforeBatches.add(Trigger.new.size());for(SyntheticItem__c x:Trigger.new){x.Unit__c='before-'+x.Unit__c;if(x.Name==SyntheticGuard.rejectName)x.addError('synthetic trigger rejection');}}else{ SyntheticGuard.batches.add(Trigger.new.size());for(SyntheticItem__c x:Trigger.new) SyntheticGuard.events.add(x.Name+':'+Trigger.oldMap.get(x.Id).Unit__c+'>'+x.Unit__c); if(!SyntheticGuard.busy){ SyntheticGuard.busy=true; String target=SyntheticGuard.targetName;List<SyntheticItem__c> others=[SELECT Id,Unit__c FROM SyntheticItem__c WHERE Name=:target WITH SYSTEM_MODE]; if(!others.isEmpty()){others[0].Unit__c='touched';Database.SaveResult r=Database.update(others[0],false,AccessLevel.SYSTEM_MODE);SyntheticGuard.outcomes.add(r.isSuccess()?'success':String.valueOf(r.getErrors()[0].getStatusCode()));} SyntheticGuard.busy=false; }} }