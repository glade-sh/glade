    public static Map<String,Object> observed;
    public static String entry;
    public static Set<Id> seededIds;
    public static void seed() {
        List<Contact> records = new List<Contact>{
            new Contact(LastName='Temporal probe', Birthdate=Date.newInstance(2020,1,1), ObservedAt__c=Datetime.newInstanceGmt(2020,1,1,8,0,0)),
            new Contact(LastName='Temporal probe', Birthdate=Date.newInstance(2020,1,2), ObservedAt__c=Datetime.newInstanceGmt(2020,1,1,8,1,0)),
            new Contact(LastName='Temporal probe')
        };
        insert records;
        seededIds = new Map<Id,Contact>(records).keySet();
    }
    public static Map<String,Object> run(String selectedEntry) {
        seed();
        entry = selectedEntry;
        if (Test.isRunningTest()) { Test.setFixedSearchResults(new List<Id>(seededIds)); }
        if (entry == 'direct') { observed = observe(); }
        else if (entry == 'trigger' || entry == 'triggerFlow') { insert new Account(Name='Temporal dispatch'); }
        else if (entry == 'flow') {
            Flow.Interview interview = Flow.Interview.createInterview('TemporalQueryParent',new Map<String,Object>());
            interview.start();
        }
        return observed;
    }
