Map<String,Object> payload=new Map<String,Object>();try{FProbeFr__c top=new FProbeFr__c(Name='top',Type__c=null);insert top;FProbeFr__c grand=new FProbeFr__c(Name='grand',Type__c=null,Parent__c=top.Id);insert grand;FProbeFr__c parent=new FProbeFr__c(Name='parent',Type__c=null,Parent__c=grand.Id,Flag__c=false);insert parent;FProbeFr__c subject=new FProbeFr__c(Name='subject',Text__c=null,Pick__c=null,Type__c=null,Flag__c=false);List<Object> snapshots=new List<Object>();payload.put('snapshots',snapshots);insert subject;subject=[SELECT Result__c,Field__c,Formula__c,Pick__c FROM FProbeFr__c WHERE Id=:subject.Id];snapshots.add(new Map<String,Object>{'phase'=>'insert','result'=>subject.Result__c,'field'=>subject.Field__c,'formula'=>subject.Formula__c,'picklist'=>subject.Pick__c});subject.Result__c=null;subject.Text__c='Alpha';subject.Pick__c='Alpha';subject.Flag__c=true;subject.Parent__c=parent.Id;update subject;subject=[SELECT Result__c,Field__c,Formula__c,Pick__c FROM FProbeFr__c WHERE Id=:subject.Id];snapshots.add(new Map<String,Object>{'phase'=>'update','result'=>subject.Result__c,'field'=>subject.Field__c,'formula'=>subject.Formula__c,'picklist'=>subject.Pick__c});payload.put('snapshots',snapshots);}catch(Exception e){payload.put('exceptionType',e.getTypeName());payload.put('exceptionMessage',e.getMessage());}System.assert(false,'C126_RESULT|FR15_NULL|'+JSON.serialize(payload));