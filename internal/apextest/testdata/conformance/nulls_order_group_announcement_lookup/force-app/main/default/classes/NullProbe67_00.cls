@IsTest private class NullProbe67_00 { @IsTest static void probe(){Map<String,Object> obs=new Map<String,Object>();try{List<CollaborationGroup> groups=new List<CollaborationGroup>();for(Integer i=0;i<3;i++)groups.add(new CollaborationGroup(Name='Synthetic '+i,CollaborationType='Public'));insert as system groups;List<FeedItem> posts=new List<FeedItem>();for(Integer i=1;i<3;i++)posts.add(new FeedItem(ParentId=groups[i].Id,Body='Synthetic announcement '+i,Type='AdvancedTextPost'));insert as system posts;List<Announcement> announcements=new List<Announcement>();for(FeedItem post:posts)announcements.add(new Announcement(FeedItemId=post.Id,ExpirationDate=System.now().addDays(7)));insert as system announcements;for(Integer i=1;i<3;i++)groups[i].AnnouncementId=announcements[i-1].Id;update as system groups;Set<Id> ids=new Set<Id>();for(CollaborationGroup grp:groups)ids.add(grp.Id);List<CollaborationGroup> saved=[SELECT Id,AnnouncementId FROM CollaborationGroup WHERE Id IN :ids];List<Id> parents=new List<Id>();for(CollaborationGroup grp:saved)if(grp.AnnouncementId!=null)parents.add(grp.AnnouncementId);parents.sort();if(saved.size()!=3||parents.size()!=2||parents[0]==parents[1])obs.put('skip','expected null and two saved announcements');else{Map<Id,String> labels=new Map<Id,String>();for(CollaborationGroup grp:saved)labels.put(grp.Id,grp.AnnouncementId==null?'N':(grp.AnnouncementId==parents[0]?'L':'H'));for(String tail:new List<String>{'NULLS FIRST','NULLS LAST','ASC','DESC','DESC NULLS LAST'}){List<String> ordered=new List<String>();for(CollaborationGroup grp:Database.query('SELECT Id FROM CollaborationGroup WHERE Id IN :ids ORDER BY AnnouncementId '+tail))ordered.add(labels.get(grp.Id));obs.put(tail,String.join(ordered,''));}}}catch(Exception e){obs.put('skip','EXC '+e.getTypeName()+': '+e.getMessage().left(200));}System.assert(false,'CAPTURE|CollaborationGroup|'+JSON.serialize(new Map<String,Object>{'AnnouncementId'=>obs})); }}
