@IsTest(SeeAllData=true) private class OutboundProbe62 { @IsTest static void probe(){ Map<String,Object> out=new Map<String,Object>();try{Schema.SObjectType typ=Schema.getGlobalDescribe().get('OutboundEngmtContentRsrc');if(typ==null||!typ.getDescribe().fields.getMap().containsKey('ResourceReferenceRecordId')){out.put('availability','absent');}else{List<SObject> templates=Database.query('SELECT Id FROM OutboundEngagementTmplView LIMIT 1');out.put('templateCount',templates.size());if(!templates.isEmpty()){List<Campaign> ps=new List<Campaign>{new Campaign(Name='Synthetic A'),new Campaign(Name='Synthetic B')};insert ps;List<SObject> rs=new List<SObject>();for(Integer i=0;i<3;i++){SObject r=typ.newSObject();r.put('Name','Synthetic '+i);r.put('OutboundEngagementTmplViewId',templates[0].get('Id'));if(i>0)r.put('ResourceReferenceRecordId',ps[i-1].Id);rs.add(r);}Database.SaveResult[] saves=Database.insert(rs,false,AccessLevel.SYSTEM_MODE);List<String> states=new List<String>();for(Database.SaveResult r:saves)states.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(120));out.put('inserts',states);if(saves[0].isSuccess()&&saves[1].isSuccess()&&saves[2].isSuccess()){Set<Id> ids=new Set<Id>{saves[0].getId(),saves[1].getId(),saves[2].getId()};List<SObject> saved=Database.query('SELECT Id,ResourceReferenceRecordId FROM OutboundEngmtContentRsrc WHERE Id IN :ids');Set<String> vals=new Set<String>();Boolean nullSeen=false;for(SObject r:saved){Object v=r.get('ResourceReferenceRecordId');if(v==null)nullSeen=true;else vals.add(String.valueOf(v));}out.put('savedNull',nullSeen);out.put('distinct',vals.size());List<String> sorted=new List<String>(vals);sorted.sort();for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT ResourceReferenceRecordId FROM OutboundEngmtContentRsrc WHERE Id IN :ids ORDER BY ResourceReferenceRecordId '+tail);String order='';for(SObject r:found){Object v=r.get('ResourceReferenceRecordId');order+=v==null?'N':String.valueOf(v)==sorted[0]?'L':'H';}out.put(tail,order);}}}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|Outbound|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }