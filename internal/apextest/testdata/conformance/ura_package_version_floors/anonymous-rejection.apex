Account a=new Account(Name='Synthetic');insert a;Order o=new Order(AccountId=a.Id,EffectiveDate=Date.today(),Status='Draft');insert o;Id uid=UserInfo.getUserId();Id rid=o.Id;Map<String,Object> p=new Map<String,Object>();try{List<UserRecordAccess> rows=[SELECT HasReadAccess,HasEditAccess,HasDeleteAccess,HasTransferAccess,HasAllAccess,MaxAccessLevel FROM UserRecordAccess WHERE UserId=:uid AND RecordId=:rid];p.put('count',rows.size());if(!rows.isEmpty()){List<Object> values=new List<Object>();for(String f:new List<String>{'HasReadAccess','HasEditAccess','HasDeleteAccess','HasTransferAccess','HasAllAccess','MaxAccessLevel'})values.add(rows[0].get(f));p.put('access',values);}}catch(Exception e){p.put('error',e.getTypeName()+':'+e.getMessage());}System.debug('URAANON|'+JSON.serialize(p));
