Map<String,Object> result=new Map<String,Object>();for(String n:new List<String>{'Account','BuyerGroup','CartItem','CartTax','AbsentObject__c'}){result.put(n+'.describe',Schema.getGlobalDescribe().containsKey(n));result.put(n+'.type',Type.forName('Schema.'+n)!=null);try{Database.countQuery('SELECT COUNT() FROM '+n);result.put(n+'.query',true);}catch(Exception e){result.put(n+'.query',e.getTypeName());}}System.debug('OBSERVED|capture|'+JSON.serialize(result));
