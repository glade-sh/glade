User u=[SELECT Id FROM User WHERE LastName='Synthetic App 0' LIMIT 1];insert new List<UserAppInfo>{new UserAppInfo(UserId=u.Id,FormFactor='Small',AppDefinitionId='REPLACE_WITH_SYNTHETIC_APP_ID'),new UserAppInfo(UserId=u.Id,FormFactor='Medium',AppDefinitionId='REPLACE_WITH_SYNTHETIC_APP_ID'),new UserAppInfo(UserId=u.Id,FormFactor='Large',AppDefinitionId='REPLACE_WITH_SYNTHETIC_APP_ID')};System.debug('SETUP_DONE');