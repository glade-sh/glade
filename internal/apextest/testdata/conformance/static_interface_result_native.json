  "sources": {
    "OwnedInstanceSearcher": "public class OwnedInstanceSearcher implements OwnedSearchContract {\n public static Integer calls=0;\n public Object execute(Object term,Map<String,Object> options) {\n  calls++;\n  List<String> fields=(List<String>)options.get('fields');\n  return new Account(Name='instance'+':'+(String)term,Description=String.valueOf((Id)options.get('recordId'))+':'+String.join(fields,','));\n }\n}\n",
    "OwnedStaticSearchObserver": "public class OwnedStaticSearchObserver {\n public static String observe(String row) {\n  OwnedPrimarySearcher.calls=0;OwnedOtherSearcher.calls=0;OwnedInstanceSearcher.calls=0;\n  Map<String,Object> options=new Map<String,Object>{'recordId'=>UserInfo.getUserId(),'fields'=>new List<String>{'Name','Description'}};\n  Map<String,Object> seen=new Map<String,Object>();Object returned;String term='';\n  try {\n   if(row=='SI01'||row=='SI02'||row=='SI03') {\n    String name=row=='SI01'?'OwnedPrimarySearcher':(row=='SI02'?'OwnedOtherSearcher':'OwnedInstanceSearcher');\n    Object raw=Type.forName(name).newInstance();OwnedSearchContract receiver=(OwnedSearchContract)raw;\n    returned=receiver.execute(term,options);\n   }\n   if(row=='SI04') {Object raw=new OwnedNotSearcher();OwnedSearchContract receiver=(OwnedSearchContract)raw;returned=receiver.execute(term,options);}\n   if(row=='SI05') {OwnedSearchContract receiver=null;returned=receiver.execute(term,options);}\n   if(row=='SI06') returned=OwnedPrimarySearcher.execute(term,options);\n   seen.put('outcome','returned');\n   seen.put('account',returned instanceof Account);\n   if(returned instanceof Account) {\n    Account item=(Account)returned;seen.put('name',item.Name);\n    seen.put('arguments',item.Description==String.valueOf(UserInfo.getUserId())+':Name,Description');\n   }\n  } catch(Exception e) {seen.put('outcome','threw');seen.put('exception',e.getTypeName());}\n  seen.put('primaryCalls',OwnedPrimarySearcher.calls);seen.put('otherCalls',OwnedOtherSearcher.calls);seen.put('instanceCalls',OwnedInstanceSearcher.calls);\n  seen.put('optionsSize',options.size());seen.put('fieldsSize',((List<String>)options.get('fields')).size());\n  return JSON.serialize(seen);\n }\n}\n",
    "OwnedSearchContract": "public interface OwnedSearchContract { Object execute(Object term,Map<String,Object> options); }\n",
    "OwnedPrimarySearcher": "public class OwnedPrimarySearcher implements OwnedSearchContract {\n public static Integer calls=0;\n public static Object execute(Object term,Map<String,Object> options) {\n  calls++;\n  List<String> fields=(List<String>)options.get('fields');\n  return new Account(Name='primary'+':'+(String)term,Description=String.valueOf((Id)options.get('recordId'))+':'+String.join(fields,','));\n }\n}\n",
    "OwnedOtherSearcher": "public class OwnedOtherSearcher implements OwnedSearchContract {\n public static Integer calls=0;\n public static Object execute(Object term,Map<String,Object> options) {\n  calls++;\n  List<String> fields=(List<String>)options.get('fields');\n  return new Account(Name='other'+':'+(String)term,Description=String.valueOf((Id)options.get('recordId'))+':'+String.join(fields,','));\n }\n}\n",
    "OwnedNotSearcher": "public class OwnedNotSearcher {}\n",
    "OwnedStaticSearchTest": "@IsTest private class OwnedStaticSearchTest {\n @IsTest static void si01(){System.assert(false,'STATIC_SEARCH|SI01|'+OwnedStaticSearchObserver.observe('SI01'));}\n @IsTest static void si02(){System.assert(false,'STATIC_SEARCH|SI02|'+OwnedStaticSearchObserver.observe('SI02'));}\n @IsTest static void si03(){System.assert(false,'STATIC_SEARCH|SI03|'+OwnedStaticSearchObserver.observe('SI03'));}\n @IsTest static void si04(){System.assert(false,'STATIC_SEARCH|SI04|'+OwnedStaticSearchObserver.observe('SI04'));}\n @IsTest static void si05(){System.assert(false,'STATIC_SEARCH|SI05|'+OwnedStaticSearchObserver.observe('SI05'));}\n @IsTest static void si06(){System.assert(false,'STATIC_SEARCH|SI06|'+OwnedStaticSearchObserver.observe('SI06'));}\n}\n"
  },
