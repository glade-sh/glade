User u=[SELECT Id FROM User WHERE LastName='Synthetic App 0' LIMIT 1];List<AppDefinition> apps=[SELECT DurableId FROM AppDefinition LIMIT 2];Id a=Id.valueOf(apps[0].DurableId);Id b=Id.valueOf(apps[1].DurableId);if(a==null||b==null||a==b)System.assert(false,'invalid distinct app parents');insert new List<UserAppInfo>{new UserAppInfo(UserId=u.Id,FormFactor='Small',AppDefinitionId=a),new UserAppInfo(UserId=u.Id,FormFactor='Medium',AppDefinitionId=b)};System.debug('SETUP_DONE');
