List<User> us=new List<User>();for(Integer i=0;i<1;i++){String a='appu'+i;us.add(new User(Alias=a,LastName='Synthetic App '+i,Email=a+'@example.invalid',EmailEncodingKey='UTF-8',LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='GMT',ProfileId=UserInfo.getProfileId(),Username=a+Math.abs(Crypto.getRandomInteger())+'@example.invalid'));}Database.DMLOptions opt=new Database.DMLOptions();opt.EmailHeader.triggerUserEmail=false;opt.EmailHeader.triggerOtherEmail=false;List<Database.SaveResult> rs=Database.insert(us,opt);for(Database.SaveResult r:rs)if(!r.isSuccess())System.assert(false,'USER_CREATE '+r.getErrors()[0].getStatusCode()+': '+r.getErrors()[0].getMessage());System.debug('SETUP_DONE');
