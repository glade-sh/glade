public class FernRecordAction { public class Input { @InvocableVariable public String one; @InvocableVariable public String two; @InvocableVariable public String three; @InvocableVariable public Account record; } @InvocableMethod public static void run(List<Input> values) { FernLog.events.add(values[0].one+values.size()+':'+values[0].record.Phone+':'+values[0].two+':'+values[0].three); } }