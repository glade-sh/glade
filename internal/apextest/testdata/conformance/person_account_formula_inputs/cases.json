    "force-app/main/default/classes/PersonFormulaInputProbe.cls": "public class PersonFormulaInputProbe {\n public static String observe() {\n  Map<String,Object> rows=new Map<String,Object>();\n  Id rt=[SELECT Id FROM RecordType WHERE SObjectType='Account' AND DeveloperName='PersonAccount' LIMIT 1].Id;\n  Account business=new Account(Name='Garden Sponsor');insert business;\n  Account person=new Account(RecordTypeId=rt,LastName='Gardener',Note__pc='seed');insert person;\n  for (String kind:new List<String>{'business','person'}) {\n   Id targetId=kind=='business'?business.Id:person.Id;\n   for (String val:new List<String>{'arbitrary',null}) {\n    String suffix=val==null?'null':'value';\n    try {Account x=new Account(Id=targetId);x.put('Derived__pc',val);rows.put('put_'+kind+'_'+suffix,'accepted');}catch(Exception e){rows.put('put_'+kind+'_'+suffix,e.getTypeName());}\n    Account x=(Account)JSON.deserialize(JSON.serialize(new Map<String,Object>{'Id'=>targetId,'Derived__pc'=>val}),Account.class);\n    Database.SaveResult sr=Database.update(x,false);\n    rows.put('json_update_'+kind+'_'+suffix,sr.isSuccess()?'accepted':String.valueOf(sr.getErrors()[0].getStatusCode()));\n   }\n  }\n  Account r=[SELECT Derived__pc FROM Account WHERE Id=:person.Id];\n  Flow.Interview echo=Flow.Interview.createInterview('PersonFormulaEcho',new Map<String,Object>{'People'=>new List<Account>{r}});echo.start();\n  List<Account> returned=(List<Account>)echo.getVariableValue('Returned');\n  rows.put('flow_collection',returned[0].Derived__pc);\n  Invocable.Action action=Invocable.Action.createCustomAction('flow','PersonFieldRead');\n  action.setInvocations(new List<Map<String,Object>>{new Map<String,Object>{'Person'=>r}});\n  Invocable.Action.Result result=action.invoke()[0];\n  rows.put('flow_invocable',result.isSuccess()?result.getOutputParameters().get('Copied'):JSON.serialize(result.getErrors()));\n  Flow.Interview fetch=Flow.Interview.createInterview('PersonFormulaFetch',new Map<String,Object>{'AccountId'=>person.Id});fetch.start();\n  List<Account> fetched=(List<Account>)fetch.getVariableValue('Returned');\n  rows.put('flow_lookup_collection',fetched[0].Derived__pc);\n  return JSON.serialize(rows);\n }\n}",
    "force-app/main/default/classes/PersonFormulaInputProbeTest.cls": "@IsTest private class PersonFormulaInputProbeTest { @IsTest static void observeFields() {System.assert(false,'PERSON_FORMULA|'+PersonFormulaInputProbe.observe());} }",
