List<Account> rows=new List<Account>(); for(String n:INS){rows.add(new Account(Name=n));}
insert rows;
List<String> ids=new List<String>(); List<String> nm=new List<String>();
for(Account a:rows){ids.add(String.valueOf(a.Id));nm.add(a.Name);}
Map<Id,String> byId=new Map<Id,String>(); for(Account a:rows){byId.put(a.Id,a.Name);}
Set<Id> idset=new Set<Id>(); for(Account a:rows){idset.add(a.Id);}
List<String> order=new List<String>(); for(Id i:idset){order.add(byId.get(i));}
System.debug('O1|HSID|IN|'+String.join(INS,','));
