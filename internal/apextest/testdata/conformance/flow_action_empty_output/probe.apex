Invocable.Action a=Invocable.Action.createCustomAction('flow','OwnedOutputProbe'); a.setInvocationParameter('InputText','alpha'); a.addInvocation(); a.setInvocationParameter('InputText','beta'); List<Invocable.Action.Result> rs=a.invoke(); List<Object> out=new List<Object>(); for (Invocable.Action.Result r:rs) { out.add(new Map<String,Object>{'success'=>r.isSuccess(),'outputs'=>r.getOutputParameters()}); } System.assert(false,'ROAD195_RESULT|'+JSON.serialize(out));