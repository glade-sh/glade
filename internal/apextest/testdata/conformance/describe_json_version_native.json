    "OwnedDescribeVersionObserver": "public class OwnedDescribeVersionObserver {\n public static String observe(String row) {\n  Map<String,Object> seen=new Map<String,Object>();\n  if(row=='DJ06') {\n   try {Decimal invalid=Decimal.valueOf('');seen.put('outcome','returned');}\n   catch(Exception issue){seen.put('outcome','threw');seen.put('exception',issue.getTypeName());seen.put('message',issue.getMessage());}\n   return JSON.serialize(seen);\n  }\n  Boolean suppress=row!='DJ02'&&row!='DJ04';String text;\n  if(row=='DJ05') text=JSON.serialize(new Account(Name='Owned Serialized Record'),true);\n  else if(row=='DJ01'||row=='DJ02') text=JSON.serialize(User.SObjectType.getDescribe(SObjectDescribeOptions.DEFERRED),suppress);\n  else text=JSON.serialize(Account.SObjectType.getDescribe(SObjectDescribeOptions.DEFERRED),suppress);\n  Map<String,Object> root=(Map<String,Object>)JSON.deserializeUntyped(text);\n  Matcher match=Pattern.compile('/v(\\\\d+\\\\.0)').matcher(text);\n  Boolean found=match.find();seen.put('matched',found);seen.put('version',found?match.group(1):null);\n  seen.put('hasUrls',root.containsKey('urls'));\n  Map<String,String> relative=new Map<String,String>();Map<String,Object> absolute=new Map<String,Object>();\n  if(root.get('urls') instanceof Map<String,Object>) {\n   Map<String,Object> urls=(Map<String,Object>)root.get('urls');\n   for(String key:urls.keySet()) {\n    String value=(String)urls.get(key);\n    if(value!=null && (value.startsWith('https://')||value.startsWith('http://'))) {\n     Url target=new Url(value);absolute.put(key,new Map<String,Object>{'path'=>target.getPath(),'sha256'=>EncodingUtil.convertToHex(Crypto.generateDigest('SHA256',Blob.valueOf(value)))});\n    } else relative.put(key,value);\n   }\n  }\n  seen.put('relativeUrls',relative);seen.put('absoluteUrls',absolute);\n  if(row=='DJ05') {\n   Map<String,Object> attrs=(Map<String,Object>)root.get('attributes');seen.put('recordType',attrs.get('type'));seen.put('recordName',root.get('Name'));\n  }\n  return JSON.serialize(seen);\n }\n}\n",
    "OwnedDescribeVersionTest": "@IsTest private class OwnedDescribeVersionTest {\n @IsTest static void dj01(){System.assert(false,'DESCRIBE_VERSION|DJ01|'+OwnedDescribeVersionObserver.observe('DJ01'));}\n @IsTest static void dj02(){System.assert(false,'DESCRIBE_VERSION|DJ02|'+OwnedDescribeVersionObserver.observe('DJ02'));}\n @IsTest static void dj03(){System.assert(false,'DESCRIBE_VERSION|DJ03|'+OwnedDescribeVersionObserver.observe('DJ03'));}\n @IsTest static void dj04(){System.assert(false,'DESCRIBE_VERSION|DJ04|'+OwnedDescribeVersionObserver.observe('DJ04'));}\n @IsTest static void dj05(){System.assert(false,'DESCRIBE_VERSION|DJ05|'+OwnedDescribeVersionObserver.observe('DJ05'));}\n @IsTest static void dj06(){System.assert(false,'DESCRIBE_VERSION|DJ06|'+OwnedDescribeVersionObserver.observe('DJ06'));}\n}\n"
