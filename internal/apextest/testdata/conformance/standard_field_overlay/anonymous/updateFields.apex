Map<String,Object> result = new Map<String,Object>();
Account parent = new Account(Name='Parent account'); insert parent;
Account accountRow = new Account(Name='Field account',Tradestyle='First trade',NaicsCode='12345678',NaicsDesc='First industry',YearStarted='1999',DandbCompanyId=null);
insert accountRow;
accountRow.put('Tradestyle','Second trade');
accountRow.put('NaicsCode','87654321');
accountRow.put('NaicsDesc','Second industry');
accountRow.put('YearStarted','2000');
accountRow.put('DandbCompanyId',null);
update accountRow;
Id selectedId = accountRow.Id;
accountRow = (Account)Database.query('SELECT Tradestyle,NaicsCode,NaicsDesc,YearStarted,DandbCompanyId FROM Account WHERE Id=:selectedId');
result.put('Account.Tradestyle',accountRow.get('Tradestyle') == 'Second trade');
result.put('Account.NaicsCode',accountRow.get('NaicsCode') == '87654321');
result.put('Account.NaicsDesc',accountRow.get('NaicsDesc') == 'Second industry');
result.put('Account.YearStarted',accountRow.get('YearStarted') == '2000');
result.put('Account.DandbCompanyId',accountRow.get('DandbCompanyId') == null);
Lead leadRow = new Lead(LastName='Field lead',Company='Field company',CompanyDunsNumber='123456789',CleanStatus='Pending',Fax='5550101',MobilePhone='5550102',DandbCompanyId=null);
insert leadRow;
leadRow.put('CompanyDunsNumber','876543219');
leadRow.put('CleanStatus','Skipped');
leadRow.put('Fax','5550201');
leadRow.put('MobilePhone','5550202');
leadRow.put('DandbCompanyId',null);
update leadRow;
selectedId = leadRow.Id;
leadRow = (Lead)Database.query('SELECT CompanyDunsNumber,CleanStatus,Fax,MobilePhone,DandbCompanyId FROM Lead WHERE Id=:selectedId');
result.put('Lead.CompanyDunsNumber',leadRow.get('CompanyDunsNumber') == '876543219');
result.put('Lead.CleanStatus',leadRow.get('CleanStatus') == 'Skipped');
result.put('Lead.Fax',leadRow.get('Fax') == '5550201');
result.put('Lead.MobilePhone',leadRow.get('MobilePhone') == '5550202');
result.put('Lead.DandbCompanyId',leadRow.get('DandbCompanyId') == null);
Contact contactRow = new Contact(LastName='Field contact',CleanStatus='Pending');
insert contactRow;
contactRow.put('CleanStatus','Skipped');
update contactRow;
selectedId = contactRow.Id;
contactRow = (Contact)Database.query('SELECT CleanStatus FROM Contact WHERE Id=:selectedId');
result.put('Contact.CleanStatus',contactRow.get('CleanStatus') == 'Skipped');
Order orderRow = new Order(AccountId=parent.Id,EffectiveDate=Date.newInstance(2026,1,1),Status='Draft',PoNumber='First PO',PoDate=Date.newInstance(2026,1,2),BillToContactId=null,ShipToContactId=null,CompanyAuthorizedDate=Date.newInstance(2026,1,2),CustomerAuthorizedDate=Date.newInstance(2026,1,2));
insert orderRow;
orderRow.BillToContactId=contactRow.Id; orderRow.ShipToContactId=contactRow.Id; update orderRow;
orderRow.put('PoNumber','Second PO');
orderRow.put('PoDate',Date.newInstance(2026,2,3));
orderRow.put('CompanyAuthorizedDate',Date.newInstance(2026,2,3));
orderRow.put('CustomerAuthorizedDate',Date.newInstance(2026,2,3));
update orderRow;
selectedId = orderRow.Id;
orderRow = (Order)Database.query('SELECT PoNumber,PoDate,BillToContactId,ShipToContactId,CompanyAuthorizedDate,CustomerAuthorizedDate FROM Order WHERE Id=:selectedId');
result.put('Order.PoNumber',orderRow.get('PoNumber') == 'Second PO');
result.put('Order.PoDate',orderRow.get('PoDate') == Date.newInstance(2026,2,3));
result.put('Order.BillToContactId',orderRow.get('BillToContactId') == contactRow.Id);
result.put('Order.ShipToContactId',orderRow.get('ShipToContactId') == contactRow.Id);
result.put('Order.CompanyAuthorizedDate',orderRow.get('CompanyAuthorizedDate') == Date.newInstance(2026,2,3));
result.put('Order.CustomerAuthorizedDate',orderRow.get('CustomerAuthorizedDate') == Date.newInstance(2026,2,3));
System.assert(false,'FIELD_OVERLAY|updateFields|'+JSON.serialize(result));
