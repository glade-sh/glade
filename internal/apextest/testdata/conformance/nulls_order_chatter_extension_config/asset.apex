ContentVersion c=new ContentVersion(Title='Synthetic Icon',PathOnClient='synthetic.png',VersionData=EncodingUtil.base64Decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='),IsAssetEnabled=true);insert c;ContentVersion v=[SELECT ContentDocumentId FROM ContentVersion WHERE Id=:c.Id];ContentAsset a=[SELECT Id,DeveloperName FROM ContentAsset WHERE ContentDocumentId=:v.ContentDocumentId LIMIT 1];System.debug('ASSET|'+a.DeveloperName);
