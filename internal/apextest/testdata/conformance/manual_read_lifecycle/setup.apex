Profile p=[SELECT Id FROM Profile WHERE Name='Standard User' LIMIT 1]; User u=new User(Alias='shr',Email='reader@example.invalid',EmailEncodingKey='UTF-8',LastName='Reader',LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='America/Los_Angeles',ProfileId=p.Id,UserName='manual.'+System.now().getTime()+'@example.invalid'); insert u; PermissionSet ps=[SELECT Id FROM PermissionSet WHERE Name='SyntheticReaderPermission' LIMIT 1]; insert new PermissionSetAssignment(AssigneeId=u.Id,PermissionSetId=ps.Id);
