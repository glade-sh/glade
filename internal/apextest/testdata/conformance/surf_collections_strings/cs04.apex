List<String> rows = new List<String>();
Account a = new Account(Name='Case', Website='w');
rows.add('getLower=' + a.get('name'));
rows.add('getUpper=' + a.get('NAME'));
rows.add('getExact=' + a.get('Name'));
rows.add('getWebsite=' + a.get('website'));
a.put('name', 'Changed');
rows.add('afterPut=' + a.Name);
a.put('WEBSITE', 'w2');
rows.add('afterPut2=' + a.Website);
Set<String> keys = a.getPopulatedFieldsAsMap().keySet();
List<String> sorted = new List<String>(keys);
sorted.sort();
rows.add('keys=' + String.join(sorted, ','));
Account j = (Account) JSON.deserialize('{"name":"lower","website":"w"}', Account.class);
rows.add('jsonLower=' + j.Name + '|' + j.Website);
Map<String,Object> raw = (Map<String,Object>) JSON.deserializeUntyped('{"name":"lower"}');
rows.add('untyped=' + raw.keySet());
System.debug('OBS|' + String.join(rows, ';'));
