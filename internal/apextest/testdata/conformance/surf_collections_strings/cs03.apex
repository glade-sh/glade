List<String> rows = new List<String>();
Account a = new Account(Name='Before', Website='w');
Map<Account,String> m = new Map<Account,String>();
m.put(a, 'v');
Integer h1 = a.hashCode();
String before = m.get(a);
a.Name = 'After';
rows.add('mapGet=' + before + '|afterGet=' + m.get(a) + '|contains=' + m.containsKey(a) + '|size=' + m.size());
rows.add('hashSame=' + (h1 == a.hashCode()) + '|hash1=' + h1 + '|hash2=' + a.hashCode());
Set<Account> s = new Set<Account>();
s.add(a);
Boolean in1 = s.contains(a);
a.Name = 'Third';
rows.add('setIn=' + in1 + '|setAfter=' + s.contains(a) + '|setSize=' + s.size());
Account stored = new Account(Name='Lookup');
insert stored;
Map<Id,Account> byId = new Map<Id,Account>{ stored.Id => stored };
Id key = stored.Id;
stored.Name = 'Mutated';
rows.add('idKey=' + (byId.get(key) != null) + '|name=' + byId.get(key).Name);
Map<String,Account> byName = new Map<String,Account>();
Account b = new Account(Name='K');
byName.put('K', b);
System.debug('OBS|' + String.join(rows, ';'));
