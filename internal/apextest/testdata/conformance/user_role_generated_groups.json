  "anonymousSources": {
    "RG01": "String token = 'OwnedRgOne' + String.valueOf(Datetime.now().getTime());\nMap<String, Object> result = new Map<String, Object>();\nUserRole role = new UserRole(Name=token, DeveloperName=token);\nresult.put('beforeRoleIdNull', role.Id == null);\nresult.put('beforeRoleCount', [SELECT COUNT() FROM UserRole WHERE DeveloperName=:token]);\ninsert role;\nList<Map<String, Object>> groups = new List<Map<String, Object>>();\nfor (Group row : [SELECT Type, RelatedId FROM Group WHERE RelatedId=:role.Id]) {\n    groups.add(new Map<String, Object>{'type'=>row.Type, 'relatedMatchesRole'=>row.RelatedId == role.Id});\n}\nresult.put('afterRoleIdNull', role.Id == null);\nresult.put('afterGroups', groups);\nSystem.debug(LoggingLevel.ERROR, 'RG01|' + JSON.serialize(result));\n",
    "RG02": "String token = 'OwnedRgTwo' + String.valueOf(Datetime.now().getTime());\nUserRole parent = new UserRole(Name=token+'P', DeveloperName=token+'P');\ninsert parent;\nList<String> parentBeforeTypes = new List<String>();\nfor (Group row : [SELECT Type FROM Group WHERE RelatedId=:parent.Id]) parentBeforeTypes.add(row.Type);\nUserRole child = new UserRole(Name=token+'C', DeveloperName=token+'C', ParentRoleId=parent.Id);\ninsert child;\nSet<Id> roles = new Set<Id>{parent.Id, child.Id};\nList<Map<String, Object>> groups = new List<Map<String, Object>>();\nfor (Group row : [SELECT Type, RelatedId FROM Group WHERE RelatedId IN :roles]) {\n    groups.add(new Map<String, Object>{'type'=>row.Type, 'parent'=>row.RelatedId==parent.Id, 'child'=>row.RelatedId==child.Id});\n}\nSystem.debug(LoggingLevel.ERROR, 'RG02|' + JSON.serialize(new Map<String,Object>{'parentBeforeTypes'=>parentBeforeTypes,'afterGroups'=>groups}));\n",
    "RG03": "String token = 'OwnedRgThree' + String.valueOf(Datetime.now().getTime());\nUserRole first = new UserRole(Name=token+'A', DeveloperName=token+'A');\nUserRole second = new UserRole(Name=token+'B', DeveloperName=token+'B');\ninsert new List<UserRole>{first, second};\nSet<Id> roles = new Set<Id>{first.Id, second.Id};\nMap<Id, Group> beforeRows = new Map<Id, Group>([SELECT Id, Type, RelatedId FROM Group WHERE RelatedId IN :roles]);\nfirst.Name = token+'Updated';\nupdate first;\nupdate first;\nList<Map<String, Object>> groups = new List<Map<String, Object>>();\nfor (Group row : [SELECT Id, Type, RelatedId FROM Group WHERE RelatedId IN :roles]) {\n    groups.add(new Map<String, Object>{'type'=>row.Type, 'first'=>row.RelatedId==first.Id, 'second'=>row.RelatedId==second.Id, 'sameGroupIdentity'=>beforeRows.containsKey(row.Id)});\n}\nSystem.debug(LoggingLevel.ERROR, 'RG03|' + JSON.serialize(new Map<String,Object>{'beforeCount'=>beforeRows.size(),'afterGroups'=>groups}));\n"
  },
