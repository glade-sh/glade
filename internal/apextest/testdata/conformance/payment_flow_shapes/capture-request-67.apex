Double amount=7.25; String ref='synthetic-ref'; commercepayments.CaptureRequest req = new commercepayments.CaptureRequest(amount, ref); System.assertEquals(amount, req.amount); System.assertEquals(ref, req.paymentAuthorizationId); commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.Capture); System.assertEquals(commercepayments.RequestType.Capture, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req);
