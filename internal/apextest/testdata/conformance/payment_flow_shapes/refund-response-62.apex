Double amount=7.25; String ref='synthetic-ref'; commercepayments.ReferencedRefundResponse res = new commercepayments.ReferencedRefundResponse(); res.setAmount(amount); res.setGatewayReferenceNumber(ref); res.setGatewayResultCode('ok'); res.setGatewayMessage('accepted'); commercepayments.GatewayResponse gateway = res; System.assert(gateway != null);
