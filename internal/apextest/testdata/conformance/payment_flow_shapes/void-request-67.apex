Double amount=7.25; String ref='synthetic-ref'; commercepayments.AuthorizationReversalRequest req = new commercepayments.AuthorizationReversalRequest(amount, ref); System.assertEquals(amount, req.amount); System.assertEquals(ref, req.paymentAuthorizationId); commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.AuthorizationReversal); System.assertEquals(commercepayments.RequestType.AuthorizationReversal, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); 