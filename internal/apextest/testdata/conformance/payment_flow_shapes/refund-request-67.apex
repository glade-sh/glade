Double amount=7.25; String ref='synthetic-ref'; commercepayments.ReferencedRefundRequest req = new commercepayments.ReferencedRefundRequest(amount, ref); System.assertEquals(amount, req.amount); System.assertEquals(ref, req.PaymentId); commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.ReferencedRefund); System.assertEquals(commercepayments.RequestType.ReferencedRefund, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); 