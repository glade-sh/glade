Double amount=7.25; String ref='synthetic-ref'; commercepayments.AuthorizationRequest req = new commercepayments.AuthorizationRequest(amount); System.assertEquals(amount, req.amount);  commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.Authorize); System.assertEquals(commercepayments.RequestType.Authorize, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); 