Double amount=7.25; String ref='synthetic-ref'; commercepayments.SaleRequest req = new commercepayments.SaleRequest(amount); System.assertEquals(amount, req.amount);  commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.Sale); System.assertEquals(commercepayments.RequestType.Sale, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); 