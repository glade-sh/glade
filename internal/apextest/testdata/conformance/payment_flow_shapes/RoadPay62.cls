@IsTest private class RoadPay62 {
@IsTest static void authorize() { Double amount=7.25; String ref='synthetic-ref'; commercepayments.AuthorizationRequest req = new commercepayments.AuthorizationRequest(amount); System.assertEquals(amount, req.amount);  commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.Authorize); System.assertEquals(commercepayments.RequestType.Authorize, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); commercepayments.AuthorizationResponse res = new commercepayments.AuthorizationResponse(); res.setAmount(amount); res.setGatewayReferenceNumber(ref); res.setGatewayResultCode('ok'); res.setGatewayMessage('accepted'); commercepayments.GatewayResponse gateway = res; System.assert(gateway != null); }
@IsTest static void capture() { Double amount=7.25; String ref='synthetic-ref'; commercepayments.CaptureRequest req = new commercepayments.CaptureRequest(amount, ref); System.assertEquals(amount, req.amount); System.assertEquals(ref, req.paymentAuthorizationId); commercepayments.PaymentGatewayContext ctx = new commercepayments.PaymentGatewayContext(req, commercepayments.RequestType.Capture); System.assertEquals(commercepayments.RequestType.Capture, ctx.getPaymentRequestType()); System.assert(ctx.getPaymentRequest() == req); commercepayments.CaptureResponse res = new commercepayments.CaptureResponse(); res.setAmount(amount); res.setGatewayReferenceNumber(ref); res.setGatewayResultCode('ok'); res.setGatewayMessage('accepted'); commercepayments.GatewayResponse gateway = res; System.assert(gateway != null); }
