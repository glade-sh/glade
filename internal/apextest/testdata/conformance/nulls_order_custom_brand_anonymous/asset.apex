List<ContentVersion> cs=new List<ContentVersion>();for(String name:new List<String>{'Synthetic Icon Alpha','Synthetic Icon Beta'})cs.add(new ContentVersion(Title=name,PathOnClient='synthetic.png',VersionData=EncodingUtil.base64Decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='),IsAssetEnabled=true));insert cs;Set<Id> ids=new Set<Id>{cs[0].Id,cs[1].Id};Set<Id> docs=new Set<Id>();for(ContentVersion v:[SELECT ContentDocumentId FROM ContentVersion WHERE Id IN :ids])docs.add(v.ContentDocumentId);List<String> names=new List<String>();for(ContentAsset a:[SELECT DeveloperName FROM ContentAsset WHERE ContentDocumentId IN :docs ORDER BY DeveloperName])names.add(a.DeveloperName);System.debug('ASSET|'+String.join(names,','));
