@IsTest private class CedarDeliveryObservationTest {
 private static List<String> rows(){
  List<String> result=new List<String>();
  for(Contact c:[SELECT LastName,Description FROM Contact WHERE LastName LIKE 'cedar-%' ORDER BY LastName]) result.add(c.LastName+'/'+c.Description);
  result.sort(); return result;
 }
 @IsTest static void cdcExplicit(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Test.startTest(); insert new Account(Name='cedar-source'); out.put('before',rows()); Test.getEventBus().deliver(); out.put('delivered',rows()); Test.getEventBus().deliver(); out.put('repeat',rows()); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|cdcExplicit|'+JSON.serialize(out));}
 @IsTest static void cdcStop(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Test.startTest(); insert new Account(Name='cedar-source'); out.put('before',rows()); Test.stopTest(); out.put('stopped',rows()); Test.getEventBus().deliver(); out.put('repeat',rows()); System.assert(false,'OBSERVED|cdcStop|'+JSON.serialize(out));}
 @IsTest static void cdcDisabled(){Map<String,Object> out=new Map<String,Object>(); Test.startTest(); insert new Account(Name='cedar-source'); Test.getEventBus().deliver(); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|cdcDisabled|'+JSON.serialize(out));}
 @IsTest static void cdcLateEnable(){Map<String,Object> out=new Map<String,Object>(); insert new Account(Name='cedar-before'); Test.enableChangeDataCapture(); insert new Account(Name='cedar-after'); Test.getEventBus().deliver(); out.put('delivered',rows()); System.assert(false,'OBSERVED|cdcLateEnable|'+JSON.serialize(out));}
 @IsTest static void cdcOperations(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Account a=new Account(Name='cedar-source'); insert a; Test.getEventBus().deliver(); out.put('created',rows()); a.Description='changed'; update a; Test.getEventBus().deliver(); out.put('updated',rows()); delete a; Test.getEventBus().deliver(); out.put('deleted',rows()); undelete a; Test.getEventBus().deliver(); out.put('undeleted',rows()); System.assert(false,'OBSERVED|cdcOperations|'+JSON.serialize(out));}
 @IsTest static void cdcBulk(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); insert new List<Account>{new Account(Name='cedar-one'),new Account(Name='cedar-two')}; Test.getEventBus().deliver(); out.put('delivered',rows()); System.assert(false,'OBSERVED|cdcBulk|'+JSON.serialize(out));}
 @IsTest static void asyncPath(){Map<String,Object> out=new Map<String,Object>(); Test.startTest(); insert new Account(Name='cedar-async'); out.put('before',rows()); Test.getEventBus().deliver(); out.put('delivered',rows()); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|asyncPath|'+JSON.serialize(out));}
 @IsTest static void scheduledPath(){Map<String,Object> out=new Map<String,Object>(); Test.startTest(); insert new Account(Name='cedar-scheduled'); out.put('before',rows()); Test.getEventBus().deliver(); out.put('delivered',rows()); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|scheduledPath|'+JSON.serialize(out));}
 @IsTest static void eventExplicit(){Map<String,Object> out=new Map<String,Object>(); Test.startTest(); EventBus.publish(new List<CedarSignal__e>{new CedarSignal__e(Token__c='cedar-one'),new CedarSignal__e(Token__c='cedar-two')}); out.put('before',rows()); Test.getEventBus().deliver(); out.put('delivered',rows()); Test.getEventBus().deliver(); out.put('repeat',rows()); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|eventExplicit|'+JSON.serialize(out));}
 @IsTest static void eventStop(){Map<String,Object> out=new Map<String,Object>(); Test.startTest(); EventBus.publish(new CedarSignal__e(Token__c='cedar-one')); out.put('before',rows()); Test.stopTest(); out.put('stopped',rows()); System.assert(false,'OBSERVED|eventStop|'+JSON.serialize(out));}
 @IsTest static void cdcDisabledDelivery(){Map<String,Object> out=new Map<String,Object>(); insert new Account(Name='cedar-before'); Test.getEventBus().deliver(); out.put('disabled',rows()); Test.enableChangeDataCapture(); Test.getEventBus().deliver(); out.put('enabled',rows()); System.assert(false,'OBSERVED|cdcDisabledDelivery|'+JSON.serialize(out));}
 @IsTest static void cdcRollback(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Savepoint s=Database.setSavepoint(); insert new Account(Name='cedar-rolledback'); Database.rollback(s); Test.getEventBus().deliver(); out.put('delivered',rows()); System.assert(false,'OBSERVED|cdcRollback|'+JSON.serialize(out));}
 @IsTest static void cdcPartial(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Database.insert(new List<Account>{new Account(Name='cedar-valid'),new Account()},false); Test.getEventBus().deliver(); out.put('delivered',rows()); System.assert(false,'OBSERVED|cdcPartial|'+JSON.serialize(out));}
 @IsTest static void cdcNameUpdate(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Account a=new Account(Name='cedar-original'); insert a; Test.getEventBus().deliver(); a.Name='cedar-renamed'; update a; Test.getEventBus().deliver(); out.put('delivered',rows()); System.assert(false,'OBSERVED|cdcNameUpdate|'+JSON.serialize(out));}
 private static List<String> leads(){List<String> result=new List<String>(); for(Lead l:[SELECT LastName,Company,Description FROM Lead WHERE LastName LIKE 'cedar-%' ORDER BY LastName]) result.add(l.LastName+'/'+l.Company+'/'+l.Description); result.sort(); return result;}
 private static List<String> headers(){List<String> result=new List<String>(); for(Contact c:[SELECT Description FROM Contact WHERE LastName='cedar-header']) result.add(c.Description); result.sort(); return result;}
 @IsTest static void cdcFlowOnly(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Test.startTest(); insert new Contact(LastName='cedar-flow-source'); out.put('before',leads()); Test.getEventBus().deliver(); out.put('delivered',leads()); Test.getEventBus().deliver(); out.put('repeat',leads()); Test.stopTest(); out.put('stopped',leads()); System.assert(false,'OBSERVED|cdcFlowOnly|'+JSON.serialize(out));}
 @IsTest static void cdcUpsert(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Account a=new Account(Name='cedar-upsert-source'); upsert a; Test.getEventBus().deliver(); out.put('created',rows()); a.Description='cedar-upsert-updated'; upsert a; Test.getEventBus().deliver(); out.put('updated',rows()); Savepoint point=Database.setSavepoint(); upsert new Account(Name='cedar-upsert-rolledback'); Database.rollback(point); Test.getEventBus().deliver(); out.put('rollback',rows()); System.assert(false,'OBSERVED|cdcUpsert|'+JSON.serialize(out));}
 @IsTest static void cdcHeaders(){Map<String,Object> out=new Map<String,Object>(); Test.enableChangeDataCapture(); Account a=new Account(Name='cedar-header-source',Description='first'); insert a; CedarHeaderProbe.recordIds.add(String.valueOf(a.Id)); Test.getEventBus().deliver(); out.put('created',headers()); a.Description='second'; update a; Test.getEventBus().deliver(); out.put('updated',headers()); a.Description=null; update a; Test.getEventBus().deliver(); out.put('nulled',headers()); delete a; Test.getEventBus().deliver(); out.put('deleted',headers()); undelete a; Test.getEventBus().deliver(); out.put('undeleted',headers()); System.assert(false,'OBSERVED|cdcHeaders|'+JSON.serialize(out));}
}
