<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PriorInsertGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), PRIORVALUE(TextValue__c) = &quot;insert-block&quot;)</errorConditionFormula>
    <errorMessage>Prior value on insert blocked</errorMessage>
</ValidationRule>
