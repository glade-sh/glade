<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ChangedInsertGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), ISCHANGED(TextValue__c), TextValue__c = &quot;change-insert&quot;)</errorConditionFormula>
    <errorMessage>Changed value on insert blocked</errorMessage>
</ValidationRule>
