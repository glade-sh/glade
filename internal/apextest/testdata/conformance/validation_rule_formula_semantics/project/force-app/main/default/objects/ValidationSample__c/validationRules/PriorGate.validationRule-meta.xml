<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PriorGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), PRIORVALUE(TextValue__c) = &quot;prior-block&quot;, TextValue__c = &quot;current&quot;)</errorConditionFormula>
    <errorMessage>Prior value blocked</errorMessage>
</ValidationRule>
