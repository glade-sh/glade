<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DivisionBlankGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), ISBLANK(NumberValue__c), NumberValue__c / 2 &lt; 1)</errorConditionFormula>
    <errorMessage>Blank division result blocked</errorMessage>
</ValidationRule>
