<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PickBlankGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), ISPICKVAL(PickValue__c, &quot;&quot;))</errorConditionFormula>
    <errorMessage>Blank picklist value blocked</errorMessage>
</ValidationRule>
