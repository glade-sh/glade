<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DivisionZeroLessGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), Name = &quot;Division Zero Less&quot;, 1 / NumberValue__c &lt; 0)</errorConditionFormula>
    <errorMessage>Zero division less comparison blocked</errorMessage>
</ValidationRule>
