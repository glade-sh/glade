<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ParentChangedGate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), ISCHANGED(Parent__c), Parent__r.Gate__c)</errorConditionFormula>
    <errorMessage>Changed parent value blocked</errorMessage>
</ValidationRule>
