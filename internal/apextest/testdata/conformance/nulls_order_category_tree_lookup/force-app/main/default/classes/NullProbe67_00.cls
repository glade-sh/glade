@IsTest(SeeAllData=true) private class NullProbe67_00 { @IsTest static void probe(){Map<String,Object> obs=new Map<String,Object>();try{List<CategoryNode> roots=[SELECT Id FROM CategoryNode WHERE ParentId=null LIMIT 1];List<CategoryNode> leaves=[SELECT Id,ParentId FROM CategoryNode WHERE MasterLabel IN ('SyntheticLeafAlpha','SyntheticLeafBeta')];if(roots.size()!=1||leaves.size()!=2)obs.put('skip','missing root or synthetic leaves');else{List<Id> parents=new List<Id>{leaves[0].ParentId,leaves[1].ParentId};parents.sort();Set<Id> ids=new Set<Id>{roots[0].Id,leaves[0].Id,leaves[1].Id};Map<Id,String> labels=new Map<Id,String>{roots[0].Id=>'N'};for(CategoryNode leaf:leaves)labels.put(leaf.Id,leaf.ParentId==parents[0]?'L':'H');for(String tail:new List<String>{'NULLS FIRST','NULLS LAST','ASC','DESC','DESC NULLS LAST'}){List<String> ordered=new List<String>();for(CategoryNode node:Database.query('SELECT Id FROM CategoryNode WHERE Id IN :ids ORDER BY ParentId '+tail))ordered.add(labels.get(node.Id));obs.put(tail,String.join(ordered,''));}}}catch(Exception e){obs.put('skip','EXC '+e.getTypeName()+': '+e.getMessage().left(160));}System.assert(false,'CAPTURE|CategoryNode|'+JSON.serialize(new Map<String,Object>{'ParentId'=>obs})); }}
