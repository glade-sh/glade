@IsTest(SeeAllData=true) private class PromptSiteProbe62 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{List<SObject> sites=Database.query('SELECT Id FROM Site WITH SYSTEM_MODE LIMIT 2');out.put('siteCount',sites.size());if(!sites.isEmpty()){Id siteId=(Id)sites[0].get('Id');Schema.SObjectType pt=Schema.getGlobalDescribe().get('Prompt');Schema.SObjectType vt=Schema.getGlobalDescribe().get('PromptVersion');List<SObject> parents=new List<SObject>();for(String name:new List<String>{'A','B'}){SObject x=pt.newSObject();x.put('DeveloperName','SyntheticPrompt'+name);x.put('MasterLabel','Synthetic Prompt '+name);parents.add(x);}Database.SaveResult[] prs=Database.insert(parents,false,AccessLevel.SYSTEM_MODE);List<String> ps=new List<String>();for(Database.SaveResult r:prs)ps.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(140));out.put('parents',ps);if(prs[0].isSuccess()&&prs[1].isSuccess()){List<SObject> versions=new List<SObject>();for(Integer i=0;i<2;i++){SObject x=vt.newSObject();x.put('ParentId',parents[i].get('Id'));x.put('MasterLabel','Synthetic Version '+i);x.put('DisplayType','DockedComposer');x.put('Title','Synthetic title');x.put('VersionNumber',1);x.put('Body','Synthetic body');if(i==1)x.put('ExperienceContextId',siteId);versions.add(x);}Database.SaveResult[] rs=Database.insert(versions,false,AccessLevel.SYSTEM_MODE);List<String> vs=new List<String>();for(Database.SaveResult r:rs)vs.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(140));out.put('versions',vs);if(rs[0].isSuccess()&&rs[1].isSuccess()){Set<Id> ids=new Set<Id>{rs[0].getId(),rs[1].getId()};for(String suffix:new List<String>{'ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT ExperienceContextId FROM PromptVersion WHERE Id IN :ids WITH SYSTEM_MODE ORDER BY ExperienceContextId '+suffix);String order='';for(SObject x:found)order+=x.get('ExperienceContextId')==null?'N':'P';out.put(suffix,order);}}}Database.SaveResult bad=Database.insert(vt.newSObject(),false,AccessLevel.SYSTEM_MODE);out.put('rejection',bad.isSuccess()?'OK':String.valueOf(bad.getErrors()[0].getStatusCode()));}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(160));}System.assert(false,'CAPTURE|PromptSite|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }