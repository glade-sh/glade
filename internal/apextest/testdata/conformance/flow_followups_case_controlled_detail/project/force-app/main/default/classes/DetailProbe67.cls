@IsTest private with sharing class DetailProbe67 {
 static User makeUser(String a, Id p){return new User(Alias=a,Email=a+'@example.invalid',EmailEncodingKey='UTF-8',LastName=a,LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='GMT',ProfileId=p,Username=a+Math.abs(Crypto.getRandomInteger())+'@example.invalid');}
 @IsTest static void probe(){Map<String,Object> obs=new Map<String,Object>();try{
  Id profileId=[SELECT Id FROM Profile WHERE Name='Standard User' LIMIT 1].Id; User a=makeUser('probea',profileId),b=makeUser('probeb',profileId);
  System.runAs(new User(Id=UserInfo.getUserId())){Database.DMLOptions opt=new Database.DMLOptions();opt.EmailHeader.triggerUserEmail=false;opt.EmailHeader.triggerOtherEmail=false;Database.insert(new List<User>{a,b},opt);Id perm=[SELECT Id FROM PermissionSet WHERE Name='SyntheticDetailAccess' LIMIT 1].Id;insert new List<PermissionSetAssignment>{new PermissionSetAssignment(AssigneeId=a.Id,PermissionSetId=perm),new PermissionSetAssignment(AssigneeId=b.Id,PermissionSetId=perm)};}
  Id parentId,childId;System.runAs(a){Case parent=new Case(Subject='Synthetic',Origin='Phone');insert parent;SyntheticDetail__c child=new SyntheticDetail__c(Name='Synthetic',Case__c=parent.Id);insert child;parentId=parent.Id;childId=child.Id;obs.put('ownerParent',[SELECT count() FROM Case WHERE Id=:parentId]);obs.put('ownerChild',[SELECT count() FROM SyntheticDetail__c WHERE Id=:childId]);}
  System.runAs(b){obs.put('otherParent',[SELECT count() FROM Case WHERE Id=:parentId]);obs.put('otherChild',[SELECT count() FROM SyntheticDetail__c WHERE Id=:childId]);obs.put('otherParentUser',[SELECT count() FROM Case WHERE Id=:parentId WITH USER_MODE]);obs.put('otherChildUser',[SELECT count() FROM SyntheticDetail__c WHERE Id=:childId WITH USER_MODE]);}
 }catch(Exception e){obs.put('setupError',e.getTypeName()+': '+e.getMessage().left(180));}System.assert(false,'CAPTURE|CaseDetail|'+JSON.serialize(new Map<String,Object>{'sharing'=>obs}));}
}
