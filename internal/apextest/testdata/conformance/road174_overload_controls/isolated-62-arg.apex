Id uid=UserInfo.getUserId();String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<SObject> rows=Database.query(q,AccessLevel.USER_MODE);SObject a=rows[0].getSObject('UserRecordAccess');System.debug('R5ISO|'+JSON.serialize(new List<Object>{a.get('HasAllAccess'),a.get('MaxAccessLevel')}));