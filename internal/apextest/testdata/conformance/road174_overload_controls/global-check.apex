PermissionSet p=[SELECT Id FROM PermissionSet WHERE Name='Road174Global'];for(ObjectPermissions o:[SELECT SobjectType,PermissionsRead,PermissionsCreate,PermissionsEdit,PermissionsDelete,PermissionsViewAllRecords,PermissionsModifyAllRecords FROM ObjectPermissions WHERE ParentId=:p.Id AND SobjectType='Order'])System.debug('R5GLOBALPERM|'+JSON.serialize(new List<Object>{o.PermissionsRead,o.PermissionsCreate,o.PermissionsEdit,o.PermissionsDelete,o.PermissionsViewAllRecords,o.PermissionsModifyAllRecords}));
