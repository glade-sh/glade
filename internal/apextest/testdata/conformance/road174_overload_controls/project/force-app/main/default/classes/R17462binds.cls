public class R17462binds {public static String collect(){Id uid=UserInfo.getUserId();String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<SObject> rows=Database.queryWithBinds(q,new Map<String,Object>{'uid'=>uid},AccessLevel.USER_MODE);SObject a=rows[0].getSObject('UserRecordAccess');return JSON.serialize(new List<Object>{a.get('HasAllAccess'),a.get('MaxAccessLevel')});}}