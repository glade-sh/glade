public class R174Seq62 {public static String collect(){Id uid=UserInfo.getUserId();String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<Object> out=new List<Object>();for(String route:new List<String>{'user','user','default','user','system','user'}){try{List<SObject> rs;if(route=='user')rs=Database.query(q,AccessLevel.USER_MODE);else if(route=='system')rs=Database.query(q,AccessLevel.SYSTEM_MODE);else rs=Database.query(q);SObject a=rs[0].getSObject('UserRecordAccess');out.add(new List<Object>{route,a.get('HasAllAccess'),a.get('MaxAccessLevel')});}catch(Exception e){out.add(new List<Object>{route,e.getTypeName()});}}return JSON.serialize(out);}}