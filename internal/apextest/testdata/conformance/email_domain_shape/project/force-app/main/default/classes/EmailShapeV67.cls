public class EmailShapeV67 { public static Object observe() { List<Object> out=new List<Object>(); for (EmailServicesAddress a : [SELECT DeveloperName, LocalPart, EmailDomainName, Function.FunctionName FROM EmailServicesAddress ORDER BY DeveloperName]) { List<String> labels=a.EmailDomainName.split('\\.'); List<Integer> lens=new List<Integer>(); for (String part:labels) lens.add(part.length()); out.add(new Map<String,Object>{'address'=>a.DeveloperName,'local'=>a.LocalPart,'function'=>a.Function.FunctionName,'lengths'=>lens,'suffix'=>a.EmailDomainName.substring(a.EmailDomainName.indexOf('.apex.'))}); } return out; } }