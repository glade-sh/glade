@IsTest private class SplitAvailability62Test { @IsTest static void observe() { for (String n : new List<String>{'OpportunitySplit','OpportunityTeamMember','Account'}) { System.assertEquals(true,Schema.getGlobalDescribe().containsKey(n),n); System.assertNotEquals(null,Type.forName('Schema.'+n),n); Database.countQuery('SELECT COUNT() FROM '+n); } for (String n : new List<String>{'CampaignInfluence','AbsentObject__c'}) { System.assertEquals(false,Schema.getGlobalDescribe().containsKey(n),n); System.assertEquals(null,Type.forName('Schema.'+n),n); Boolean rejected=false; try { Database.countQuery('SELECT COUNT() FROM '+n); } catch (System.QueryException e) {rejected=true;} System.assert(rejected,n); } } }
