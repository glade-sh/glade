@IsTest private class CaptureFilterTest {
@IsTest static void In_populated() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_In', new Map<String,Object>{'ids'=>new List<String>{String.valueOf(b.Id)}}); f.start(); System.assertEquals('Capture Collection Seed B',f.getVariableValue('outcome')); }
@IsTest static void In_empty() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_In', new Map<String,Object>{'ids'=>new List<String>()}); f.start(); System.assertEquals(null,f.getVariableValue('outcome')); }
@IsTest static void In_unassigned() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_In', new Map<String,Object>()); f.start(); System.assertEquals(null,f.getVariableValue('outcome')); }
@IsTest static void NotIn_populated() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_NotIn', new Map<String,Object>{'ids'=>new List<String>{String.valueOf(b.Id)}}); f.start(); System.assertEquals('Capture Collection Seed A',f.getVariableValue('outcome')); }
@IsTest static void NotIn_empty() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_NotIn', new Map<String,Object>{'ids'=>new List<String>()}); f.start(); System.assertEquals('Capture Collection Seed A',f.getVariableValue('outcome')); }
@IsTest static void NotIn_unassigned() { Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b}; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_NotIn', new Map<String,Object>()); f.start(); System.assertEquals('Capture Collection Seed A',f.getVariableValue('outcome')); }
@IsTest static void NotIn_single_matching() { Account b = new Account(Name='Capture Collection Seed B'); insert b; Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_NotIn',new Map<String,Object>{'ids'=>new List<String>{String.valueOf(b.Id)}}); f.start(); System.assertEquals(null,f.getVariableValue('outcome')); }
}
