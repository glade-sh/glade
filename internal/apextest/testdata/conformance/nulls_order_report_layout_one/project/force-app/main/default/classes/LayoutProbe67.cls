@IsTest(SeeAllData=true) private class LayoutProbe67 { static Map<String,Object> one(String objectName,Id layout){Map<String,Object> out=new Map<String,Object>();try{Schema.SObjectType typ=Schema.getGlobalDescribe().get(objectName);List<SObject> xs=new List<SObject>();Id parentId;if(objectName=='WorkOrderLineItem'){SObject parent=Schema.getGlobalDescribe().get('WorkOrder').newSObject();Database.SaveResult pr=Database.insert(parent,false,AccessLevel.SYSTEM_MODE);if(!pr.isSuccess()){out.put('parent',String.valueOf(pr.getErrors()[0].getStatusCode()));return out;}parentId=pr.getId();}for(Integer i=0;i<2;i++){SObject x=typ.newSObject();if(objectName=='WorkType'){x.put('Name','Synthetic type '+i);x.put('EstimatedDuration',1);}if(objectName=='WorkOrderLineItem')x.put('WorkOrderId',parentId);if(i==1)x.put('ServiceReportTemplateId',layout);xs.add(x);}Database.SaveResult[] rs=Database.insert(xs,false,AccessLevel.SYSTEM_MODE);List<String> states=new List<String>();for(Database.SaveResult r:rs)states.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(160));out.put('insert',states);if(!rs[0].isSuccess()||!rs[1].isSuccess())return out;Set<Id> ids=new Set<Id>{rs[0].getId(),rs[1].getId()};for(String suffix:new List<String>{'ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT ServiceReportTemplateId FROM '+objectName+' WHERE Id IN :ids WITH SYSTEM_MODE ORDER BY ServiceReportTemplateId '+suffix);String order='';for(SObject x:found)order+=x.get('ServiceReportTemplateId')==null?'N':'P';out.put(suffix,order);}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(160));}return out;} @IsTest static void probe(){List<SObject> layouts=Database.query('SELECT Id FROM ServiceReportLayout WITH SYSTEM_MODE LIMIT 2');Map<String,Object> out=new Map<String,Object>{'layoutCount'=>layouts.size()};if(layouts.size()>0){Id layout=(Id)layouts[0].get('Id');for(String name:new List<String>{'WorkOrder','WorkOrderLineItem','WorkType'})out.put(name,one(name,layout));}SObject bad=Schema.getGlobalDescribe().get('WorkOrderLineItem').newSObject();Database.SaveResult rejection=Database.insert(bad,false,AccessLevel.SYSTEM_MODE);out.put('rejection',rejection.isSuccess()?'OK':String.valueOf(rejection.getErrors()[0].getStatusCode()));System.assert(false,'CAPTURE|Layout|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }