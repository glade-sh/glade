List<List<SObject>> buckets=Search.query('FIND {B*ta} IN NAME FIELDS RETURNING Account(Id,AccountNumber ORDER BY Name ASC)'); List<String> names=new List<String>(); for(List<SObject> bucket:buckets){List<String> vals=new List<String>(); for(SObject rec:bucket){if(rec instanceof Account){vals.add((String)rec.get('AccountNumber'));}else{vals.add((String)rec.get('Department'));}} names.add('['+String.join(vals,',')+']');} obs=String.join(names,'/');
