List<List<SObject>> buckets=Search.query('FIND {Amberquartz} RETURNING Account(Id,AccountNumber WHERE AccountNumber != \'B\' ORDER BY Name ASC LIMIT 1 OFFSET 1),Contact(Id,Department ORDER BY LastName DESC LIMIT 1)'); List<String> names=new List<String>(); for(List<SObject> bucket:buckets){List<String> vals=new List<String>(); for(SObject rec:bucket){if(rec instanceof Account){vals.add((String)rec.get('AccountNumber'));}else{vals.add((String)rec.get('Department'));}} names.add('['+String.join(vals,',')+']');} obs=String.join(names,'/');
