delete b; Test.setFixedSearchResults(new List<Id>{b.Id,c.Id}); List<List<SObject>> buckets=Search.query('FIND {Amberquartz} RETURNING Account(Id,AccountNumber),Contact(Id,Department)'); List<String> names=new List<String>(); for(List<SObject> bucket:buckets){List<String> vals=new List<String>(); for(SObject rec:bucket){if(rec instanceof Account){vals.add((String)rec.get('AccountNumber'));}else{vals.add((String)rec.get('Department'));}} names.add('['+String.join(vals,',')+']');} obs=String.join(names,'/');
