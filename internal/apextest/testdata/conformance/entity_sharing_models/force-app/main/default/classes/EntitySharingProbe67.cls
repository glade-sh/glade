public class EntitySharingProbe67 { public static Map<String,Object> observe(){Set<String> names=new Set<String>{'Account','Case','Order','User','OwnedRead__c','OwnedPublic__c','OwnedPrivate__c'};Map<String,Object> result=new Map<String,Object>();for(EntityDefinition e:[SELECT QualifiedApiName,InternalSharingModel FROM EntityDefinition WHERE QualifiedApiName IN :names]) result.put(e.QualifiedApiName,e.InternalSharingModel);return result;} }