Profile p=[SELECT Id FROM Profile WHERE Name='Standard User' LIMIT 1];User actor=new User(Alias='probeb',Email='probeb@example.invalid',EmailEncodingKey='UTF-8',LastName='Synthetic',LanguageLocaleKey='en_US',LocaleSidKey='en_US',TimeZoneSidKey='GMT',ProfileId=p.Id,Username='probeb'+Math.abs(Crypto.getRandomInteger())+'@example.invalid');Database.DMLOptions opt=new Database.DMLOptions();opt.EmailHeader.triggerUserEmail=false;opt.EmailHeader.triggerOtherEmail=false;Database.SaveResult result=Database.insert(actor,opt);if(!result.isSuccess())System.assert(false,'USER_CREATE '+result.getErrors()[0].getStatusCode()+': '+result.getErrors()[0].getMessage());Id perm=[SELECT Id FROM PermissionSet WHERE Name='SyntheticWorkAccess' LIMIT 1].Id;insert new PermissionSetAssignment(AssigneeId=result.getId(),PermissionSetId=perm);Group q=new Group(Name='Synthetic Queue',DeveloperName='SyntheticQueue',Type='Queue');insert q;insert new QueueSobject(QueueId=q.Id,SobjectType='SyntheticWork__c');insert new GroupMember(GroupId=q.Id,UserOrGroupId=result.getId());
