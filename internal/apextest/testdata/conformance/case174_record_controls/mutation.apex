Id uid=UserInfo.getUserId();String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<Object> out=new List<Object>();List<SObject> a=Database.query(q,AccessLevel.USER_MODE);out.add(a[0].getSObject('UserRecordAccess').get('HasAllAccess'));Order o=[SELECT Id,Description FROM Order WHERE OwnerId=:uid LIMIT 1];o.Description='changed';update o;List<SObject> b=Database.query(q,AccessLevel.USER_MODE);out.add(b[0].getSObject('UserRecordAccess').get('HasAllAccess'));System.debug('R6MUTATE|'+JSON.serialize(out));