Id uid=UserInfo.getUserId();String f='UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel';List<Object> out=new List<Object>();for(String direction:new List<String>{'=','!=','=','!='}){String q='SELECT '+f+' FROM Order WHERE OwnerId '+direction+' :uid';List<SObject> z=Database.query(q,AccessLevel.USER_MODE);SObject a=z[0].getSObject('UserRecordAccess');out.add(new List<Object>{direction,a.get('HasAllAccess'),a.get('MaxAccessLevel')});}System.debug('R6RECORDS|'+JSON.serialize(out));
