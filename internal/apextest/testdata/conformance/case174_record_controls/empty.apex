Id uid=UserInfo.getUserId();Order o=[SELECT Id,OwnerId FROM Order WHERE OwnerId=:uid LIMIT 1];Id other=[SELECT OwnerId FROM Order WHERE OwnerId != :uid LIMIT 1].OwnerId;o.OwnerId=other;update o;String q='SELECT UserRecordAccess.HasReadAccess,UserRecordAccess.HasEditAccess,UserRecordAccess.HasDeleteAccess,UserRecordAccess.HasTransferAccess,UserRecordAccess.HasAllAccess,UserRecordAccess.MaxAccessLevel FROM Order WHERE OwnerId = :uid';List<Object> out=new List<Object>();List<SObject> a=Database.query(q,AccessLevel.USER_MODE);out.add(a.size());o.OwnerId=uid;update o;List<SObject> b=Database.query(q,AccessLevel.USER_MODE);SObject x=b[0].getSObject('UserRecordAccess');out.add(x.get('HasAllAccess'));List<SObject> c=Database.query(q,AccessLevel.USER_MODE);out.add(c[0].getSObject('UserRecordAccess').get('HasAllAccess'));System.debug('R6EMPTY|'+JSON.serialize(out));