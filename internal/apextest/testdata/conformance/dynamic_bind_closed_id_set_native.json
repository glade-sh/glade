    "OwnedClosedIdSetObserver": "public class OwnedClosedIdSetObserver {\n public static String observe(String row){\n  Map<String,Object> result=new Map<String,Object>();Savepoint mark=Database.setSavepoint();\n  try{\n   Account seed=new Account(Name='Owned Closed Bind Target');insert seed;String query;\n   if(row=='CB01'||row=='CB04'){\n    if(query==null){Set<Id> selected=new Set<Id>{seed.Id};query='SELECT COUNT() FROM Account WHERE Id IN :selected';}\n    result.put('count',row=='CB04'?helper(query):Database.countQuery(query));\n   }else if(row=='CB02'){\n    Set<Id> selected=new Set<Id>{seed.Id};query='SELECT COUNT() FROM Account WHERE Id IN :selected';result.put('count',Database.countQuery(query));\n   }else if(row=='CB03'){\n    if(query==null){String wanted='Owned Closed Bind Target';query='SELECT COUNT() FROM Account WHERE Name = :wanted';}\n    result.put('count',Database.countQuery(query));\n   }else{\n    Integer count;\n    if(query==null){Set<Id> selected=new Set<Id>{seed.Id};query='SELECT COUNT() FROM Account WHERE Id IN :selected';count=Database.countQuery(query);}\n    result.put('count',count);\n   }\n   result.put('outcome','returned');\n  }catch(Exception issue){result.put('outcome','threw');result.put('type',issue.getTypeName());}\n  finally{Database.rollback(mark);}\n  return JSON.serialize(result);\n }\n private static Integer helper(String query){return Database.countQuery(query);}\n}\n",
    "OwnedClosedIdSetTest": "@IsTest private class OwnedClosedIdSetTest {\n @IsTest static void cb01(){System.assert(false,'STORE_BOUNDARY|CB01|'+OwnedClosedIdSetObserver.observe('CB01'));}\n @IsTest static void cb02(){System.assert(false,'STORE_BOUNDARY|CB02|'+OwnedClosedIdSetObserver.observe('CB02'));}\n @IsTest static void cb03(){System.assert(false,'STORE_BOUNDARY|CB03|'+OwnedClosedIdSetObserver.observe('CB03'));}\n @IsTest static void cb04(){System.assert(false,'STORE_BOUNDARY|CB04|'+OwnedClosedIdSetObserver.observe('CB04'));}\n @IsTest static void cb05(){System.assert(false,'STORE_BOUNDARY|CB05|'+OwnedClosedIdSetObserver.observe('CB05'));}\n}\n"
