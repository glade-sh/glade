@IsTest static void implicit_block_unchanged_keyword(){insert new Contact(LastName='Block',Email='same@example.invalid',RouteKey__c='block');Contact t=new Contact(LastName='Safe',Email='same@example.invalid',RouteKey__c='target'); insert t;Contact r=new Contact(LastName='Block',Email='same@example.invalid');r.Id=t.Id;String status='ok';try{upsert r;}catch(DmlException e){status=String.valueOf(e.getDmlStatusCode(0));} String stored=t==null?'none':[SELECT LastName FROM Contact WHERE Id=:t.Id].LastName;System.assert(false,'OBSERVED|implicit_block_unchanged_keyword|'+status+'|'+(r.Id==null?'null':'id')+'|'+stored);}
