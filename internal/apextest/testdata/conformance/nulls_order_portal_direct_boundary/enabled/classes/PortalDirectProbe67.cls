@IsTest private class PortalDirectProbe67 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{List<Account> parents=new List<Account>{new Account(Name='Synthetic A'),new Account(Name='Synthetic B')};UserRole ownerRole=new UserRole(Name='Synthetic owner');insert ownerRole;User running=new User(Id=UserInfo.getUserId(),UserRoleId=ownerRole.Id);Database.DMLOptions options=new Database.DMLOptions();options.EmailHeader.triggerUserEmail=false;running.setOptions(options);update running;System.runAs(running){insert parents;for(Account a:parents)a.IsPartner=true;update parents;}List<UserRole> roles=new List<UserRole>();for(Integer i=0;i<3;i++){UserRole r=new UserRole(Name='Synthetic '+i);if(i>0){r.put('PortalAccountId',parents[i-1].Id);r.put('PortalType','Partner');}roles.add(r);}Database.SaveResult[] saves=Database.insert(roles,false);List<String> states=new List<String>();for(Database.SaveResult r:saves)states.add(r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(130));out.put('inserts',states);if(saves[0].isSuccess()&&saves[1].isSuccess()&&saves[2].isSuccess()){Set<Id> ids=new Set<Id>{saves[0].getId(),saves[1].getId(),saves[2].getId()};List<SObject> saved=Database.query('SELECT PortalAccountId FROM UserRole WHERE Id IN :ids');Set<String> vals=new Set<String>();Boolean nullSeen=false;for(SObject r:saved){Object v=r.get('PortalAccountId');if(v==null)nullSeen=true;else vals.add(String.valueOf(v));}out.put('savedNull',nullSeen);out.put('distinct',vals.size());List<String> sorted=new List<String>(vals);sorted.sort();if(nullSeen&&sorted.size()==2)for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT PortalAccountId FROM UserRole WHERE Id IN :ids ORDER BY PortalAccountId '+tail);String order='';for(SObject r:found){Object v=r.get('PortalAccountId');order+=v==null?'N':String.valueOf(v)==sorted[0]?'L':'H';}out.put(tail,order);}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|PortalDirect|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }