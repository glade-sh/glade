    "OwnedStoreBoundaryObserver": "public class OwnedStoreBoundaryObserver {\n public static String observe(String row) {\n  Map<String,Object> result=new Map<String,Object>();\n  if(row=='WS01'){\n   Schema.SObjectType token=Schema.getGlobalDescribe().get('WebStore');\n   result.put('objectPresent',token!=null);\n   Map<String,Object> seen=new Map<String,Object>();\n   if(token!=null){\n    Schema.DescribeSObjectResult objectInfo=token.getDescribe();\n    result.put('createable',objectInfo.isCreateable());result.put('updateable',objectInfo.isUpdateable());\n    Map<String,Schema.SObjectField> fields=new Map<String,Schema.SObjectField>();\n    for(Schema.SObjectField field:objectInfo.fields.getMap().values())fields.put(field.getDescribe().getName().toLowerCase(),field);\n    for(String name:new List<String>{'OptionsAutoFacetingEnabled','OptionsCartAsyncProcessingEnabled','OptionsCartCalculateEnabled','OptionsCartToOrderAutoCustomFieldMapping','OptionsCommerceEinsteinActivitiesTracked','OptionsCommerceEinsteinDeployed','OptionsDuplicateCartItemsEnabled','OptionsGuestBrowsingEnabled','OptionsGuestCartEnabled','OptionsGuestCheckoutEnabled','OptionsPreserveGuestCartEnabled','OptionsSkipAdditionalEntitlementCheckForSearch','OptionsSkuDetectionEnabled','OptionsSplitShipmentEnabled'}){\n     Map<String,Object> item=new Map<String,Object>{'present'=>fields.containsKey(name.toLowerCase())};\n     if(fields.containsKey(name.toLowerCase())){Schema.DescribeFieldResult info=fields.get(name.toLowerCase()).getDescribe();item.put('type',String.valueOf(info.getType()));item.put('createable',info.isCreateable());item.put('updateable',info.isUpdateable());}\n     seen.put(name,item);\n    }\n   }\n   result.put('fields',seen);return JSON.serialize(result);\n  }\n  if(row=='BP01'){\n   Object boxed=Test.getStandardPricebookId();\n   String direct=String.valueOf(Test.getStandardPricebookId());\n   String viaId=convert(Test.getStandardPricebookId());\n   result.put('directLength',direct.length());result.put('viaIdLength',viaId.length());result.put('sameText',direct==viaId);\n   result.put('prefix',direct.left(3));result.put('idInstance',boxed instanceof Id);result.put('stringInstance',boxed instanceof String);\n   return JSON.serialize(result);\n  }\n  String plain='01s000000000001';String direct=String.valueOf(plain);String viaId=convert((Id)plain);\n  result.put('directLength',direct.length());result.put('viaIdLength',viaId.length());result.put('sameText',direct==viaId);result.put('plainPreserved',plain==direct);\n  return JSON.serialize(result);\n }\n private static String convert(Id value){return String.valueOf(value);}\n}\n",
    "OwnedStoreBoundaryTest": "@IsTest private class OwnedStoreBoundaryTest {\n @IsTest static void ws01(){System.assert(false,'STORE_BOUNDARY|WS01|'+OwnedStoreBoundaryObserver.observe('WS01'));}\n @IsTest static void bp01(){System.assert(false,'STORE_BOUNDARY|BP01|'+OwnedStoreBoundaryObserver.observe('BP01'));}\n @IsTest static void bp02(){System.assert(false,'STORE_BOUNDARY|BP02|'+OwnedStoreBoundaryObserver.observe('BP02'));}\n}\n"
