public class DerivedTraversalProbe {
public static Map<String,Object> listAlias() { List<Integer> original = new List<Integer>{1,2}; List<Integer> derived = original; Integer visited=0; for(Integer value: original) { visited++; derived.remove(0); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> listCopy() { List<Integer> original = new List<Integer>{1,2}; List<Integer> derived = new List<Integer>(original); Integer visited=0; for(Integer value: original) { visited++; derived.remove(0); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> setAlias() { Set<Integer> original = new Set<Integer>{1,2}; Set<Integer> derived = original; Integer visited=0; for(Integer value: original) { visited++; derived.remove(value); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> setCopy() { Set<Integer> original = new Set<Integer>{1,2}; Set<Integer> derived = new Set<Integer>(original); Integer visited=0; for(Integer value: original) { visited++; derived.remove(value); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> keysAlias() { Map<Integer,String> owner = new Map<Integer,String>{1=>'one',2=>'two'}; Set<Integer> original = owner.keySet(); Set<Integer> derived = original; Integer visited=0; for(Integer value: original) { visited++; derived.remove(value); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> keysCopy() { Map<Integer,String> owner = new Map<Integer,String>{1=>'one',2=>'two'}; Set<Integer> original = owner.keySet(); Set<Integer> derived = new Set<Integer>(original); Integer visited=0; for(Integer value: original) { visited++; derived.remove(value); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> valuesAlias() { Map<String,Integer> owner = new Map<String,Integer>{'one'=>1,'two'=>2}; List<Integer> original = owner.values(); List<Integer> derived = original; Integer visited=0; for(Integer value: original) { visited++; derived.remove(0); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> valuesCopy() { Map<String,Integer> owner = new Map<String,Integer>{'one'=>1,'two'=>2}; List<Integer> original = owner.values(); List<Integer> derived = new List<Integer>(original); Integer visited=0; for(Integer value: original) { visited++; derived.remove(0); } return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size(),'visited'=>visited}; }
public static Map<String,Object> listCopyEmpty() { List<Integer> original=new List<Integer>(); List<Integer> derived=new List<Integer>(original); for(Integer value:original){derived.add(value);} return new Map<String,Object>{'original'=>original.size(),'derived'=>derived.size()}; }
public static Map<String,Object> mapKeyFreshView() { Map<Integer,String> original=new Map<Integer,String>{1=>'one',2=>'two'}; Integer visited=0; for(Integer value:original.keySet()){visited++; Set<Integer> derived=original.keySet(); derived.remove(value);} return new Map<String,Object>{'original'=>original.size(),'visited'=>visited}; }
public static Map<String,Object> mapValuesFreshView() { Map<String,Integer> original=new Map<String,Integer>{'one'=>1,'two'=>2}; Integer visited=0; for(Integer value:original.values()){visited++; List<Integer> derived=original.values(); derived.remove(0);} return new Map<String,Object>{'original'=>original.size(),'visited'=>visited}; }
}
