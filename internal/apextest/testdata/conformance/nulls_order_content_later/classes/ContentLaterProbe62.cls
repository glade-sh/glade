@IsTest private class ContentLaterProbe62 { @IsTest static void probe(){Map<String,Object> out=new Map<String,Object>();try{List<Account> parents=new List<Account>{new Account(Name='Synthetic A'),new Account(Name='Synthetic B')};insert parents;List<ContentVersion> first=new List<ContentVersion>();for(Integer i=0;i<2;i++)first.add(new ContentVersion(Title='Synthetic '+i,PathOnClient='stub.txt',VersionData=Blob.valueOf('synthetic'),FirstPublishLocationId=parents[i].Id));insert first;List<ContentVersion> saved=[SELECT Id,ContentDocumentId FROM ContentVersion WHERE Id IN :first ORDER BY Title];ContentVersion later=new ContentVersion(Title='Synthetic later',PathOnClient='stub.txt',VersionData=Blob.valueOf('synthetic later'),ContentDocumentId=saved[0].ContentDocumentId);Database.SaveResult r=Database.insert(later,false);out.put('laterInsert',r.isSuccess()?'OK':String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage().left(140));if(r.isSuccess()){Set<Id> ids=new Set<Id>{first[0].Id,first[1].Id,later.Id};List<ContentVersion> all=[SELECT Id,FirstPublishLocationId FROM ContentVersion WHERE Id IN :ids];Set<String> vals=new Set<String>();Boolean nullSeen=false;for(ContentVersion v:all){if(v.FirstPublishLocationId==null)nullSeen=true;else vals.add(String.valueOf(v.FirstPublishLocationId));}out.put('savedNull',nullSeen);out.put('distinct',vals.size());List<String> sorted=new List<String>(vals);sorted.sort();if(nullSeen&&sorted.size()==2)for(String tail:new List<String>{'ASC','DESC','ASC NULLS FIRST','ASC NULLS LAST','DESC NULLS FIRST','DESC NULLS LAST'}){List<SObject> found=Database.query('SELECT FirstPublishLocationId FROM ContentVersion WHERE Id IN :ids ORDER BY FirstPublishLocationId '+tail);String order='';for(SObject v:found){Object x=v.get('FirstPublishLocationId');order+=x==null?'N':String.valueOf(x)==sorted[0]?'L':'H';}out.put(tail,order);}}}catch(Exception e){out.put('exceptionType',e.getTypeName());out.put('exceptionMessage',e.getMessage().left(150));}System.assert(false,'CAPTURE|ContentLater|'+JSON.serialize(new Map<String,Object>{'rows'=>out}));} }