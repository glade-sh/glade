<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <label>Linden_Lookup_67</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Dec_Found</name><label>Dec Found</label>
        <locationX>50</locationX><locationY>300</locationY>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>Acct_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>Get_Acct.Id</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Upd_Acct</targetReference></connector>
            <label>Acct Found</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Acct</name><label>Get Acct</label>
        <locationX>50</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Dec_Found</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Name</field><operator>EqualTo</operator><value><elementReference>$Record.LastName</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Upd_Acct</name><label>Upd Acct</label><locationX>50</locationX><locationY>400</locationY>
        <inputAssignments><field>AccountId</field><value><elementReference>Get_Acct.Id</elementReference></value></inputAssignments>
        <inputAssignments><field>Description</field><value><stringValue>acct_found</stringValue></value></inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX><locationY>0</locationY>
        <connector><targetReference>Get_Acct</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>FirstName</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
