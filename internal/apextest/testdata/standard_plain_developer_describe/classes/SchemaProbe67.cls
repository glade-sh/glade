public class SchemaProbe67 {
 public static String context() { return 'test:'+Test.isRunningTest()+'|userType:'+UserInfo.getUserType()+'|locale:'+UserInfo.getLocale()+'|tz:'+UserInfo.getTimeZone().getID(); }
 public static String names(String obj,Integer part) { Schema.SObjectType typ=Schema.getGlobalDescribe().get(obj); if(typ==null)return context()+'|object:'+obj+'|absent|end'; List<String> fields=new List<String>();fields.addAll(typ.getDescribe().fields.getMap().keySet());fields.sort();Integer start=part*30;List<String> slice=new List<String>();for(Integer i=start;i<fields.size() && i<start+30;i++)slice.add(fields[i]);return context()+'|object:'+obj+'|part:'+part+'|total:'+fields.size()+'|fields:'+String.join(slice,',')+'|end'; }
 public static String safeDefault(Schema.DescribeFieldResult f) { Object v=f.getDefaultValue(); if(v==null)return 'null'; if(v instanceof Boolean || v instanceof Integer || v instanceof Decimal || v instanceof Long || v instanceof Double)return 'scalar:'+String.valueOf(v);return 'nonNull-redacted'; }
 public static String signature(String obj,String field) { Map<String,Schema.SObjectField> all=Schema.getGlobalDescribe().get(obj).getDescribe().fields.getMap();if(!all.containsKey(field))return field+':absent';Schema.DescribeFieldResult f=all.get(field).getDescribe();List<String> picks=new List<String>();for(Schema.PicklistEntry e:f.getPicklistValues())picks.add(e.getValue()+':active='+e.isActive()+':default='+e.isDefaultValue());return field+':type='+f.getType()+':length='+f.getLength()+':nillable='+f.isNillable()+':defaulted='+f.isDefaultedOnCreate()+':default='+safeDefault(f)+':accessible='+f.isAccessible()+':create='+f.isCreateable()+':update='+f.isUpdateable()+':pick=['+String.join(picks,',')+']'; }
 public static String selected(String obj,String groupName) { Map<String,List<String>> core=new Map<String,List<String>>{'Account'=>new List<String>{'Id','Name','OwnerId','ParentId','AccountNumber','IsPersonAccount'},'Contact'=>new List<String>{'Id','Name','FirstName','LastName','AccountId','IndividualId'},'Case'=>new List<String>{'Id','CaseNumber','Subject','OwnerId','Language','Division'},'Lead'=>new List<String>{'Id','Name','LastName','Company','OwnerId','IndividualId'},'Opportunity'=>new List<String>{'Id','Name','CloseDate','Amount','OwnerId','LastSyncTime'}};Map<String,List<String>> pick=new Map<String,List<String>>{'Account'=>new List<String>{'Type','Industry'},'Contact'=>new List<String>{'LeadSource'},'Case'=>new List<String>{'Status','Origin','Language','Division'},'Lead'=>new List<String>{'Status','LeadSource'},'Opportunity'=>new List<String>{'StageName','Type'}};List<String> fields=groupName=='core'?core.get(obj):pick.get(obj);if(groupName!='core'){Integer mid=(fields.size()+1)/2;Integer lo=groupName=='pickA'?0:mid;Integer hi=groupName=='pickA'?mid:fields.size();List<String> subset=new List<String>();for(Integer i=lo;i<hi;i++)subset.add(fields[i]);fields=subset;}List<String> out=new List<String>();for(String field:fields)out.add(signature(obj,field));return context()+'|object:'+obj+'|group:'+groupName+'|signatures:'+String.join(out,';')+'|end'; }
}