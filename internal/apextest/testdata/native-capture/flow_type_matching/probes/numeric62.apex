insert new List<Account>{new Account(Name='Flow Numeric Match A',AccountNumber='42'),new Account(Name='Flow Numeric Match B',AccountNumber='true')};
try { Flow.Interview f=Flow.Interview.createInterview('F62InAccountNumberNumber',new Map<String,Object>{'values'=>new List<Decimal>{42}}); f.start(); System.debug('OBS|F62InAccountNumberNumber|'+String.valueOf(f.getVariableValue('outcome'))); } catch(Exception e) { System.debug('OBS|F62InAccountNumberNumber|ERROR:'+e.getTypeName()); }
try { Flow.Interview f=Flow.Interview.createInterview('F62InAccountNumberBoolean',new Map<String,Object>{'values'=>new List<Boolean>{true}}); f.start(); System.debug('OBS|F62InAccountNumberBoolean|'+String.valueOf(f.getVariableValue('outcome'))); } catch(Exception e) { System.debug('OBS|F62InAccountNumberBoolean|ERROR:'+e.getTypeName()); }
