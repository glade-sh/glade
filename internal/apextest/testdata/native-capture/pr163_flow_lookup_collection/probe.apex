Account a = new Account(Name='Capture Collection Seed A'); Account b = new Account(Name='Capture Collection Seed B'); insert new List<Account>{a,b};
for(String op : new List<String>{'In','NotIn'}) { for(String mode : new List<String>{'populated','empty','unassigned'}) { Map<String,Object> input = new Map<String,Object>(); if(mode == 'populated') input.put('ids', new List<String>{String.valueOf(b.Id)}); if(mode == 'empty') input.put('ids', new List<String>()); Flow.Interview f = Flow.Interview.createInterview('Capture_Filter_'+op,input); try { f.start(); System.debug('CAPTURE|'+op+'|'+mode+'|'+String.valueOf(f.getVariableValue('outcome'))); } catch(Exception ex) { System.debug('CAPTURE|'+op+'|'+mode+'|ERROR|'+ex.getMessage()); } } }
