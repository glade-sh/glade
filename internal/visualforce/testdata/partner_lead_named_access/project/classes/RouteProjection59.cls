public without sharing class RouteProjection59 { public String getObservation() { User u=[SELECT Id FROM User WHERE Alias='rtprt' LIMIT 1]; Lead a=[SELECT Id FROM Lead WHERE LastName='Route First' LIMIT 1]; Lead b=[SELECT Id FROM Lead WHERE LastName='Route Second' LIMIT 1]; List<UserRecordAccess> x=[SELECT RecordId,HasReadAccess,HasEditAccess FROM UserRecordAccess WHERE UserId=:u.Id AND RecordId=:a.Id]; List<UserRecordAccess> y=[SELECT RecordId,HasReadAccess,HasEditAccess FROM UserRecordAccess WHERE UserId=:u.Id AND RecordId=:b.Id]; return 'OBS|first='+x.size()+':'+(x.isEmpty()?'missing':String.valueOf(x[0].HasReadAccess))+':'+(x.isEmpty()?'missing':String.valueOf(x[0].HasEditAccess))+'|second='+y.size()+':'+(y.isEmpty()?'missing':String.valueOf(y[0].HasReadAccess))+':'+(y.isEmpty()?'missing':String.valueOf(y[0].HasEditAccess)); } }