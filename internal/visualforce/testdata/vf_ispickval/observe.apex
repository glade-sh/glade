Map<String,Id> ids = new Map<String,Id>();
for (List<String> item : new List<List<String>>{new List<String>{'PickProbe_user_match','-','-'},new List<String>{'PickProbe_user_nomatch','-','-'},new List<String>{'PickProbe_user_case_lower','-','-'},new List<String>{'PickProbe_user_case_upper','-','-'},new List<String>{'PickProbe_user_empty','-','-'},new List<String>{'PickProbe_user_padded','-','-'},new List<String>{'PickProbe_user_notavalue','-','-'},new List<String>{'PickProbe_profile_match','-','-'},new List<String>{'PickProbe_profile_nomatch','-','-'},new List<String>{'PickProbe_user_locale_match','-','-'},new List<String>{'PickProbe_user_locale_case','-','-'},new List<String>{'PickProbe_user_timezone_match','-','-'},new List<String>{'PickProbe_user_language_match','-','-'},new List<String>{'PickProbe_user_geocode_null_empty','-','-'},new List<String>{'PickProbe_user_geocode_null_value','-','-'},new List<String>{'PickProbe_user_startday','-','-'},new List<String>{'PickProbe_user_dquote','-','-'},new List<String>{'PickProbe_lower_name','-','-'},new List<String>{'PickProbe_mixed_name','-','-'},new List<String>{'PickProbe_space_before_paren','-','-'},new List<String>{'PickProbe_in_if','-','-'},new List<String>{'PickProbe_in_if_false','-','-'},new List<String>{'PickProbe_in_not','-','-'},new List<String>{'PickProbe_in_and','-','-'},new List<String>{'PickProbe_in_or','-','-'},new List<String>{'PickProbe_in_and_op','-','-'},new List<String>{'PickProbe_in_or_op','-','-'},new List<String>{'PickProbe_in_bang','-','-'},new List<String>{'PickProbe_in_equals','-','-'},new List<String>{'PickProbe_in_concat','-','-'},new List<String>{'PickProbe_in_nested_if','-','-'},new List<String>{'PickProbe_text_contrast','-','-'},new List<String>{'PickProbe_text_contrast_null','-','-'},new List<String>{'PickProbe_text_eq','-','-'},new List<String>{'PickProbe_rendered_true','-','-'},new List<String>{'PickProbe_rendered_false','-','-'},new List<String>{'PickProbe_rendered_null','-','-'},new List<String>{'PickProbe_rendered_not','-','-'},new List<String>{'PickProbe_outputtext_value','-','-'},new List<String>{'PickProbe_msg_channel_valid','-','-'},new List<String>{'PickProbe_msg_channel_script','-','-'},new List<String>{'PickProbe_msg_channel_lower','-','-'},new List<String>{'PickProbe_msg_channel_in_if','-','-'},new List<String>{'PickProbe_msg_channel_twice','-','-'},new List<String>{'PickProbe_user_endday','-','-'},new List<String>{'PickProbe_user_usertype_lang_case','-','-'},new List<String>{'PickProbe_msg_channel_name_case','-','-'}}) {
 String url = '/apex/' + item[0];
 if (ids.containsKey(item[1] + '|' + item[2])) url += '?id=' + ids.get(item[1] + '|' + item[2]);
 String body;
 try { body = new PageReference(url).getContent().toString(); } catch (Exception e) { System.debug('PICKROW|' + item[0] + '|EXC|' + EncodingUtil.base64Encode(Blob.valueOf(e.getTypeName() + ': ' + e.getMessage()))); continue; }
 System.debug('PICKROW|' + item[0] + '|RAW|' + EncodingUtil.base64Encode(Blob.valueOf(body)));
 if (item[0].contains('msg_channel')) { System.debug('PICKROW|' + item[0] + '#2|RAW|' + EncodingUtil.base64Encode(Blob.valueOf(new PageReference(url).getContent().toString()))); }
}
