@IsTest(SeeAllData=true) private class B6CustomContact67 { @IsTest static void observed(){Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Contact' LIMIT 1];Reports.ReportTypeMetadata m=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata();String s='categories='+m.getCategories().size();for(Reports.ReportTypeColumnCategory c:m.getCategories()){for(String k:c.getColumns().keySet()){if(k.toUpperCase().contains('B6_')){Reports.ReportTypeColumn v=c.getColumns().get(k);s+='|'+c.getLabel()+'~'+k+'~'+v.getName()+'~'+v.getLabel()+'~'+v.getDataType()+'~'+v.getFilterable();}}}System.assert(false,s);} }