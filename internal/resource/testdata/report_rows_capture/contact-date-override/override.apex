String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){List<List<String>> specs=new List<List<String>>{new List<String>{'inside','2000-01-01','2100-01-01'},new List<String>{'future','2099-01-01','2100-01-01'},new List<String>{'open',null,null},new List<String>{'invalid','not-date','2100-01-01'},new List<String>{'badend','2000-01-01','bad-end'},new List<String>{'reversed','2100-01-01','2000-01-01'}};for(List<String> q:specs){try{Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();m.setStandardDateFilter(new Reports.StandardDateFilter('CREATED_DATE','CUSTOM',q[1],q[2]));Reports.ReportResults x=Reports.ReportManager.runReport(r.Id,m,false);Reports.StandardDateFilter d=x.getReportMetadata().getStandardDateFilter();s+=r.DeveloperName+':'+q[0]+':ok:'+d.getStartDate()+':'+d.getEndDate()+':'+x.getFactMap().get('T!T').getAggregates()[0].getValue()+';';}catch(Exception e){s+=r.DeveloperName+':'+q[0]+':error:'+e.getTypeName()+':'+e.getMessage()+';';}}}System.debug('B6COVER|'+s);
