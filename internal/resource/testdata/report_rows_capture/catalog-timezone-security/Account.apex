Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Account' LIMIT 1];Reports.ReportTypeMetadata m=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata();String s=m.getCategories().size()+'~'+m.getCategories()[0].getLabel()+'~'+m.getScopeInfo().getDefaultValue()+'~'+m.getScopeInfo().getValues().size();System.debug('B6CATSUM|'+s);System.debug('B6CATJSON|'+JSON.serialize(m));