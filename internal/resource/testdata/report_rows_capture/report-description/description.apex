String x='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();Reports.ReportResults y=Reports.ReportManager.runReport(r.Id,false);x+=r.DeveloperName+':'+JSON.serialize(m.getDescription())+':'+JSON.serialize(y.getReportMetadata().getDescription())+';';}System.debug('B6DESC|'+x);
