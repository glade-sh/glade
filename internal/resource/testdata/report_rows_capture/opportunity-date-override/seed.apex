User u=[SELECT Id FROM User WHERE Alias='b6opp' LIMIT 1];Account a=new Account(Name='B6 Parent');insert a;insert new List<Opportunity>{new Opportunity(Name='B6 Own',AccountId=a.Id,StageName='Prospecting',CloseDate=Date.today()),new Opportunity(Name='B6 Other',AccountId=a.Id,OwnerId=u.Id,StageName='Prospecting',CloseDate=Date.today()),new Opportunity(Name='B6 Outside Quarter',AccountId=a.Id,StageName='Prospecting',CloseDate=Date.today().addMonths(7))};
