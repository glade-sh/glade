String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName IN ('B6_TabAbsent','B6_SumAbsent') ORDER BY DeveloperName]){Reports.ReportResults a=Reports.ReportManager.runReport(r.Id,false);Reports.ReportResults b=Reports.ReportManager.runReport(r.Id,true);s+=r.DeveloperName+':'+(r.DeveloperName=='B6_TabAbsent'?JSON.serialize(a.getGroupingsDown()):'populated')+':'+JSON.serialize(a.getGroupingsAcross())+':'+(r.DeveloperName=='B6_TabAbsent'?JSON.serialize(b.getGroupingsDown()):'populated')+':'+JSON.serialize(b.getGroupingsAcross())+';';}System.debug('B6DIMJSON|'+s);
