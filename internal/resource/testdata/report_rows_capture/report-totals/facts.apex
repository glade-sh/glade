String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportResults a=Reports.ReportManager.runReport(r.Id,false);Reports.ReportResults b=Reports.ReportManager.runReport(r.Id,true);List<String> x=new List<String>(a.getFactMap().keySet());List<String> y=new List<String>(b.getFactMap().keySet());x.sort();y.sort();Integer groups=a.getGroupingsDown()==null?-1:a.getGroupingsDown().getGroupings().size();s+=r.DeveloperName+':'+String.join(x,',')+':'+String.join(y,',')+':'+a.getFactMap().get('T!T').getAggregates()[0].getValue()+':'+groups+';';}System.debug('B6FACT|'+s);
