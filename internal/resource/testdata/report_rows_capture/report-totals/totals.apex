String x='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();Reports.ReportResults y=Reports.ReportManager.runReport(r.Id,false);x+=r.DeveloperName+':'+m.getShowGrandTotal()+':'+m.getShowSubtotals()+':'+y.getReportMetadata().getShowGrandTotal()+':'+y.getReportMetadata().getShowSubtotals()+';';}System.debug('B6TOTAL|'+x);
