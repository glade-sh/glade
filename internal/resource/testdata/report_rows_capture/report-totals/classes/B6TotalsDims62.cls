@IsTest(SeeAllData=true) private class B6TotalsDims62 { @IsTest static void observed(){String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportResults a=Reports.ReportManager.runReport(r.Id,false);Reports.ReportResults b=Reports.ReportManager.runReport(r.Id,true);Integer ad=a.getGroupingsDown()==null?-1:a.getGroupingsDown().getGroupings().size();Integer aa=a.getGroupingsAcross()==null?-1:a.getGroupingsAcross().getGroupings().size();Integer bd=b.getGroupingsDown()==null?-1:b.getGroupingsDown().getGroupings().size();Integer ba=b.getGroupingsAcross()==null?-1:b.getGroupingsAcross().getGroupings().size();s+=r.DeveloperName+':'+ad+':'+aa+':'+bd+':'+ba+';';}System.assert(false,s);} }