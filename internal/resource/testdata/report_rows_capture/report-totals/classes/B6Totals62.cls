@IsTest(SeeAllData=true) private class B6Totals62 { @IsTest static void observed(){String x='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();Reports.ReportResults y=Reports.ReportManager.runReport(r.Id,false);x+=r.DeveloperName+':'+m.getShowGrandTotal()+':'+m.getShowSubtotals()+':'+y.getReportMetadata().getShowGrandTotal()+':'+y.getReportMetadata().getShowSubtotals()+';';}System.assert(false,x);} }