@IsTest(SeeAllData=true) private class B6PartialContact67 { @IsTest static void check(){Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Contact' LIMIT 1];Reports.ReportTypeMetadata m=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata();String s='';for(Reports.ReportTypeColumnCategory c:m.getCategories()){if(c.getLabel().endsWith('Custom Info')){List<String> keys=new List<String>(c.getColumns().keySet());keys.sort();s+=c.getLabel()+'~'+String.join(keys,',')+';';}}System.assert(false,s);} }