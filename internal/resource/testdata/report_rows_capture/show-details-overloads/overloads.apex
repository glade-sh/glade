String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();List<Reports.ReportResults> a=new List<Reports.ReportResults>{Reports.ReportManager.runReport(r.Id),Reports.ReportManager.runReport(r.Id,false),Reports.ReportManager.runReport(r.Id,true),Reports.ReportManager.runReport(r.Id,m),Reports.ReportManager.runReport(r.Id,m,false),Reports.ReportManager.runReport(r.Id,m,true)};s+=r.DeveloperName+':'+m.getHasDetailRows();for(Reports.ReportResults x:a)s+=':'+x.getHasDetailRows()+','+x.getReportMetadata().getHasDetailRows();s+=';';}System.debug('B6OVER|'+s);
