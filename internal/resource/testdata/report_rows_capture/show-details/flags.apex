for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName IN ('B6_True','B6_False','B6_Absent') ORDER BY DeveloperName]) { Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata(); Reports.ReportResults no=Reports.ReportManager.runReport(r.Id,false); Reports.ReportResults yes=Reports.ReportManager.runReport(r.Id,true); System.debug('B6FLAGS|'+r.DeveloperName+'|'+JSON.serialize(m)+'|'+no.getHasDetailRows()+'|'+yes.getHasDetailRows()); }
