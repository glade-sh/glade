Account a=[SELECT Id FROM Account WHERE Name='B6 First' LIMIT 1];insert new List<Opportunity>{new Opportunity(Name='B6 Negative',AccountId=a.Id,StageName='Prospecting',CloseDate=Date.today(),Amount=-123.45),new Opportunity(Name='B6 Zero Amount',AccountId=a.Id,StageName='Prospecting',CloseDate=Date.today(),Amount=0)};
