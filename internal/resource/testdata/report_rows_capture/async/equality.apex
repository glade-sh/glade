Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Accounts' LIMIT 1];Object v=Reports.ReportManager.runReport(r.Id,false).getFactMap().get('T!T').getAggregates()[0].getValue();try{System.assertEquals(1,v);System.debug('B6COUNTEQ|integer=true');}catch(Exception e){System.debug('B6COUNTEQ|integer=false');}try{System.assertEquals(1.0,v);System.debug('B6COUNTEQ|decimal=true');}catch(Exception e){System.debug('B6COUNTEQ|decimal=false');}
