Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Accounts' LIMIT 1];Object v=Reports.ReportManager.runReport(r.Id,false).getFactMap().get('T!T').getAggregates()[0].getValue();String out='decimal='+(v instanceof Decimal)+';integer='+(v instanceof Integer)+';value='+v;try{Integer n=(Integer)v;out+=';cast=ok';}catch(Exception e){out+=';cast='+e.getTypeName();}System.debug('B6COUNTTYPE|'+out);
