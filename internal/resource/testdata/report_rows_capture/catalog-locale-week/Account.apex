Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Account' LIMIT 1];Reports.ReportTypeMetadata m=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata();String s=m.getCategories().size()+'~'+m.getCategories()[0].getLabel()+'~'+m.getScopeInfo().getDefaultValue()+'~'+m.getScopeInfo().getValues().size();for(Reports.StandardDateFilterDurationGroup g:m.getStandardDateFilterDurationGroups()){for(Reports.StandardDateFilterDuration d:g.getStandardDateFilterDurations()){if(d.getValue()=='THIS_WEEK')s+='~'+d.getStartDate()+'~'+d.getEndDate();if(d.getValue()=='TODAY')s+='~'+d.getStartDate();}}System.debug('B6CATSUM|'+s);System.debug('B6CATJSON|'+JSON.serialize(m));