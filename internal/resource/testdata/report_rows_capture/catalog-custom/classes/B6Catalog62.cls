@IsTest(SeeAllData=true) private class B6Catalog62 { @IsTest static void observed(){Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Accounts' LIMIT 1];Reports.ReportTypeMetadata m=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata();String x='categories='+m.getCategories().size();for(Reports.ReportTypeColumnCategory c:m.getCategories()){for(String k:c.getColumns().keySet()){if(k.toUpperCase().contains('B6_SYNTHETIC')){Reports.ReportTypeColumn q=c.getColumns().get(k);x+='|'+c.getLabel()+':'+k+':'+q.getName()+':'+q.getLabel()+':'+q.getDataType()+':'+q.getFilterable();}}}System.assert(false,x);} }