@IsTest(SeeAllData=true) private class B6Bounds67 { @IsTest static void observed(){String x='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.StandardDateFilter d=Reports.ReportManager.describeReport(r.Id).getReportMetadata().getStandardDateFilter();Reports.ReportResults y=Reports.ReportManager.runReport(r.Id,false);x+=r.DeveloperName+':'+d.getStartDate()+':'+d.getEndDate()+':'+y.getFactMap().get('T!T').getAggregates()[0].getValue()+';';}System.assert(false,x);} }