@IsTest(SeeAllData=true) private class B6Picklist62 { @IsTest static void check(){Report r=[SELECT Id FROM Report WHERE DeveloperName='B6_Opportunity' LIMIT 1]; Reports.StandardFilterInfo f=Reports.ReportManager.describeReport(r.Id).getReportTypeMetadata().getStandardFilterInfos().get('open'); Object x=f; String s=String.valueOf(x instanceof Reports.StandardFilterInfoPicklist); if(x instanceof Reports.StandardFilterInfoPicklist){ Reports.StandardFilterInfoPicklist p=(Reports.StandardFilterInfoPicklist)x; s+='~'+p.getDefaultValue()+'~'+p.getFilterValues().size()+'~'+p.getLabel()+'~'+String.valueOf(p.getType()); } System.assert(false,s);} }