String s='';for(Report r:[SELECT Id,DeveloperName FROM Report WHERE DeveloperName LIKE 'B6_%' ORDER BY DeveloperName]){Reports.ReportMetadata m=Reports.ReportManager.describeReport(r.Id).getReportMetadata();Reports.StandardDateFilter d=m.getStandardDateFilter();Reports.ReportResults x=Reports.ReportManager.runReport(r.Id,false);s+=r.DeveloperName+':'+d.getColumn()+'~'+d.getDurationValue()+'~'+d.getStartDate()+'~'+d.getEndDate()+'~'+x.getFactMap().get('T!T').getAggregates()[0].getValue()+';';}System.debug('B6OPPTIME|'+s);