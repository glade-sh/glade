  "helperSource": "public class RichFacetProbe {\n public static Map<String,Object> run(){\n  Map<String,Object> result=new Map<String,Object>();\n  Map<String,Schema.SObjectType> objects=Schema.getGlobalDescribe();\n  for(String path:new List<String>{'CaseComment.CommentBodyRichtext','LiveChatTranscript.Body','Account.Description'}){\n   List<String> names=path.split('\\\\.');\n   Schema.SObjectType token=objects.get(names[0]);\n   Schema.SObjectField field=token==null ? null : token.getDescribe().fields.getMap().get(names[1]);\n   if(field==null){result.put(path,new Map<String,Object>{'available'=>false});}\n   else{Schema.DescribeFieldResult detail=field.getDescribe(); result.put(path,new Map<String,Object>{'available'=>true,'type'=>String.valueOf(detail.getType()),'htmlFormatted'=>detail.isHtmlFormatted(),'length'=>detail.getLength()});}\n  }\n  return result;\n }\n}\n",
