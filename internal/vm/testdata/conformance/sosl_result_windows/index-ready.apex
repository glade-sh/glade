List<List<SObject>> groups=Search.query('FIND {Copperwindow} IN NAME FIELDS RETURNING Account(Id,Name ORDER BY Name ASC),Contact(Id,LastName ORDER BY LastName ASC),Lead(Id,LastName ORDER BY LastName ASC)'); List<String> parts=new List<String>(); for(Integer i=0;i<groups.size();i++){List<String> members=new List<String>();for(SObject row:groups[i]) members.add(((String)row.get(i==0?'Name':'LastName')).substring(13));parts.add('['+String.join(members,',')+']');} System.debug('READY|'+String.join(parts,'/')+'|END');
