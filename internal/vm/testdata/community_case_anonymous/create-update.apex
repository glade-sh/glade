Case c=new Case(Subject='Route Case __API__',Status='New',Origin='Web'); List<String> out=new List<String>(); out.add('describe='+Case.SObjectType.getDescribe().isAccessible()+','+Case.SObjectType.getDescribe().isCreateable()+','+Case.SObjectType.getDescribe().isUpdateable()+','+Case.SObjectType.getDescribe().isDeletable()); try {insert as user c; out.add('insert=ok');} catch(Exception e) {out.add('insert='+e.getTypeName());} if(c.Id!=null){try{c.Subject='Changed __API__';update as user c;out.add('update=ok');}catch(Exception e){out.add('update='+e.getTypeName());}} System.debug('OBS|'+String.join(out,'|'));
