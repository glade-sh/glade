// Local omitted-default candidate; exact native stripping answers are pending.
@IsTest private class DefaultFieldScopeProbe {
 static User actor(Boolean assigned,Boolean write){Profile p=[SELECT Id FROM Profile WHERE Name='Standard User'];User u=new User(Username='parcel-field@example.invalid',Alias='parcel',Email='parcel-field@example.invalid',LastName='Parcel',ProfileId=p.Id,TimeZoneSidKey='America/Los_Angeles',LocaleSidKey='en_US',LanguageLocaleKey='en_US',EmailEncodingKey='UTF-8');insert u;if(assigned){String key=write?'ParcelWrite':'ParcelRead';PermissionSet ps=[SELECT Id FROM PermissionSet WHERE Name=:key];insert new PermissionSetAssignment(AssigneeId=u.Id,PermissionSetId=ps.Id);}return u;}
 static Map<String,Object> snapshot(ParcelEntry__c row){Map<String,Object> out=new Map<String,Object>();out.put('populated',row.getPopulatedFieldsAsMap().keySet());out.put('json',JSON.serialize(row));out.put('isSet',row.isSet('Ready__c'));out.put('value',row.Ready__c);out.put('createable',ParcelEntry__c.Ready__c.getDescribe().isCreateable());SObjectAccessDecision d=Security.stripInaccessible(AccessType.CREATABLE,new List<SObject>{row});out.put('removed',d.getRemovedFields());out.put('modified',d.getModifiedIndexes());out.put('returned',d.getRecords()[0].getPopulatedFieldsAsMap().keySet());out.put('original',row.getPopulatedFieldsAsMap().keySet());return out;}
 @IsTest static void candidateOmittedConstructorDoesNotReportUnsetField(){User u=actor(true,false);System.runAs(u){ParcelEntry__c row=new ParcelEntry__c(Name='Owned',Payload__c='value');System.assert(!row.getPopulatedFieldsAsMap().containsKey(ParcelEntry__c.Ready__c.getDescribe().getName()));System.assertEquals(0,Security.stripInaccessible(AccessType.CREATABLE,new List<SObject>{row}).getRemovedFields().size(),'Local omitted-default candidate');}}
 @IsTest static void explicitReadonlyControl(){User u=actor(true,false);System.runAs(u){for(Boolean flag:new List<Boolean>{false,true}){ParcelEntry__c row=new ParcelEntry__c(Name='Owned',Ready__c=flag);System.assertEquals(false,ParcelEntry__c.Ready__c.getDescribe().isCreateable());SObjectAccessDecision d=Security.stripInaccessible(AccessType.CREATABLE,new List<SObject>{row});System.assert(d.getRemovedFields().get(ParcelEntry__c.SObjectType.getDescribe().getName()).contains(ParcelEntry__c.Ready__c.getDescribe().getName()));}}}
 @IsTest static void assignedWriteControl(){User u=actor(true,true);System.runAs(u){ParcelEntry__c row=new ParcelEntry__c(Name='Owned',Ready__c=false);System.assertEquals(true,ParcelEntry__c.Ready__c.getDescribe().isCreateable());System.assertEquals(0,Security.stripInaccessible(AccessType.CREATABLE,new List<SObject>{row}).getRemovedFields().size());}}
 @IsTest static void unassignedControl(){User u=actor(false,false);System.runAs(u){System.assertEquals(false,ParcelEntry__c.SObjectType.getDescribe().isCreateable());System.assertEquals(false,ParcelEntry__c.Ready__c.getDescribe().isCreateable());try{Security.stripInaccessible(AccessType.CREATABLE,new List<SObject>{new ParcelEntry__c(Name='Owned',Ready__c=false)});System.assert(false,'No grant must deny root CRUD');}catch(System.NoAccessException expected){}}}
}
