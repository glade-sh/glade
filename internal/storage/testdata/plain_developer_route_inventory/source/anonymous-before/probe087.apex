List<String> ns = new List<String>{'Account','GladeMissingProbe__c','FulfillmentTaskAssignmentRule','FulfillmentTaskAssignmentRuleFeed','FulfillmentTaskAssignmentRuleHistory','FulfillmentTaskAssignmentRuleShare','FunctionConnection','FunctionInvocationRequest','FunctionReference','FundingAward','FundingAwardAmendment','FundingAwardAmendmentFeed','FundingAwardAmendmentHistory','FundingAwardFeed','FundingAwardHistory','FundingAwardParticipant','FundingAwardParticipantFeed','FundingAwardParticipantHistory','FundingAwardRequirement','FundingAwardRequirementFeed','FundingAwardRequirementHistory','FundingAwardRequirementShare'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
