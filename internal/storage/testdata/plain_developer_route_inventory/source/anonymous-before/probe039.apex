List<String> ns = new List<String>{'Account','GladeMissingProbe__c','CareEpisode','CareEpisodeDetail','CareFacilityBed','CareFeeScheduleItem','CareFeeScheduleItemFeed','CareFeeScheduleItemHistory','CareGap','CareInterventionType','CareInterventionTypeFeed','CareInterventionTypeHistory','CareInterventionTypeShare','CareLimitType','CareMetricTarget','CareMetricTargetFeed','CareMetricTargetHistory','CareMetricTargetShare','CareObservation','CareObservationComponent','CareObservationComponentFeed','CareObservationComponentHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
