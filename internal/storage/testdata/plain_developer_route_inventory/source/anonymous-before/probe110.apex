List<String> ns = new List<String>{'Account','GladeMissingProbe__c','InvoiceProcessedEvent','JobProfileQueueGroup','JournalReason','JournalSubType','JournalSubTypeHistory','JournalType','JournalTypeHistory','JournalTypeShare','KnowledgeArticle','KnowledgeArticleEventLog','KnowledgeArticleFeedback','KnowledgeArticleVersion','KnowledgeArticleVersionHistory','KnowledgeArticleViewStat','KnowledgeArticleVoteStat','Knowledge__DataCategorySelection','Knowledge__Feed','Knowledge__ViewStat','Knowledge__VoteStat','Knowledge__ka'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
