List<String> ns = new List<String>{'Account','GladeMissingProbe__c','AINaturalLangProcessRsltShare','AISentimentResult','AISentimentResultShare','AITrustAttrSetup','AITrustAttribute','AIUpdateRecordEvent','AIUsecaseDefinition','AIUsecaseFieldMapping','AIUsecaseModel','AbnExperiment','AbnExperimentCohort','AccountAccountRelation','AccountAccountRelationFeed','AccountAccountRelationHistory','AccountAccountRelationShare','AccountBillingAccount','AccountBillingAccountFeed','AccountBillingAccountHistory','AccountBrand','AccountBrandShare'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
