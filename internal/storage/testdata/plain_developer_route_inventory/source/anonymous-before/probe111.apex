List<String> ns = new List<String>{'Account','GladeMissingProbe__c','Knowledge__kav','LandingPage','LeadDailyMetric','LeadMonthlyMetric','LeadOwnerSharingRule','LeadTag','LearningContent','LearningItem','LearningItemAssignment','LearningItemProgress','LearningItemShare','LearningItemSubmission','LearningItemType','LearningPractice','LegalEntyAccountingPeriod','LegalEntyAccountingPeriodFeed','LegalEntyAccountingPeriodHistory','LegalEntyAccountingPeriodShare','LightningErrorEventLog','LightningExitByPageMetrics'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
