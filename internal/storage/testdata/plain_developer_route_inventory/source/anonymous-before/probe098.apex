List<String> ns = new List<String>{'Account','GladeMissingProbe__c','HealthcarePayerNetworkHistory','HealthcarePayerNetworkShare','HealthcarePractitionerFacility','HealthcarePractitionerFacilityFeed','HealthcarePractitionerFacilityHistory','HealthcarePractitionerFacilityShare','HealthcareProvider','HealthcareProviderFeed','HealthcareProviderHistory','HealthcareProviderNpi','HealthcareProviderNpiFeed','HealthcareProviderNpiHistory','HealthcareProviderNpiShare','HealthcareProviderService','HealthcareProviderServiceFeed','HealthcareProviderServiceHistory','HealthcareProviderServiceShare','HealthcareProviderShare','HealthcareProviderSpecialty','HealthcareProviderSpecialtyFeed'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
