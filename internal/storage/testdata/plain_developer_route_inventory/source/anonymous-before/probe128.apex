List<String> ns = new List<String>{'Account','GladeMissingProbe__c','ObligationFeed','ObligationHistory','ObligationShare','OcrDocumentScanResult','OcrDocumentScanResultFeed','OcrDocumentScanResultHistory','OcrSampleDocument','OcrSampleDocumentField','OcrSampleDocumentPage','OcrTargetObjFieldMapping','OcrTargetObject','OcrTemplate','OcrTemplateSampleDocument','OmniAssessmentTask','OmniAssessmentTaskFeed','OmniAssessmentTaskHistory','OmniAssessmentTaskShare','OmniComponentErrorLogFeed','OmniComponentErrorLogShare','OmniDataPack'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
