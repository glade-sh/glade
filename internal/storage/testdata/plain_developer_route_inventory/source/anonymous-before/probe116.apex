List<String> ns = new List<String>{'Account','GladeMissingProbe__c','LoyaltyMemberTier','LoyaltyMemberTierHistory','LoyaltyMembershipLifecycle','LoyaltyMembershipLifecycleHistory','LoyaltyPartnerProduct','LoyaltyPartnerProductHistory','LoyaltyPgmEngmtAttrProm','LoyaltyPgmEngmtAttrPromHistory','LoyaltyPgmEngmtAttribute','LoyaltyPgmEngmtAttributeHistory','LoyaltyPgmGroupMbrRlnsp','LoyaltyPgmGroupMbrRlnspHistory','LoyaltyPgmMbrAttributeVal','LoyaltyPgmMbrAttributeValHistory','LoyaltyPgmMbrPromEligView','LoyaltyPgmPartnerCurrency','LoyaltyPgmPartnerCurrencyHistory','LoyaltyPgmPartnerPromotion','LoyaltyPgmPartnerPromotionHistory','LoyaltyPgmPtnrLdgrSummary'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
