List<String> ns = new List<String>{'Account','GladeMissingProbe__c','ExpressionSetVersion','ExpressionSetVersionFeed','ExpressionSetVersionHistory','ExpsSetObjectAliasFieldVw','ExtConvParticipantIntegDef','ExtDataShare','ExtDataShareFeed','ExtDataShareHistory','ExtDataShareTargetFeed','ExtDataShareTargetHistory','ExtDataShareTargetShare','ExtKnowledgeConnector','ExtKnowledgeConnectorShare','ExternalAIModel','ExternalAccountHierarchy','ExternalAccountHierarchyFeed','ExternalAccountHierarchyHistory','ExternalAccountHierarchyShare','ExternalAssessmentDefinition','ExternalAssessmentDefinitionFeed'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
