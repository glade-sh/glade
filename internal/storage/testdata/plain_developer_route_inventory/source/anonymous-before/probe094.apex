List<String> ns = new List<String>{'Account','GladeMissingProbe__c','GoalAssignmentRecommendationShare','GoalAssignmentShare','GoalDefinition','GoalDefinitionFeed','GoalDefinitionHistory','GoalDefinitionShare','GoalLink','GoogleDoc','GovtFinancialAsstSum','GovtFinancialAsstSumFeed','GovtFinancialAsstSumHistory','GovtFinancialAsstSumShare','GroundTravelEmssnFctr','GroundTravelEmssnFctrFeed','GroundTravelEmssnFctrHistory','GroundTravelEmssnFctrShare','GroundTravelEnrgyUse','GroundTravelEnrgyUseFeed','GroundTravelEnrgyUseHistory','GroundTravelEnrgyUseShare'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
