List<String> ns = new List<String>{'Account','GladeMissingProbe__c','CareProgramHistory','CareProgramProduct','CareProgramProductFeed','CareProgramProductHistory','CareProgramProductShare','CareProgramProvider','CareProgramProviderFeed','CareProgramProviderHistory','CareProgramProviderShare','CareProgramShare','CareProgramSite','CareProgramSiteFeed','CareProgramSiteHistory','CareProgramSiteShare','CareProgramStatusPeriod','CareProgramStatusPeriodFeed','CareProgramStatusPeriodHistory','CareProgramTeamMember','CareProgramTeamMemberFeed','CareProgramTeamMemberHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
