List<String> ns = new List<String>{'Account','GladeMissingProbe__c','ResearchStudyRelationFeed','ResearchStudyRelationHistory','ResearchStudyRndmBlockSlot','ResearchStudyRndmBlockSlotFeed','ResearchStudyRndmBlockSlotHistory','ResearchStudyShare','ResidentialLoanApplication','ResidentialLoanApplicationFeed','ResidentialLoanApplicationHistory','ResidentialLoanApplicationShare','RestApiEventLog','RetrievalSummaryDefField','RetrievalSummaryDefObject','RetrievalSummaryDefinition','ReturnOrderItemAdjustment','ReturnOrderItemTax','ReturnOrderOwnerSharingRule','RevenueAsyncOperation','RevenueTransactionErrorLog','RevenueTransactionErrorLogShare'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
