List<String> ns = new List<String>{'Account','GladeMissingProbe__c','RpaFlowResultEvent','RpaRobot','RpaRobotAsgnMaintWindow','RpaRobotAsgnSessionInf','RpaRobotDefinition','RpaRobotMaintWindow','RpaRobotMaintWindowDef','RpaRobotPool','RpaRobotPoolAsgnRobot','RpaRobotPoolDefinition','RpaRobotPoolFlowAsgn','RpaRobotSessionInfo','RpaRobotSessionInfoDef','RsrchStdyRandomizationBlock','RsrchStdyRandomizationBlockFeed','RsrchStdyRandomizationBlockHistory','RsrchStdyRandomizationBlockShare','RsrchStdyRandomizationCrit','RsrchStdyRandomizationCritFeed','RsrchStdyRandomizationCritHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
