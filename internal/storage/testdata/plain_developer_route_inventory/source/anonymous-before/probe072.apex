List<String> ns = new List<String>{'Account','GladeMissingProbe__c','DocumentGenerationProcess','DocumentGenerationProcessShare','DocumentGenerationSetting','DocumentRecipient','DocumentRecipientFeed','DocumentRecipientShare','DocumentTag','DocumentTemplate','DocumentTemplateContentDoc','DocumentTemplateContentDocFeed','DocumentTemplateContentDocHistory','DocumentTemplateFeed','DocumentTemplateHistory','DocumentTemplateSection','DocumentTemplateSectionFeed','DocumentTemplateSectionHistory','DocumentTemplateShare','DocumentTemplateToken','DocumentTemplateTokenFeed','DocumentTemplateTokenHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
