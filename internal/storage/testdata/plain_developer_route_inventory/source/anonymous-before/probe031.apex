List<String> ns = new List<String>{'Account','GladeMissingProbe__c','BudgetAllocation','BudgetAllocationFeed','BudgetAllocationHistory','BudgetCategory','BudgetCategoryFeed','BudgetCategoryHistory','BudgetCategoryValue','BudgetCategoryValueFeed','BudgetCategoryValueHistory','BudgetFeed','BudgetHistory','BudgetParticipant','BudgetParticipantFeed','BudgetParticipantHistory','BudgetPeriod','BudgetPeriodFeed','BudgetPeriodHistory','BudgetShare','BulkApi2EventLog','BulkApiEventLog'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
