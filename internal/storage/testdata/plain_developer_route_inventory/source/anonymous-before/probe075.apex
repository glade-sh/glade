List<String> ns = new List<String>{'Account','GladeMissingProbe__c','EmpBenefitSummary','EmpBenefitSummaryFeed','EmpBenefitSummaryHistory','EmpBenefitSummaryShare','EmpUserProvisionProcessErr','EmpUserProvisioningProcess','Employee','Employee2','EmployeeCrisisAssessment','EmployeeDemographicSum','EmployeeDemographicSumFeed','EmployeeDemographicSumHistory','EmployeeDemographicSumShare','EmployeeDevelopmentSum','EmployeeDevelopmentSumFeed','EmployeeDevelopmentSumHistory','EmployeeDevelopmentSumShare','EmploymentCompensationSummary','EmploymentCompensationSummaryFeed','EmploymentCompensationSummaryHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
