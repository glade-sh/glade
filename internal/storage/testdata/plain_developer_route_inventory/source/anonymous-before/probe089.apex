List<String> ns = new List<String>{'Account','GladeMissingProbe__c','GameParticipant','GameParticipantFeed','GameParticipantHistory','GameParticipantReward','GameParticipantRewardFeed','GameParticipantRewardHistory','GameParticipantShare','GameReward','GameRewardFeed','GameRewardHistory','GenAIConversationSummary','GenAiFunctionDefinition','GenAiPlannerAttrDefinition','GenAiPlannerDefinition','GenAiPlannerFunctionDef','GenAiPluginDefinition','GenAiPluginFunctionDef','GenAiPluginInstructionDef','GenOpPlanParamShare','GenOpPlanRequest'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
