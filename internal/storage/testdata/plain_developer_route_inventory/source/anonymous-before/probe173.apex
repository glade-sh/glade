List<String> ns = new List<String>{'Account','GladeMissingProbe__c','RecordAlertDataSource','RecordAlertFeed','RecordAlertHistory','RecordAlertShare','RecordAlertTemplate','RecordAlertTemplateLocalization','RecordTypeLocalization','RecordVisibility','RecurrenceSchedule','RecurrenceScheduleShare','ReferenceDataLoadLogFeed','ReferenceDataLoadLogHistory','ReferenceDataLoadLogShare','Referral','ReferralFeed','ReferralHistory','ReferralShare','RefrigerantEmssnFctr','RefrigerantEmssnFctrFeed','RefrigerantEmssnFctrHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
