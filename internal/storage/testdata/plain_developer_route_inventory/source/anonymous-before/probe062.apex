List<String> ns = new List<String>{'Account','GladeMissingProbe__c','CrbnEmssnScopeAllocValHistory','CreateAssetOrderDtlEvent','CreateAssetOrderEvent','CreditInvoiceProcessedEvent','CreditMemoAddressGroup','CreditMemoAddressGroupHistory','CreditMemoInvApplicationHistory','CreditMemoLineInvoiceLine','CreditMemoLineTax','CreditMemoLineTaxFeed','CreditMemoLineTaxHistory','CreditMemoProcessedEvent','Crisis','CryptoProdCatgWalletGroup','CspViolation','CspViolationEventLog','CurrencyType','CustExpIntlTransfSetup','CustodyChainEntry','CustodyChainEntryFeed'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
