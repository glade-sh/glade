List<String> ns = new List<String>{'Account','GladeMissingProbe__c','GroupCensus','GroupCensusFeed','GroupCensusHistory','GroupCensusMember','GroupCensusMemberFeed','GroupCensusMemberHistory','GroupCensusMemberPlan','GroupCensusMemberPlanFeed','GroupCensusMemberPlanHistory','GroupCensusMemberPlanShare','GroupCensusMemberShare','GroupCensusShare','GroupClass','GroupClassContribution','GroupClassContributionHistory','GroupClassHistory','GroupMembershipEventLog','GrpCensusGrpClassSummary','GrpCensusGrpClassSummaryFeed','GrpCensusGrpClassSummaryHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
