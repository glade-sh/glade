List<String> ns = new List<String>{'Account','GladeMissingProbe__c','CareObservationFeed','CareObservationHistory','CareObservationShare','CarePerformer','CarePerformerFeed','CarePerformerHistory','CarePgmEnrleeStatusPeriod','CarePgmEnrleeStatusPeriodFeed','CarePgmEnrleeStatusPeriodHistory','CarePgmEnrolleeWkOrdStep','CarePgmEnrolleeWkOrdStepFeed','CarePgmEnrolleeWkOrdStepHistory','CarePgmEnrolleeWorkOrder','CarePgmEnrolleeWorkOrderFeed','CarePgmEnrolleeWorkOrderHistory','CarePgmProvHealthcareProvider','CarePgmProvHealthcareProviderFeed','CarePgmProvHealthcareProviderHistory','CarePgmTeamMbrRolePeriod','CarePgmTeamMbrRolePeriodFeed'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
