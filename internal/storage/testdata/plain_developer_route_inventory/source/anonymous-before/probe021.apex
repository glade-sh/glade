List<String> ns = new List<String>{'Account','GladeMissingProbe__c','AttributeBasedAdjustmentFeed','AttributeBasedAdjustmentHistory','AttributeCategory','AttributeCategoryAttribute','AttributeCategoryAttributeFeed','AttributeCategoryAttributeHistory','AttributeCategoryAttributeShare','AttributeCategoryFeed','AttributeCategoryHistory','AttributeCategoryShare','Audience','AuditTrailFileExportShare','AuraRequestEventLog','AuthApplicationAsset','AuthApplicationAssetFeed','AuthApplicationAssetHistory','AuthApplicationAssetShare','AuthApplicationPlace','AuthApplicationPlaceFeed','AuthApplicationPlaceHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
