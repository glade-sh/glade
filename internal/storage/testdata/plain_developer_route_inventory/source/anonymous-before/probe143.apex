List<String> ns = new List<String>{'Account','GladeMissingProbe__c','PatientImmunizationProtocolShare','PatientImmunizationShare','PatientMedicalProcedure','PatientMedicalProcedureDetail','PatientMedicalProcedureDetailFeed','PatientMedicalProcedureDetailHistory','PatientMedicalProcedureFeed','PatientMedicalProcedureHistory','PatientMedicalProcedureShare','PatientMedicationDosage','PatientMedicationDosageFeed','PatientMedicationDosageHistory','PaymentBatchRun','PaymentBatchRunCriteriaShare','PaymentBatchRunShare','PaymentCredit','PaymentCreditLinePayment','PaymentCreditTransaction','PaymentInitiationSource','PaymentInstrument'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
