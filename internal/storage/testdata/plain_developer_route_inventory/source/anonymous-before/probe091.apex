List<String> ns = new List<String>{'Account','GladeMissingProbe__c','GenericVisitTaskContextHistory','GenericVisitTaskContextShare','GenericVisitTaskFeed','GenericVisitTaskHistory','GenericVisitTaskShare','GeoCountry','GeoCountryShare','GeoState','GiftBatchFeed','GiftBatchHistory','GiftBatchShare','GiftCmtChangeAttrLogFeed','GiftCmtChangeAttrLogHistory','GiftCommitment','GiftCommitmentFeed','GiftCommitmentHistory','GiftCommitmentSchedule','GiftCommitmentScheduleFeed','GiftCommitmentScheduleHistory','GiftCommitmentShare'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
