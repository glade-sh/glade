List<String> ns = new List<String>{'Account','GladeMissingProbe__c','VoiceMailGreeting2Share','VoiceMailGreetingShare','VoiceMailMessage','VoiceMailMessageShare','VoiceOrgSetting','VoiceUserLine','VoiceUserLineShare','VoiceUserPreferences','VoiceUserPreferencesShare','VoiceVendorInfo','VoiceVendorLine','VoiceVendorLineShare','VoidInvoiceProcessedEvent','Voucher','VoucherDefinition','VoucherDefinitionHistory','VoucherDefinitionShare','VoucherHistory','VoucherShare','Waitlist'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
