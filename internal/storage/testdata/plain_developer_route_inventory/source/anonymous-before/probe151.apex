List<String> ns = new List<String>{'Account','GladeMissingProbe__c','PriceBookEntryDerivedPriceFeed','PriceBookEntryDerivedPriceHistory','PriceBookEntryDerivedPriceShare','PriceBookRateCard','PriceBookRateCardFeed','PriceBookRateCardHistory','PriceProtectExecLineItem','PriceProtectionExecution','PriceProtectionTerm','PricebookEntryAdjustment','PricingActionParameters','PricingAdjBatchJob','PricingAdjBatchJobFeed','PricingAdjBatchJobHistory','PricingAdjBatchJobLog','PricingAdjBatchJobLogFeed','PricingAdjBatchJobLogHistory','PricingAdjBatchJobShare','PricingApiExecutionFeed','PricingApiExecutionHistory'}; List<String> result = new List<String>(); for (String n : ns) { Boolean t=Type.forName(n)!=null; String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
