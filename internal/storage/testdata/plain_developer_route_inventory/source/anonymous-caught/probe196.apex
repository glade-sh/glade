List<String> ns = new List<String>{'Account','GladeMissingProbe__c','TeamHistory','TeamMember','TeamMemberFeed','TeamMemberHistory','TeamShare','TenantConsumptionAlert','TenantConsumptionAlertShare','Term','TermFeed','TermHistory','TermShare','Territory','Territory2','Territory2AlignmentLog','Territory2Model','Territory2ModelFeed','Territory2ModelHistory','Territory2ObjSharingConfig','Territory2ObjectExclusion','Territory2Type'}; List<String> result = new List<String>(); for (String n : ns) { String t='false'; try { t=String.valueOf(Type.forName(n)!=null); } catch (Exception e) { t=e.getTypeName(); } String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
