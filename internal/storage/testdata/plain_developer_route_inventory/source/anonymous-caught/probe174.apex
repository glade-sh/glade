List<String> ns = new List<String>{'Account','GladeMissingProbe__c','RefrigerantEmssnFctrShare','RegAuthorizationTypeProduct','RegAuthorizationTypeProductFeed','RegAuthorizationTypeProductHistory','RegAuthorizationTypeProductShare','RegisteredExternalService','RegulatoryAuthority','RegulatoryAuthorityFeed','RegulatoryAuthorityHistory','RegulatoryAuthorityShare','RegulatoryAuthorizationType','RegulatoryAuthorizationTypeFeed','RegulatoryAuthorizationTypeHistory','RegulatoryAuthorizationTypeShare','RegulatoryCode','RegulatoryCodeAssessmentInd','RegulatoryCodeAssessmentIndFeed','RegulatoryCodeAssessmentIndHistory','RegulatoryCodeFeed','RegulatoryCodeHistory'}; List<String> result = new List<String>(); for (String n : ns) { String t='false'; try { t=String.valueOf(Type.forName(n)!=null); } catch (Exception e) { t=e.getTypeName(); } String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
