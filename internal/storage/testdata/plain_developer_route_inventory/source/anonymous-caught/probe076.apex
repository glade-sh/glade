List<String> ns = new List<String>{'Account','GladeMissingProbe__c','EmploymentCompensationSummaryShare','EmssnRdctnCommitment','EmssnRdctnCommitmentFeed','EmssnRdctnCommitmentHistory','EmssnRdctnCommitmentShare','EmssnReductionTarget','EmssnReductionTargetFeed','EmssnReductionTargetHistory','EmssnReductionTargetShare','EnablementMeasureDefinition','EnablementProgram','EnablementProgramDefinition','EnblMeasureObjectDefinition','EnblPgmTaskMeasureProgress','EnblProgramSection','EnblProgramTaskDefinition','EnblProgramTaskMeasure','EnblProgramTaskProgress','EnblProgramTaskSubCategory','EnergyAttrCertCredit'}; List<String> result = new List<String>(); for (String n : ns) { String t='false'; try { t=String.valueOf(Type.forName(n)!=null); } catch (Exception e) { t=e.getTypeName(); } String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
