List<String> ns = new List<String>{'Account','GladeMissingProbe__c','CalculationMatrixRowHistory','CalculationMatrixShare','CalculationMatrixVersion','CalculationMatrixVersionFeed','CalculationMatrixVersionHistory','CalculationProcedure','CalculationProcedureFeed','CalculationProcedureHistory','CalculationProcedureShare','CalculationProcedureStep','CalculationProcedureStepFeed','CalculationProcedureStepHistory','CalculationProcedureVariable','CalculationProcedureVariableFeed','CalculationProcedureVariableHistory','CalculationProcedureVersion','CalculationProcedureVersionFeed','CalculationProcedureVersionHistory','CallCenterRoutingMap','CallCoachConfigModifyEvent'}; List<String> result = new List<String>(); for (String n : ns) { String t='false'; try { t=String.valueOf(Type.forName(n)!=null); } catch (Exception e) { t=e.getTypeName(); } String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
