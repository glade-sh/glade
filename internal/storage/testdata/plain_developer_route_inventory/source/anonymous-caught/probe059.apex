List<String> ns = new List<String>{'Account','GladeMissingProbe__c','ConvDefDialogHourlyMetric','ConvDefSessionMetric','ConversationChannelDefinition','ConversationContextEntry','ConversationDefinitionDialog','ConversationDefinitionEventLog','ConversationDefinitionSession','ConversationDefinitionSessionEngagement','ConversationInsightEvent','ConversationVendorInfo','CostBook','CostBookEntry','CostBookEntryFeed','CostBookEntryHistory','CostBookFeed','CostBookHistory','CostBookShare','Coupon','CouponCodeRedemption','CouponCodeRedemptionShare'}; List<String> result = new List<String>(); for (String n : ns) { String t='false'; try { t=String.valueOf(Type.forName(n)!=null); } catch (Exception e) { t=e.getTypeName(); } String q='ok'; try { Database.query('SELECT Id FROM '+n+' LIMIT 1'); } catch (Exception e) { q=e.getTypeName(); } result.add(n+'='+t+','+q); } System.assert(false,'OBS|'+String.join(result,';'));
