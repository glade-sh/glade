List<String> ns=new List<String>{'Account','GladeMissingProbe__c','CareObservationComponent','CareObservationComponentFeed','CareObservationComponentHistory','CareObservationFeed','CareObservationHistory','CareObservationShare','CarePerformer','CarePerformerFeed','CarePerformerHistory','CarePgmEnrleeStatusPeriod','CarePgmEnrleeStatusPeriodFeed','CarePgmEnrleeStatusPeriodHistory','CarePgmEnrolleeWkOrdStep','CarePgmEnrolleeWkOrdStepFeed','CarePgmEnrolleeWkOrdStepHistory','CarePgmEnrolleeWorkOrder','CarePgmEnrolleeWorkOrderFeed','CarePgmEnrolleeWorkOrderHistory','CarePgmProvHealthcareProvider','CarePgmProvHealthcareProviderFeed','CarePgmProvHealthcareProviderHistory','CarePgmTeamMbrRolePeriod','CarePgmTeamMbrRolePeriodFeed','CarePgmTeamMbrRolePeriodHistory','CarePlan','CarePlanActivity','CarePlanActivityDetail','CarePlanDetail','CarePlanDetailFeed','CarePlanDetailHistory','CarePlanDetailShare','CarePlanFeed','CarePlanHistory','CarePlanTemplate','CarePlanTemplateBenefit','CarePlanTemplateBenefitHistory','CarePlanTemplateFeed','CarePlanTemplateGoal','CarePlanTemplateGoalHistory','CarePlanTemplateHistory','CarePlanTemplateProblem','CarePlanTemplateShare','CarePractnFacilityAppt','CarePreauth','CarePreauthFeed','CarePreauthHistory','CarePreauthItem','CarePreauthItemFeed','CarePreauthItemHistory','CarePreauthItemShare','CarePreauthShare','CareProcessingError','CareProcessingErrorFeed','CareProcessingErrorHistory','CareProcessingErrorShare','CareProgram','CareProgramCampaign','CareProgramCampaignFeed','CareProgramCampaignHistory','CareProgramDetail','CareProgramDetailFeed','CareProgramDetailHistory','CareProgramEligibilityRule','CareProgramEligibilityRuleFeed','CareProgramEligibilityRuleHistory','CareProgramEligibilityRuleShare','CareProgramEnrollee','CareProgramEnrolleeFeed','CareProgramEnrolleeHistory','CareProgramEnrolleeProduct','CareProgramEnrolleeProductFeed','CareProgramEnrolleeProductHistory','CareProgramEnrolleeProductShare','CareProgramEnrolleeShare','CareProgramEnrollmentCard','CareProgramEnrollmentCardFeed','CareProgramEnrollmentCardHistory','CareProgramEnrollmentCardShare','CareProgramFeed','CareProgramGoal','CareProgramGoalFeed','CareProgramGoalHistory','CareProgramGoalShare','CareProgramHistory','CareProgramProduct','CareProgramProductFeed','CareProgramProductHistory','CareProgramProductShare','CareProgramProvider','CareProgramProviderFeed','CareProgramProviderHistory','CareProgramProviderShare','CareProgramShare','CareProgramSite','CareProgramSiteFeed','CareProgramSiteHistory','CareProgramSiteShare','CareProgramStatusPeriod','CareProgramStatusPeriodFeed','CareProgramStatusPeriodHistory'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
