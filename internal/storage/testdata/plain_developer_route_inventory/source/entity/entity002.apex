List<String> ns=new List<String>{'Account','GladeMissingProbe__c','AnalyticsContainerWidgetDef','AnalyticsDashboard','AnalyticsDashboardWidget','AnalyticsDownloadEventLog','AnalyticsInteractEventLog','AnalyticsLicensedAsset','AnalyticsPerfEventLog','AnalyticsVisualization','AnalyticsVizField','AnalyticsVizViewDef','AnalyticsWorkspace','AnalyticsWorkspaceAsset','AnlytDataAssetEventStore','AnnualEmssnInventory','AnnualEmssnInventoryFeed','AnnualEmssnInventoryHistory','AnnualEmssnInventoryShare','AnnualEmssnRdctnTarget','AnnualEmssnRdctnTargetFeed','AnnualEmssnRdctnTargetHistory','AntiCorruptionInitSum','AntiCorruptionInitSumFeed','AntiCorruptionInitSumHistory','AntiCorruptionInitSumShare','ApexCalloutEventLog','ApexExecutionEventLog','ApexExtlCalloutEventLog','ApexInlineEventLog','ApexRestApiEventLog','ApexSoapApiEventLog','ApexTriggerEventLog','ApexUnexpectedExcpEventLog','ApiTotalUsageEventLog','AppFormProdtFinclAccountFeed','AppFormProdtFinclAccountHistory','AppFormProdtPrpsAttribute','AppFormProductCollateral','AppFormProductCollateralFeed','AppFormProductCollateralHistory','Applicant','ApplicantFeed','ApplicantHistory','ApplicationActionItem','ApplicationActionItemFeed','ApplicationActionItemHistory','ApplicationActionItemShare','ApplicationCase','ApplicationCaseFeed','ApplicationCaseHistory','ApplicationDecision','ApplicationDecisionFeed','ApplicationDecisionHistory','ApplicationDecisionShare','ApplicationForm','ApplicationFormFeed','ApplicationFormHistory','ApplicationFormProduct','ApplicationFormProductFee','ApplicationFormProductFeeFeed','ApplicationFormProductFeeHistory','ApplicationFormProductFeed','ApplicationFormProductHistory','ApplicationFormProductProposal','ApplicationFormProductProposalFeed','ApplicationFormProductProposalHistory','ApplicationFormProductShare','ApplicationFormRelation','ApplicationFormRelationFeed','ApplicationFormRelationHistory','ApplicationFormSellerItem','ApplicationFormSellerItemFeed','ApplicationFormSellerItemHistory','ApplicationFormShare','ApplicationFormTemplate','ApplicationFormTemplateFeed','ApplicationFormTemplateHistory','ApplicationFormTemplateShare','ApplicationFormTerm','ApplicationFormTermFeed','ApplicationFormTermHistory','ApplicationRenderMethod','ApplicationRenderMethodFeed','ApplicationRenderMethodHistory','ApplicationRenderMethodShare','ApplicationReview','ApplicationReviewFeed','ApplicationReviewHistory','ApplicationReviewShare','ApplicationStageDefinition','ApplicationStageDefinitionFeed','ApplicationStageDefinitionHistory','ApplicationStageDefinitionShare','ApplicationTimeline','ApplicationTimelineFeed','ApplicationTimelineHistory','ApplicationTimelineShare','AppointmentAssignmentPolicy','AppointmentCategory','AppointmentCategoryFeed','AppointmentCategoryHistory'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
