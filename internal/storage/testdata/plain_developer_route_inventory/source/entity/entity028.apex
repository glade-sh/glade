List<String> ns=new List<String>{'Account','GladeMissingProbe__c','PartyFinancialAssetLienFeed','PartyFinancialAssetLienHistory','PartyFinancialAssetRela','PartyFinancialAssetRelaFeed','PartyFinancialAssetRelaHistory','PartyFinancialAssetShare','PartyFinancialAssetTerm','PartyFinancialAssetTermFeed','PartyFinancialAssetTermHistory','PartyFinancialLiability','PartyFinancialLiabilityFeed','PartyFinancialLiabilityHistory','PartyFinancialLiabilityShare','PartyFinclAssetAddlOwner','PartyFinclAssetAddlOwnerFeed','PartyFinclAssetAddlOwnerHistory','PartyFinclLiabAddlBrwr','PartyFinclLiabAddlBrwrFeed','PartyFinclLiabAddlBrwrHistory','PartyIncome','PartyIncomeFeed','PartyIncomeHistory','PartyIncomeShare','PartyPhilanthropicAssessment','PartyPhilanthropicAssessmentFeed','PartyPhilanthropicAssessmentHistory','PartyPhilanthropicAssessmentShare','PartyPhilanthropicIndicator','PartyPhilanthropicIndicatorFeed','PartyPhilanthropicIndicatorHistory','PartyPhilanthropicIndicatorShare','PartyPhilanthropicMilestone','PartyPhilanthropicMilestoneFeed','PartyPhilanthropicMilestoneHistory','PartyPhilanthropicMilestoneShare','PartyPhilanthropicOccurrence','PartyPhilanthropicOccurrenceFeed','PartyPhilanthropicOccurrenceHistory','PartyPhilanthropicOccurrenceShare','PartyProfile','PartyProfileAddress','PartyProfileAddressFeed','PartyProfileAddressHistory','PartyProfileAddressShare','PartyProfileFeed','PartyProfileHistory','PartyProfileShare','PartyRelationshipGroup','PartyRelationshipGroupFeed','PartyRelationshipGroupHistory','PartyRoleRelation','PartyRoleRelationFeed','PartyRoleRelationHistory','PartyRoleRelationShare','PatientHealthReaction','PatientHealthReactionFeed','PatientHealthReactionHistory','PatientImmunization','PatientImmunizationFeed','PatientImmunizationHistory','PatientImmunizationProtocol','PatientImmunizationProtocolFeed','PatientImmunizationProtocolHistory','PatientImmunizationProtocolShare','PatientImmunizationShare','PatientMedicalProcedure','PatientMedicalProcedureDetail','PatientMedicalProcedureDetailFeed','PatientMedicalProcedureDetailHistory','PatientMedicalProcedureFeed','PatientMedicalProcedureHistory','PatientMedicalProcedureShare','PatientMedicationDosage','PatientMedicationDosageFeed','PatientMedicationDosageHistory','PaymentBatchRun','PaymentBatchRunCriteriaShare','PaymentBatchRunShare','PaymentCredit','PaymentCreditLinePayment','PaymentCreditTransaction','PaymentInitiationSource','PaymentInstrument','PaymentInstrumentFeed','PaymentInstrumentHistory','PaymentInstrumentShare','PaymentIntent','PaymentIntentEvent','PaymentIntentHistory','PaymentLineInvoiceLine','PaymentLink','PaymentLinkEvent','PaymentLinkShare','PaymentMandate','PaymentMandateFeed','PaymentMandateHistory','PaymentMandateShare','PaymentRequest','PaymentRequestFeed','PaymentRequestHistory'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
