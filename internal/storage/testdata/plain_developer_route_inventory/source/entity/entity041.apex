List<String> ns=new List<String>{'Account','GladeMissingProbe__c','ViolationType','ViolationTypeAssessmentInd','ViolationTypeAssessmentIndFeed','ViolationTypeAssessmentIndHistory','ViolationTypeFeed','ViolationTypeHistory','ViolationTypeShare','ViolationTypeUse','VirtualVisitConfig','Visit','VisitFeed','VisitHistory','VisitShare','VisitedParty','VisitedPartyFeed','VisitedPartyHistory','Visitor','VisitorFeed','VisitorHistory','VisualforceRequestEventLog','VoiceCall','VoiceCallFeed','VoiceCallHistory','VoiceCallInsight','VoiceCallInsightAction','VoiceCallInsightReason','VoiceCallList','VoiceCallListItem','VoiceCallMetrics','VoiceCallQualityFeedback','VoiceCallQualityFeedbackShare','VoiceCallRecording','VoiceCallShare','VoiceChnlInteractionEventShare','VoiceCoaching','VoiceCoachingShare','VoiceLocalPresenceNumber','VoiceMailContent','VoiceMailContentShare','VoiceMailGreeting','VoiceMailGreeting2','VoiceMailGreeting2Rep','VoiceMailGreeting2RepShare','VoiceMailGreeting2Share','VoiceMailGreetingShare','VoiceMailMessage','VoiceMailMessageShare','VoiceOrgSetting','VoiceUserLine','VoiceUserLineShare','VoiceUserPreferences','VoiceUserPreferencesShare','VoiceVendorInfo','VoiceVendorLine','VoiceVendorLineShare','VoidInvoiceProcessedEvent','Voucher','VoucherDefinition','VoucherDefinitionHistory','VoucherDefinitionShare','VoucherHistory','VoucherShare','Waitlist','WaitlistFeed','WaitlistHistory','WaitlistParticipant','WaitlistParticipantFeed','WaitlistParticipantHistory','WaitlistServiceResource','WaitlistServiceResourceFeed','WaitlistServiceResourceHistory','WaitlistShare','WaitlistWorkType','WaitlistWorkTypeFeed','WaitlistWorkTypeHistory','WasteFootprint','WasteFootprintFeed','WasteFootprintHistory','WasteFootprintItem','WasteFootprintItemFeed','WasteFootprintItemHistory','WasteFootprintShare','WaveAutoInstallRequest','WaveCompatibilityCheckItem','WebCart','WebCartAdjustmentBasis','WebCartAdjustmentGroup','WebCartCredit','WebCartHistory','WebCartShare','WebLinkLocalization','We