ialLoanApplicationHistory','ResidentialLoanApplicationShare','RestApiEventLog','RetrievalSummaryDefField','RetrievalSummaryDefObject','RetrievalSummaryDefinition','ReturnOrderItemAdjustment','ReturnOrderItemTax','ReturnOrderOwnerSharingRule','RevenueAsyncOperation','RevenueTransactionErrorLog','RevenueTransactionErrorLogShare','RpaFlowResultEvent','RpaRobot','RpaRobotAsgnMaintWindow','RpaRobotAsgnSessionInf','RpaRobotDefinition','RpaRobotMaintWindow','RpaRobotMaintWindowDef','RpaRobotPool','RpaRobotPoolAsgnRobot','RpaRobotPoolDefinition','RpaRobotPoolFlowAsgn','RpaRobotSessionInfo','RpaRobotSessionInfoDef','RsrchStdyRandomizationBlock','RsrchStdyRandomizationBlockFeed','RsrchStdyRandomizationBlockHistory','RsrchStdyRandomizationBlockShare'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
