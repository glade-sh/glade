List<String> ns=new List<String>{'Account','GladeMissingProbe__c','AppointmentInvitation','AppointmentInvitationFeed','AppointmentInvitationHistory','AppointmentInvitationShare','AppointmentInvitee','AppointmentScheduleAggr','AppointmentScheduleLog','AppointmentSchedulingPolicy','Approval','ApprovalAlertContentDef','ApprovalWorkItemCondition','ApprovalWorkItemCriteria','ApptBookingConfig','ApptBookingUrlConfig','ArchiveActivity','ArchivePolicyDefinition','ArticleType__DataCategorySelection','AsgnRsrcApptSchdEvent','AsmtQstnRespRecommendation','AsmtQstnRespRecommendationFeed','AsmtQstnRespRecommendationHistory','Assessment','AssessmentDefinition','AssessmentDefinitionFeed','AssessmentDefinitionHistory','AssessmentDefinitionShare','AssessmentEnvelope','AssessmentEnvelopeFeed','AssessmentEnvelopeHistory','AssessmentEnvelopeItem','AssessmentEnvelopeItemFeed','AssessmentEnvelopeItemHistory','AssessmentEnvelopeShare','AssessmentFeed','AssessmentHistory','AssessmentIndDefinedValue','AssessmentIndDefinedValueHistory','AssessmentIndValue','AssessmentIndValueHistory','AssessmentIndValueShare','AssessmentIndicatorDefinition','AssessmentIndicatorDefinitionFeed','AssessmentIndicatorDefinitionHistory','AssessmentIndicatorDefinitionShare','AssessmentQuestion','AssessmentQuestionAssignment','AssessmentQuestionAssignmentFeed','AssessmentQuestionAssignmentHistory','AssessmentQuestionAssignmentShare','AssessmentQuestionFeed','AssessmentQuestionHistory','AssessmentQuestionResponse','AssessmentQuestionResponseFeed','AssessmentQuestionResponseHistory','AssessmentQuestionResponseShare','AssessmentQuestionSet','AssessmentQuestionSetFeed','AssessmentQuestionSetHistory','AssessmentQuestionSetShare','AssessmentQuestionShare','AssessmentQuestionSourceDocFeed','AssessmentQuestionSourceDocHistory','AssessmentQuestionSourceDocShare','AssessmentQuestionVerChoice','AssessmentQuestionVerChoiceFeed','AssessmentQuestionVerChoiceHistory','AssessmentQuestionVersion','AssessmentQuestionVersionFeed','AssessmentQuestionVersionHistory','AssessmentReason','AssessmentSavedSession','AssessmentSavedSessionFeed','AssessmentSavedSessionHistory','AssessmentShare','AssessmentSignature','AssessmentSignatureFeed','AssessmentSignatureHistory','AssessmentTask','AssessmentTaskContentDocument','AssessmentTaskContentDocumentFeed','AssessmentTaskContentDocumentHistory','AssessmentTaskDefinition','AssessmentTaskDefinitionFeed','AssessmentTaskDefinitionHistory','AssessmentTaskDefinitionShare','AssessmentTaskFeed','AssessmentTaskHistory','AssessmentTaskIndDefinition','AssessmentTaskIndDefinitionFeed','AssessmentTaskIndDefinitionHistory','AssessmentTaskOrder','AssessmentTaskOrderFeed','AssessmentTaskOrderHistory','AssessmentTaskShare','AssetContractRelationship','AssetContractRelationshipFeed','AssetContractRelationshipHistory','AssetOwnerSharingRule','AssetRateAdjustment','AssetRateCardEntry'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
