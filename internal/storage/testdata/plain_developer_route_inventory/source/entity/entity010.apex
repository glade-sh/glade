List<String> ns=new List<String>{'Account','GladeMissingProbe__c','ChangeRequestRelatedIssueHistory','ChangeRequestRelatedItem','ChangeRequestRelatedItemFeed','ChangeRequestRelatedItemHistory','ChangeRequestShare','ChangeSetOperationEventLog','ChannelObjectLinkingRule','ChannelProgram','ChannelProgramFeed','ChannelProgramHistory','ChannelProgramLevel','ChannelProgramLevelFeed','ChannelProgramLevelHistory','ChannelProgramLevelShare','ChannelProgramMember','ChannelProgramMemberFeed','ChannelProgramMemberHistory','ChannelProgramMemberShare','ChannelProgramShare','ChatterAnswersActivity','ChatterAnswersReputationLevel','Claim','ClaimAttribute','ClaimCoverage','ClaimCoverageFeed','ClaimCoverageHistory','ClaimCoverageShare','ClaimFeed','ClaimHistory','ClaimItem','ClaimItemAttribute','ClaimItemFeed','ClaimItemHistory','ClaimItemRelatedObject','ClaimItemRelatedObjectFeed','ClaimItemRelatedObjectHistory','ClaimParticipant','ClaimParticipantFeed','ClaimParticipantHistory','ClaimPaymentSummary','ClaimPaymentSummaryFeed','ClaimPaymentSummaryHistory','ClaimShare','ClaimTeamMember','ClaimTeamMemberFeed','ClaimTeamMemberHistory','ClauseCatgConfiguration','CleanEnergyProject','CleanEnergyProjectFeed','CleanEnergyProjectHistory','CleanEnergyProjectShare','ClinicalAlert','ClinicalAlertFeed','ClinicalAlertHistory','ClinicalAlertShare','ClinicalDetectedIssue','ClinicalDetectedIssueDetail','ClinicalDetectedIssueDetailFeed','ClinicalDetectedIssueDetailHistory','ClinicalDetectedIssueFeed','ClinicalDetectedIssueHistory','ClinicalDetectedIssueShare','ClinicalEncounter','ClinicalEncounterDiagnosis','ClinicalEncounterDiagnosisFeed','ClinicalEncounterDiagnosisHistory','ClinicalEncounterFacility','ClinicalEncounterFacilityFeed','ClinicalEncounterFacilityHistory','ClinicalEncounterFeed','ClinicalEncounterHistory','ClinicalEncounterIdentifier','ClinicalEncounterIdentifierFeed','ClinicalEncounterIdentifierHistory','ClinicalEncounterProvider','ClinicalEncounterProviderFeed','ClinicalEncounterProviderHistory','ClinicalEncounterReason','ClinicalEncounterReasonFeed','ClinicalEncounterReasonHistory','ClinicalEncounterShare','ClinicalEncounterSvcRequest','ClinicalEncounterSvcRequestFeed','ClinicalEncounterSvcRequestHistory','ClinicalMeasure','ClinicalMeasureCriteria','ClinicalMeasureCriteriaGrp','ClinicalServiceRequest','ClinicalServiceRequestDetail','ClinicalServiceRequestDetailFeed','ClinicalServiceRequestDetailHistory','ClinicalServiceRequestFeed','ClinicalServiceRequestHistory','ClinicalServiceRequestShare','CodeSet','CodeSetBundle','CodeSetBundleHistory','CodeSetBundleShare','CodeSetFeed','CodeSetHistory'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
