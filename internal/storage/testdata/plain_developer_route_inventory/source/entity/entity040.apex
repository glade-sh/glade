List<String> ns=new List<String>{'Account','GladeMissingProbe__c','UsageCmtAssetRelatedObjHistory','UsageGrantRenewalPolicy','UsageGrantRenewalPolicyFeed','UsageGrantRenewalPolicyHistory','UsageGrantRolloverPolicy','UsageGrantRolloverPolicyFeed','UsageGrantRolloverPolicyHistory','UsageImpactFactor','UsageImpactFactorFeed','UsageImpactFactorHistory','UsageImpactFactorShare','UsageImpactGroup','UsageImpactGroupFactor','UsageImpactGroupFactorFeed','UsageImpactGroupFactorHistory','UsageImpactGroupFeed','UsageImpactGroupHistory','UsageImpactGroupPgmMeasure','UsageImpactGroupPgmMeasureFeed','UsageImpactGroupPgmMeasureHistory','UsageImpactGroupShare','UsageImpactGroupVersion','UsageImpactGroupVersionFeed','UsageImpactGroupVersionHistory','UsageImpactGroupVersionShare','UsagePrdGrantBindingPolicy','UsagePrdGrantBindingPolicyFeed','UsagePrdGrantBindingPolicyHistory','UsageResource','UsageResourceBillingPolicy','UsageResourceBillingPolicyFeed','UsageResourceBillingPolicyHistory','UsageResourceFeed','UsageResourceHistory','UsageResourcePolicy','UsageResourceShare','UserAccessChange','UserAccessPolicy','UserAccountTeamMember','UserAuthCertificate','UserConfigTransferButton','UserConfigTransferSkill','UserCustomBadge','UserCustomBadgeLocalization','UserDailyMetric','UserDailyMetricOwnerSharingRule','UserDailyMetricShare','UserDevice','UserDeviceApplication','UserDeviceHistory','UserEmailCalendarSync','UserEsignVendorIdentifier','UserEsignVendorIdentifierFeed','UserEsignVendorIdentifierHistory','UserEsignVendorIdentifierShare','UserLocationAssignment','UserMembershipSharingRule','UserMonthlyMetric','UserMonthlyMetricOwnerSharingRule','UserMonthlyMetricShare','UserPrioritizedRecord','UserPrioritizedRecordShare','UserProfile','UserRelatedRecordContent','UserServicePresence','UserServicePresenceShare','UserTeamMember','UserTerritory','UserTerritory2AssocLog','UserTerritory2Association','UserUIPreference','UserWorkList','UserWorkListItem','UserWorkListShare','VehicleAssetCrbnFtprnt','VehicleAssetCrbnFtprntFeed','VehicleAssetCrbnFtprntHistory','VehicleAssetCrbnFtprntShare','VehicleAssetEmssnSrc','VehicleAssetEmssnSrcFeed','VehicleAssetEmssnSrcHistory','VehicleAssetEmssnSrcShare','VehicleAssetEnrgyUse','VehicleAssetEnrgyUseFeed','VehicleAssetEnrgyUseHistory','VehicleAssetEnrgyUseShare','VendorCallCenterStatusMap','VideoCall','VideoCallFeed','VideoCallInsight','VideoCallInsightAction','VideoCallInsightReason','VideoCallParticipant','VideoCallRecording','VideoCallRecordingStructure','VideoCallShare','VideoVendorAdminConsent','ViolationEnforcementAction','ViolationEnforcementActionFeed','ViolationEnforcementActionHistory'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
