List<String> ns=new List<String>{'Account','GladeMissingProbe__c','CareProgramTeamMember','CareProgramTeamMemberFeed','CareProgramTeamMemberHistory','CareProviderAdverseAction','CareProviderAdverseActionFeed','CareProviderAdverseActionHistory','CareProviderAdverseActionShare','CareProviderFacilitySpecialty','CareProviderFacilitySpecialtyFeed','CareProviderFacilitySpecialtyHistory','CareProviderFacilitySpecialtyShare','CareProviderSearchConfig','CareProviderSearchableField','CareProviderSearchableFieldFeed','CareProviderSearchableFieldHistory','CareProviderSearchableFieldShare','CareRegisteredDevice','CareRegisteredDeviceFeed','CareRegisteredDeviceHistory','CareRequest','CareRequestConfiguration','CareRequestDrug','CareRequestDrugFeed','CareRequestDrugHistory','CareRequestExchangeInfo','CareRequestExtension','CareRequestExtensionFeed','CareRequestExtensionHistory','CareRequestFeed','CareRequestHistory','CareRequestItem','CareRequestItemFeed','CareRequestItemHistory','CareRequestReviewer','CareRequestReviewerFeed','CareRequestReviewerHistory','CareRequestSupportingCntnt','CareService','CareServiceFeed','CareServiceHistory','CareServiceShare','CareServiceVisit','CareServiceVisitPlan','CareSpecialty','CareSpecialtyFeed','CareSpecialtyHistory','CareSpecialtyShare','CareSpecialtyTaxonomy','CareSpecialtyTaxonomyFeed','CareSpecialtyTaxonomyHistory','CareSystemFieldMapping','CareTask','CareTaskDetail','CareTaskDetailFeed','CareTaskDetailHistory','CareTaskFeed','CareTaskHistory','CareTaskShare','CareTaxonomy','CareTaxonomyFeed','CareTaxonomyHistory','CareTaxonomyShare','CartCheckoutSession','CartDeliveryGroup','CartDeliveryGroupMethod','CartDeliveryGroupMethodAdj','CartItem','CartItemAttribute','CartItemPriceAdjustment','CartRelatedItem','CartTax','CartValidationOutput','CaseArticle','CaseExternalDocument','CaseGatewayRequest','CaseOwnerSharingRule','CaseParticipant','CaseParticipantFeed','CaseParticipantHistory','CaseProgram','CaseProgramFeed','CaseProgramHistory','CaseRelatedIssue','CaseRelatedIssueFeed','CaseRelatedIssueHistory','CaseRelatedSubject','CaseRelatedSubjectFeed','CaseRelatedSubjectHistory','CaseRelatedSubjectShare','CaseSubjectParticle','CaseTag','CategorizedCareFeeAgreement','CategorizedCareFeeAgreementFeed','CategorizedCareFeeAgreementHistory','CategoryNodeLocalization','ChangeRequest','ChangeRequestFeed','ChangeRequestHistory','ChangeRequestRelatedIssue','ChangeRequestRelatedIssueFeed'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
