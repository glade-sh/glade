List<String> ns=new List<String>{'Account','GladeMissingProbe__c','ProductUsageResource','ProductUsageResourceFeed','ProductUsageResourceHistory','ProductUsageResourcePolicy','ProductUsageResourceShare','ProfileSkill','ProfileSkillEndorsement','ProfileSkillEndorsementFeed','ProfileSkillEndorsementHistory','ProfileSkillFeed','ProfileSkillHistory','ProfileSkillShare','ProfileSkillUser','ProfileSkillUserFeed','ProfileSkillUserHistory','Program','ProgramApplnFormTemplate','ProgramApplnFormTemplateFeed','ProgramApplnFormTemplateHistory','ProgramApplnFormTemplateShare','ProgramCohortFeed','ProgramCohortHistory','ProgramCohortMemberFeed','ProgramCohortMemberHistory','ProgramCohortMemberShare','ProgramEnrollment','ProgramEnrollmentFeed','ProgramEnrollmentHistory','ProgramEnrollmentShare','ProgramFeed','ProgramHistory','ProgramProduct','ProgramProductFeed','ProgramProductHistory','ProgramProductShare','ProgramRebateTypPayoutSrc','ProgramRebateTypPayoutSrcFeed','ProgramRebateTypPayoutSrcHistory','ProgramRebateType','ProgramRebateTypeBenefit','ProgramRebateTypeBenefitFeed','ProgramRebateTypeBenefitHistory','ProgramRebateTypeFeed','ProgramRebateTypeFilter','ProgramRebateTypeFilterFeed','ProgramRebateTypeFilterHistory','ProgramRebateTypeHistory','ProgramRebateTypePayout','ProgramRebateTypePayoutFeed','ProgramRebateTypePayoutHistory','ProgramRebateTypeProduct','ProgramRebateTypeProductFeed','ProgramRebateTypeProductHistory','ProgramRebateTypeReference','ProgramRebateTypeReferenceFeed','ProgramRebateTypeReferenceHistory','ProgramRebateTypeReferenceShare','ProgramRebateTypeShare','ProgramShare','Promotion','PromotionFeed','PromotionHistory','PromotionLineItemRule','PromotionLineItemRuleShare','PromotionLoyaltyPtnrProdt','PromotionLoyaltyPtnrProdtFeed','PromotionLoyaltyPtnrProdtHistory','PromotionMarketSegment','PromotionMarketSegmentFeed','PromotionMarketSegmentHistory','PromotionQualifier','PromotionQualifierFeed','PromotionQualifierHistory','PromotionRuleTemplate','PromotionSegment','PromotionSegmentBuyerGroup','PromotionSegmentBuyerGroupFeed','PromotionSegmentBuyerGroupHistory','PromotionSegmentFeed','PromotionSegmentHistory','PromotionSegmentSalesStore','PromotionSegmentSalesStoreFeed','PromotionSegmentSalesStoreHistory','PromotionSegmentShare','PromotionShare','PromotionTarget','PromotionTargetFeed','PromotionTargetHistory','PromotionTier','PromotionTierFeed','PromotionTierHistory','PromptActionOwnerSharingRule','PromptLocalization','PromptVersionLocalization','ProrationPolicy','Prospect','ProspectingAgentDataSource','ProspectingAgentRcmdTarget','ProspectingAgentSpec','ProspectingAgentSpecParm'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
