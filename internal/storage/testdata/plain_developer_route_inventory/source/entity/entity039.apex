List<String> ns=new List<String>{'Account','GladeMissingProbe__c','TaskRelation','TaskTag','TaskWhoRelation','TaxDisclosureSummary','TaxDisclosureSummaryFeed','TaxDisclosureSummaryHistory','TaxDisclosureSummaryShare','TaxEngine','TaxEngineHistory','TaxEngineInteractionLog','TaxEngineProvider','TaxGeoConfig','TaxGeoConfigShare','TaxPolicy','TaxPolicyHistory','TaxRate','TaxRateShare','TaxTreatment','TaxTreatmentHistory','TaxTreatmentItem','TaxTreatmentItemHistory','Team','TeamFeed','TeamHistory','TeamMember','TeamMemberFeed','TeamMemberHistory','TeamShare','TenantConsumptionAlert','TenantConsumptionAlertShare','Term','TermFeed','TermHistory','TermShare','Territory','Territory2','Territory2AlignmentLog','Territory2Model','Territory2ModelFeed','Territory2ModelHistory','Territory2ObjSharingConfig','Territory2ObjectExclusion','Territory2Type','TerritoryAdminAssignment','TerritoryMgmtObjectConfig','TimePeriod','TimePeriodFeed','TimePeriodHistory','TimePeriodShare','TimelineObjectDefinition','TimelineObjectDefinitionLocalization','TopInsight','TopicLocalization','TrackedCommunication','TrackedCommunicationDetail','TrackedCommunicationDetailFeed','TrackedCommunicationDetailHistory','TrackedCommunicationFeed','TrackedCommunicationHistory','TrackedCommunicationShare','TrainingCourseParticipant','TrainingCourseParticipantFeed','TrainingCourseParticipantHistory','TrainingCourseParticipantShare','TransactionJournal','TransactionSecurityEventLog','TransactionUsageEntitlement','TrnCourse','TrnCourseFeed','TrnCourseHistory','TrnCourseShare','UiAgentInteractionEventLog','UiTelemetryNavTmEventLog','UiTelemetryRsrcTmEventLog','UnifiedActivity','UnifiedActivityInsight','UnifiedActivityParticipant','UnifiedActivityRelation','UnifiedActvtyInsightKeyword','UnifiedEmail','UnifiedEmailParticipant','UnifiedMeeting','UnifiedMeetingParticipant','UnifiedTask','UnifiedTaskParticipant','UnifiedVideoCall','UnifiedVideoCallParticipant','UnifiedVoiceCall','UnifiedVoiceCallParticipant','UniqueQueryEventLog','UnitOfMeasureClass','UnitOfMeasureClassFeed','UnitOfMeasureClassHistory','UnitOfMeasureConversion','UnitOfMeasureConversionFeed','UnitOfMeasureConversionHistory','UnitOfMeasureConversionShare','UriEventLog','UsageCmtAssetRelatedObj','UsageCmtAssetRelatedObjFeed'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
