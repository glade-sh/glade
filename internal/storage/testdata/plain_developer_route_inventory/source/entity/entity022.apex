List<String> ns=new List<String>{'Account','GladeMissingProbe__c','InvoiceLineTaxHistory','InvoiceProcPymtExclEvent','InvoiceProcessedDetailEvent','InvoiceProcessedEvent','JobProfileQueueGroup','JournalReason','JournalSubType','JournalSubTypeHistory','JournalType','JournalTypeHistory','JournalTypeShare','KnowledgeArticle','KnowledgeArticleEventLog','KnowledgeArticleFeedback','KnowledgeArticleVersion','KnowledgeArticleVersionHistory','KnowledgeArticleViewStat','KnowledgeArticleVoteStat','Knowledge__DataCategorySelection','Knowledge__Feed','Knowledge__ViewStat','Knowledge__VoteStat','Knowledge__ka','Knowledge__kav','LandingPage','LeadDailyMetric','LeadMonthlyMetric','LeadOwnerSharingRule','LeadTag','LearningContent','LearningItem','LearningItemAssignment','LearningItemProgress','LearningItemShare','LearningItemSubmission','LearningItemType','LearningPractice','LegalEntyAccountingPeriod','LegalEntyAccountingPeriodFeed','LegalEntyAccountingPeriodHistory','LegalEntyAccountingPeriodShare','LightningErrorEventLog','LightningExitByPageMetrics','LightningLoggerEventLog','LightningPageViewEventLog','LightningPrfmEventLog','LightningToggleMetrics','LightningUsageByAppTypeMetrics','LightningUsageByBrowserMetrics','LightningUsageByFlexiPageMetrics','LightningUsageByPageMetrics','LinkedArticle','LinkedArticleFeed','LinkedArticleHistory','ListEmailMonthlyMetric','LiveChatBlockingRule','LiveChatButton','LiveChatButtonDeployment','LiveChatButtonSkill','LiveChatDeployment','LiveChatObjectAccessConfig','LiveChatObjectAccessDefinition','LiveChatTranscriptSkill','LiveChatUserConfig','LiveChatUserConfigProfile','LiveChatUserConfigUser','LoanApplicant','LoanApplicantAddress','LoanApplicantAddressFeed','LoanApplicantAddressHistory','LoanApplicantAsset','LoanApplicantAssetHistory','LoanApplicantDeclaration','LoanApplicantDeclarationFeed','LoanApplicantDeclarationHistory','LoanApplicantDeclarationShare','LoanApplicantEmployment','LoanApplicantEmploymentFeed','LoanApplicantEmploymentHistory','LoanApplicantEmploymentShare','LoanApplicantFeed','LoanApplicantHistory','LoanApplicantIncome','LoanApplicantIncomeFeed','LoanApplicantIncomeHistory','LoanApplicantIncomeShare','LoanApplicantLiability','LoanApplicantLiabilityHistory','LoanApplicantShare','LoanApplicationAsset','LoanApplicationAssetFeed','LoanApplicationAssetHistory','LoanApplicationAssetShare','LoanApplicationFinancial','LoanApplicationFinancialFeed','LoanApplicationFinancialHistory','LoanApplicationLiability','LoanApplicationLiabilityFeed','LoanApplicationLiabilityHistory','LoanApplicationLiabilityShare'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
