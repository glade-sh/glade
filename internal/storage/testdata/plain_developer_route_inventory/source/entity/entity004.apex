List<String> ns=new List<String>{'Account','GladeMissingProbe__c','AssetTag','AssociatedLocationHistory','AsyncOpSyndicationFeedFile','AsyncOperationTracker','AsyncOperationTrackerShare','AsyncReportRunEventLog','AttachedContentNote','AttachmentEventLog','AttrPicklistExcludedValue','AttrPicklistExcludedValueFeed','AttrPicklistExcludedValueHistory','AttrPicklistExcludedValueShare','AttribModel','AttribModelStage','AttribModelStageMetric','AttributeAdjustmentCondition','AttributeAdjustmentConditionFeed','AttributeAdjustmentConditionHistory','AttributeBasedAdjRule','AttributeBasedAdjRuleFeed','AttributeBasedAdjRuleHistory','AttributeBasedAdjRuleShare','AttributeBasedAdjustment','AttributeBasedAdjustmentFeed','AttributeBasedAdjustmentHistory','AttributeCategory','AttributeCategoryAttribute','AttributeCategoryAttributeFeed','AttributeCategoryAttributeHistory','AttributeCategoryAttributeShare','AttributeCategoryFeed','AttributeCategoryHistory','AttributeCategoryShare','Audience','AuditTrailFileExportShare','AuraRequestEventLog','AuthApplicationAsset','AuthApplicationAssetFeed','AuthApplicationAssetHistory','AuthApplicationAssetShare','AuthApplicationPlace','AuthApplicationPlaceFeed','AuthApplicationPlaceHistory','AuthApplicationPlaceShare','AuthFormRequestRecord','AuthFormRequestRecordFeed','AuthFormRequestRecordHistory','AuthLocationAccessSchedule','AuthLocationAccessScheduleFeed','AuthLocationAccessScheduleHistory','AuthLocationAccessScheduleShare','AuthorNote','AuthorNoteFeed','AuthorNoteHistory','AuthorNoteShare','AuthorizedInsuranceLine','AuthorizedInsuranceLineFeed','AuthorizedInsuranceLineHistory','AuthorizedInsuranceLineShare','AutomatedAction','AutomatedActionCondition','AutomatedActionOverride','AutomatedActionParameter','AutomatedActionReminder','Award','AwardFeed','AwardHistory','AwardShare','BackgroundOperationResult','BalanceAdjustmentRequest','BalanceAdjustmentRequestFeed','BalanceAdjustmentRequestHistory','BalanceAdjustmentRequestShare','Banker','BankerFeed','BankerHistory','BankerShare','BatchCalcJobDefinition','BatchCalcJobDefinitionView','BatchDataSource','BatchDataSrcFilterCriteria','BatchJob','BatchJobDefinition','BatchJobFeed','BatchJobHistory','BatchJobPart','BatchJobPartFailedRecord','BatchJobPartFailedRecordFeed','BatchJobPartFailedRecordHistory','BatchJobPartFeed','BatchJobPartHistory','BatchJobShare','BatchJobStatusChangedEvent','BatchProcessJobDefView','BatchProcessJobDefinition','Benefit','BenefitAction','BenefitActionParameter','BenefitActionParameterValue','BenefitAssignment'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
