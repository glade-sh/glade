List<String> ns=new List<String>{'Account','GladeMissingProbe__c','OrderSummary','OrderSummaryAdditionalInfo','OrderSummaryAdditionalInfoFeed','OrderSummaryAdditionalInfoShare','OrderSummaryCreatedEvent','OrderSummaryFeed','OrderSummaryRelationship','OrderSummaryRoutingSchedule','OrderSummaryRoutingScheduleShare','OrderSummaryShare','OrgIncidentSummary','OrgIncidentSummaryFeed','OrgIncidentSummaryHistory','OrgIncidentSummaryShare','OrgMetricScanResult','OrgSnapshot','OtherComponentTask','OtherComponentTaskFeed','OtherComponentTaskHistory','OtherComponentTaskShare','OtherEmssnFctrSet','OtherEmssnFctrSetFeed','OtherEmssnFctrSetHistory','OtherEmssnFctrSetItem','OtherEmssnFctrSetItemFeed','OtherEmssnFctrSetItemHistory','OtherEmssnFctrSetShare','OutOfOffice','Outcome','OutcomeActivity','OutcomeActivityFeed','OutcomeActivityHistory','OutcomeActivityShare','OutcomeFeed','OutcomeHistory','OutcomeShare','OutreachSourceCode','OutreachSourceCodeFeed','OutreachSourceCodeHistory','OutreachSourceCodeShare','OutreachSummaryFeed','OutreachSummaryHistory','OutreachSummaryShare','PackageInstallEventLog','PackagePushError','PackagePushJob','PackagePushRequest','PackageSubscriber','ParticipantRole','PartnerFundAllocation','PartnerFundAllocationFeed','PartnerFundAllocationHistory','PartnerFundAllocationShare','PartnerFundClaim','PartnerFundClaimFeed','PartnerFundClaimHistory','PartnerFundClaimShare','PartnerFundRequest','PartnerFundRequestFeed','PartnerFundRequestHistory','PartnerFundRequestShare','PartnerMarketingBudget','PartnerMarketingBudgetFeed','PartnerMarketingBudgetHistory','PartnerMarketingBudgetShare','PartnerNetworkConnection','PartnerNetworkRecordConnection','PartnerNetworkSyncLog','PartyAppointmentRequest','PartyCategoryFeed','PartyCategoryHistory','PartyCategoryShare','PartyCertifiedCapacity','PartyCertifiedCapacityFeed','PartyCertifiedCapacityHistory','PartyCertifiedCapacityShare','PartyCreditPrflFinclAcct','PartyCreditPrflFinclAcctFeed','PartyCreditPrflFinclAcctHistory','PartyCreditPrflFinclAcctShare','PartyCreditProfile','PartyCreditProfileAlert','PartyCreditProfileAlertFeed','PartyCreditProfileAlertHistory','PartyCreditProfileAlertShare','PartyCreditProfileFeed','PartyCreditProfileHistory','PartyCreditProfileInquiry','PartyCreditProfileInquiryFeed','PartyCreditProfileInquiryHistory','PartyCreditProfileInquiryShare','PartyCreditProfileShare','PartyExpense','PartyExpenseFeed','PartyExpenseHistory','PartyExpenseShare','PartyFinancialAsset','PartyFinancialAssetFeed','PartyFinancialAssetHistory','PartyFinancialAssetLien'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
