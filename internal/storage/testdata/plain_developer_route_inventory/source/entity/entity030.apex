List<String> ns=new List<String>{'Account','GladeMissingProbe__c','PreliminaryApplicationRefFeed','PreliminaryApplicationRefHistory','PreliminaryApplicationRefShare','PresenceConfigDeclineReason','PresenceDeclineReason','PresenceUserConfig','PresenceUserConfigProfile','PresenceUserConfigUser','PreventiveCareAgreement','PreventiveCareAgreementFeed','PreventiveCareAgreementHistory','PriceAdjustmentGroup','PriceAdjustmentGroupShape','PriceAdjustmentItem','PriceAdjustmentItemShape','PriceAdjustmentSchedule','PriceAdjustmentScheduleFeed','PriceAdjustmentScheduleHistory','PriceAdjustmentScheduleShare','PriceAdjustmentTier','PriceAdjustmentTierFeed','PriceAdjustmentTierHistory','PriceBookEntryDerivedPrice','PriceBookEntryDerivedPriceFeed','PriceBookEntryDerivedPriceHistory','PriceBookEntryDerivedPriceShare','PriceBookRateCard','PriceBookRateCardFeed','PriceBookRateCardHistory','PriceProtectExecLineItem','PriceProtectionExecution','PriceProtectionTerm','PricebookEntryAdjustment','PricingActionParameters','PricingAdjBatchJob','PricingAdjBatchJobFeed','PricingAdjBatchJobHistory','PricingAdjBatchJobLog','PricingAdjBatchJobLogFeed','PricingAdjBatchJobLogHistory','PricingAdjBatchJobShare','PricingApiExecutionFeed','PricingApiExecutionHistory','PricingApiExecutionShare','PricingProcedureOutputMap','PricingProcessExecution','PricingProcessExecutionFeed','PricingProcessExecutionHistory','PricingProcessExecutionShare','PricingRecipe','PricingRecipeTableMapping','PrivacyHold','PrivacyHoldReason','PrivacyRequest','Problem','ProblemDefRelationship','ProblemDefRelationshipFeed','ProblemDefRelationshipHistory','ProblemDefinition','ProblemDefinitionFeed','ProblemDefinitionHistory','ProblemDefinitionShare','ProblemFeed','ProblemGoalDefinition','ProblemHistory','ProblemIncident','ProblemIncidentFeed','ProblemIncidentHistory','ProblemRelatedItem','ProblemRelatedItemFeed','ProblemRelatedItemHistory','ProblemShare','ProcedureOutputResolution','ProdtAttrMappedScope','ProdtAttrMappedScopeFeed','ProdtAttrMappedScopeHistory','ProdtAttrMappedScopeShare','ProdtAttrScope','ProdtAttrScopeFeed','ProdtAttrScopeHistory','ProdtAttrScopeShare','Producer','ProducerCommission','ProducerCommissionFeed','ProducerCommissionHistory','ProducerCommissionShare','ProducerFeed','ProducerHistory','ProducerShare','Product2DataTranslation','ProductAttribute','ProductAttributeDefinition','ProductAttributeDefinitionFeed','ProductAttributeDefinitionHistory','ProductAttributeDefinitionShare','ProductAttributeSet','ProductAttributeSetItem','ProductAttributeSetProduct','ProductAvailabilityProjection','ProductAvailabilityProjectionFeed'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
