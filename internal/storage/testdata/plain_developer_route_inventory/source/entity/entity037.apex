List<String> ns=new List<String>{'Account','GladeMissingProbe__c','ServiceInformationRequest','ServiceInformationResponse','ServicePoint','ServicePointFeed','ServicePointHistory','ServicePointShare','ServicePresenceStatus','ServiceRequest','ServiceResourceDataTranslation','ServiceResourceOwnerSharingRule','ServiceTerritoryDataTranslation','ServiceTerritoryRelationship','ServiceTerritoryRelationshipFeed','ServiceTerritoryRelationshipHistory','ServiceTerritoryRelationshipShare','ServiceTerritoryWorkType','ServiceTerritoryWorkTypeFeed','ServiceTerritoryWorkTypeHistory','SetupDataSynchronizationShare','ShapeRepresentation','SharedSavingPaymentAgreement','SharedSavingPaymentAgreementFeed','SharedSavingPaymentAgreementHistory','SharingRecordCollection','SharingRecordCollectionItem','SharingRecordCollectionMember','SharingRecordCollectionShare','ShiftEngagementChannel','ShiftEngagementChannelFeed','ShiftEngagementChannelHistory','ShiftOwnerSharingRule','ShiftSegment','ShiftSegmentType','ShiftWorkTopic','ShiftWorkTopicFeed','ShiftWorkTopicHistory','ShippingCarrier','ShippingCarrierFeed','ShippingCarrierHistory','ShippingCarrierMethod','ShippingCarrierMethodFeed','ShippingCarrierMethodHistory','ShippingCarrierMethodShare','ShippingCarrierShare','ShippingConfigSetProduct','ShippingConfigurationSet','ShippingConfigurationSetShare','ShippingRateArea','ShippingRateGroup','SignatureTask','SignatureTaskFeed','SignatureTaskHistory','SignatureTaskLineItem','SignatureTaskLineItemFeed','SignatureTaskLineItemHistory','SignupRequest','SignupRequestFeed','SignupRequestHistory','SignupRequestShare','SiteDomain','SiteEventLog','SiteMarketingDataExtensionMapping','SkillLevelDefinition','SkillLevelProgress','SkillProfile','SkillUser','Snippet','SnippetAssignment','SoapApiEventLog','SocialContributionSum','SocialContributionSumFeed','SocialContributionSumHistory','SocialContributionSumShare','SocialPersona','SocialPersonaHistory','SocialPost','SocialPostFeed','SocialPostHistory','SocialPostShare','SolutionTag','Specimen','SpecimenFeed','SpecimenHistory','SpecimenShare','SrcPredJobStatusChgEvent','StageTransitionEntry','StageTransitionEntryFeed','StageTransitionEntryHistory','StageTransitionEntryShare','StagedEmail','StagedInviteeEmail','StagedInviteeEmailShare','StagedUnmtchdEmailAddr','StagedUnmtchdEmailAddrRela','StandardCareFeeAgreement','StandardCareFeeAgreementFeed','StandardCareFeeAgreementHistory','StandardInvocableActionType','StandardShippingRate','StgDefinitionAssignedRecordFeed'}; Set<String> found=new Set<String>(); for(EntityDefinition e:[SELECT QualifiedApiName FROM EntityDefinition WHERE QualifiedApiName IN :ns]) {found.add(e.QualifiedApiName);} List<String> r=new List<String>(); for(String n:ns){r.add(n+'='+found.contains(n));} System.assert(false,'OBS|'+String.join(r,';'));
