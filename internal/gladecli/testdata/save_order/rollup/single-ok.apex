Savepoint sp=Database.setSavepoint(); Probe_Parent__c parent=new Probe_Parent__c(Name='ok'); insert parent; Decimal oldCount=[SELECT Child_Count__c FROM Probe_Parent__c WHERE Id=:parent.Id].Child_Count__c; RollupTrace.events=''; Database.SaveResult result=Database.insert(new Probe_Child__c(Name='child',Parent__c=parent.Id),false); Probe_Parent__c saved=[SELECT Child_Count__c FROM Probe_Parent__c WHERE Id=:parent.Id]; String obs='test:'+Test.isRunningTest()+'|success:'+result.isSuccess()+'|error:'+(result.isSuccess() ? 'none' : String.valueOf(result.getErrors()[0].getStatusCode())+':'+result.getErrors()[0].getMessage())+'|trace:'+RollupTrace.events+'|counts:'+oldCount+','+saved.Child_Count__c+'|children:'+ [SELECT COUNT() FROM Probe_Child__c WHERE Parent__c=:parent.Id]; Database.rollback(sp); throw new RollupResultException(obs);
