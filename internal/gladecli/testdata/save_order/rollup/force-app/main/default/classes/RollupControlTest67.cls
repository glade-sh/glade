@IsTest private class RollupControlTest67 { @IsTest static void combined() {
Savepoint sp=Database.setSavepoint(); Probe_Parent__c bad=new Probe_Parent__c(Name='reject'); Probe_Parent__c ok=new Probe_Parent__c(Name='ok'); insert new List<Probe_Parent__c>{bad,ok}; RollupTrace.events=''; Database.SaveResult[] rs=Database.insert(new List<Probe_Child__c>{new Probe_Child__c(Name='bad1',Parent__c=bad.Id),new Probe_Child__c(Name='ok1',Parent__c=ok.Id),new Probe_Child__c(Name='bad2',Parent__c=bad.Id)},false); List<String> vals=new List<String>(); for(Database.SaveResult r:rs) vals.add(r.isSuccess() ? 'ok' : String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage()); Set<Id> ids=new Set<Id>{ok.Id,bad.Id}; List<Probe_Parent__c> parents=[SELECT Name,Child_Count__c FROM Probe_Parent__c WHERE Id IN :ids ORDER BY Name]; String observed='test:'+Test.isRunningTest()+'|results:'+String.join(vals,';')+'|trace:'+RollupTrace.events+'|counts:'+parents[0].Child_Count__c+','+parents[1].Child_Count__c+'|children:'+ [SELECT COUNT() FROM Probe_Child__c WHERE Parent__c IN :ids]; Database.rollback(sp);
System.assertEquals('EXPECTED',observed); } }
