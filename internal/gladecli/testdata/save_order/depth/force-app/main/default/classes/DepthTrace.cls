public class DepthTrace { public static Integer target; public static Integer entries=0; public static String trace=''; public static String probe(Integer n) { Savepoint sp=Database.setSavepoint(); target=n; entries=0; trace=''; Database.SaveResult r=Database.insert(new Account(Name='depth-probe'),false); Integer count=[SELECT COUNT() FROM Account WHERE Name='depth-probe']; String ans=n+':'+r.isSuccess()+':'+(r.isSuccess() ? 'none' : String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage())+':entries='+entries+':trace='+trace+':saved='+count; Database.rollback(sp); return ans; } }
