Savepoint sp=Database.setSavepoint(); Probe_Parent__c ok=new Probe_Parent__c(Name='ok'); Probe_Parent__c bad=new Probe_Parent__c(Name='reject'); insert new List<Probe_Parent__c>{ok,bad}; RollupTrace.events=''; RollupTrace.attempts.clear(); List<Probe_Child__c> children=new List<Probe_Child__c>{new Probe_Child__c(Name='okchild',Parent__c=ok.Id)}; if(false) children.add(new Probe_Child__c(Name='badchild',Parent__c=bad.Id)); List<String> vals=new List<String>(); try { Database.SaveResult[] rs=Database.insert(children,false); for(Database.SaveResult r:rs) vals.add(r.isSuccess() ? 'ok' : String.valueOf(r.getErrors()[0].getStatusCode())+':'+r.getErrors()[0].getMessage()); } catch (DmlException e) { for(Integer i=0;i<e.getNumDml();i++) vals.add(String.valueOf(e.getDmlIndex(i))+':'+String.valueOf(e.getDmlStatusCode(i))+':'+e.getDmlMessage(i)); } Set<Id> ids=new Set<Id>{ok.Id,bad.Id}; List<Probe_Parent__c> ps=[SELECT Name,Child_Count__c,Retry_Flag__c FROM Probe_Parent__c WHERE Id IN :ids ORDER BY Name]; String observed='test:'+Test.isRunningTest()+'|results:'+String.join(vals,';')+'|trace:'+RollupTrace.events+'|counts:'+ps[0].Child_Count__c+','+ps[1].Child_Count__c+'|flags:'+ps[0].Retry_Flag__c+','+ps[1].Retry_Flag__c+'|children:'+ [SELECT COUNT() FROM Probe_Child__c WHERE Parent__c IN :ids]+'|logs:'+ [SELECT COUNT() FROM Task WHERE Subject='probe-retry-log']; Database.rollback(sp);
throw new RollupResultException(observed);
