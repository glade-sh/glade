trigger RollupParent on Probe_Parent__c (before update, after update) { List<Task> logs=new List<Task>(); for (Probe_Parent__c p : Trigger.new) { if (Trigger.isBefore) { Integer n=RollupTrace.attempts.containsKey(p.Id) ? RollupTrace.attempts.get(p.Id)+1 : 1; RollupTrace.attempts.put(p.Id,n); if(p.Name == 'ok' && n == 2) p.Retry_Flag__c=true; } RollupTrace.events += (Trigger.isBefore ? 'before:' : 'after:')+p.Name+':'+p.Child_Count__c+':'+p.Retry_Flag__c+';'; if(Trigger.isAfter && p.Name=='ok') logs.add(new Task(Subject='probe-retry-log')); } if(!logs.isEmpty()) insert logs; }
