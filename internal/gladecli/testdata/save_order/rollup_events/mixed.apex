Savepoint sp=Database.setSavepoint(); Probe_Parent__c ok=new Probe_Parent__c(Name='ok'); Probe_Parent__c bad=new Probe_Parent__c(Name='reject'); insert new List<Probe_Parent__c>{ok,bad}; RollupTrace.events=''; List<Probe_Child__c> children=new List<Probe_Child__c>{new Probe_Child__c(Name='okchild',Parent__c=ok.Id)}; if(true) children.add(new Probe_Child__c(Name='badchild',Parent__c=bad.Id)); Database.SaveResult[] rs=Database.insert(children,false); List<String> vals=new List<String>(); for(Database.SaveResult r:rs) vals.add(r.isSuccess() ? 'ok' : String.valueOf(r.getErrors()[0].getStatusCode())); Set<Id> ids=new Set<Id>{ok.Id,bad.Id}; List<Probe_Parent__c> parents=[SELECT Name,Child_Count__c FROM Probe_Parent__c WHERE Id IN :ids ORDER BY Name]; Integer nlogs=[SELECT COUNT() FROM Task WHERE Subject='probe-side-effect']; Integer nchildren=[SELECT COUNT() FROM Probe_Child__c WHERE Parent__c IN :ids]; String observed='test:'+Test.isRunningTest()+'|results:'+String.join(vals,',')+'|trace:'+RollupTrace.events+'|counts:'+parents[0].Child_Count__c+','+parents[1].Child_Count__c+'|children:'+nchildren+'|logs:'+nlogs; Database.rollback(sp);
throw new RollupResultException(observed);
